{% extends 'back/base.html.twig' %}

{% block title %}Ajouter un Examen{% endblock %}

{% block breadcrumb %}Gestion des Examens / {{ course.name }} / Ajouter{% endblock %}

{% block content %}
    <div class="dashboard-content">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <div>
                <h1 class="page-title" style="margin-bottom: 5px;">Ajouter un Examen</h1>
                <p style="color: #64748b; margin: 0;">Cours : <strong>{{ course.name }}</strong></p>
            </div>
            <a href="{{ path('app_course_exams', {'id': course.id}) }}" class="btn-back">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
        </div>

        <div class="content-card">
            <div class="card-header">
                <h3>Nouveau Examen</h3>
            </div>
            <div style="padding: 24px;">
                {{ form_start(form) }}
                
                <div class="form-group" style="margin-bottom: 20px;">
                    {{ form_label(form.title, 'Titre', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.title, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Partiel, Examen Final...'}}) }}
                    {{ form_errors(form.title) }}
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                    <div class="form-group">
                        {{ form_label(form.date, 'Date et Heure', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.date, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.date) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.duration, 'Durée (minutes)', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.duration, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 90'}}) }}
                        {{ form_errors(form.duration) }}
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                    <div class="form-group">
                         {{ form_label(form.difficulty, 'Difficulté', {'label_attr': {'class': 'form-label'}}) }}
                         {{ form_widget(form.difficulty, {'attr': {'class': 'form-control'}}) }}
                         {{ form_errors(form.difficulty) }}
                    </div>
                    <div class="form-group">
                         {{ form_label(form.status, 'Statut', {'label_attr': {'class': 'form-label'}}) }}
                         {{ form_widget(form.status, {'attr': {'class': 'form-control'}}) }}
                         {{ form_errors(form.status) }}
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 20px;">
                    {{ form_label(form.grade, 'Note (/20)', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.grade, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 20'}}) }}
                    {{ form_errors(form.grade) }}
                </div>

                <div class="form-group" style="margin-bottom: 20px;">
                     {{ form_label(form.link, 'Lien Externe', {'label_attr': {'class': 'form-label'}}) }}
                     {{ form_widget(form.link, {'attr': {'class': 'form-control', 'placeholder': 'https://...'}}) }}
                     {{ form_errors(form.link) }}
                </div>

                <div class="form-group" style="margin-bottom: 30px;">
                    {{ form_label(form.file, 'Fichier (Optionnel)', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.file, {'attr': {'class': 'form-control', 'style': 'padding: 8px;'}}) }}
                    {{ form_errors(form.file) }}
                </div>

                <button type="submit" class="btn-action">
                    <i class="fas fa-plus"></i> Créer l'Examen
                </button>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
