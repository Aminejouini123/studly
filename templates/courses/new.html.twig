{% extends 'front/base.html.twig' %}

{% block title %}Add a Course{% endblock %}

{% block content %}
<div class="course-form-container">
    <!-- En-tête -->
    <div class="form-header">
        <div style="margin-bottom: 20px;">
             <a href="{{ path('app_courses') }}" class="btn-back-custom">
                <i class="fas fa-arrow-left"></i> Back to Courses
            </a>
        </div>
        <div class="header-content">
            <h1 class="page-title">Add a New Course</h1>
            <p class="page-subtitle">Fill in the course information to add it to your list</p>
        </div>
    </div>

    <!-- Formulaire -->
    <div class="form-card">
        {{ form_start(form, {'attr': {'class': 'course-form', 'novalidate': true}, 'multipart': true}) }}

        <div class="form-section">
            <h3 class="section-title"><i class="fas fa-info-circle"></i> General Information</h3>
            <div class="form-grid">
                <!-- Première ligne -->
                <div class="form-group">
                    {{ form_label(form.name, 'Course Name') }}
                    {{ form_widget(form.name, {'attr': {'class': 'form-input', 'placeholder': 'Ex: Introduction to Algorithms'}}) }}
                    {{ form_errors(form.name) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.teacherEmail, 'Teacher Email') }}
                    {{ form_widget(form.teacherEmail, {'attr': {'class': 'form-input', 'placeholder': 'professor@univ.edu'}}) }}
                    {{ form_errors(form.teacherEmail) }}
                </div>
            </div>
        </div>

        <div class="form-section">
            <h3 class="section-title"><i class="fas fa-sliders-h"></i> Course Settings</h3>
            <div class="form-grid">
                <!-- Deuxième ligne -->
                <div class="form-group">
                    {{ form_label(form.semester, 'Semester') }}
                    {{ form_widget(form.semester, {'attr': {'class': 'form-input'}}) }}
                    {{ form_errors(form.semester) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.difficultyLevel, 'Difficulty Level') }}
                    {{ form_widget(form.difficultyLevel, {'attr': {'class': 'form-input'}}) }}
                    {{ form_errors(form.difficultyLevel) }}
                </div>

                <!-- Troisième ligne -->
                <div class="form-group">
                    {{ form_label(form.type, 'Course Type') }}
                    {{ form_widget(form.type, {'attr': {'class': 'form-input'}}) }}
                    {{ form_errors(form.type) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.priority, 'Priority') }}
                    {{ form_widget(form.priority, {'attr': {'class': 'form-input'}}) }}
                    {{ form_errors(form.priority) }}
                </div>

                 <!-- Quatrième ligne -->
                <div class="form-group">
                    {{ form_label(form.status, 'Status') }}
                    {{ form_widget(form.status, {'attr': {'class': 'form-input'}}) }}
                    {{ form_errors(form.status) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.coefficient, 'Coefficient') }}
                    {{ form_widget(form.coefficient, {'attr': {'class': 'form-input', 'step': '0.5'}}) }}
                    {{ form_errors(form.coefficient) }}
                </div>
            </div>
        </div>

        <div class="form-section">
            <h3 class="section-title"><i class="fas fa-calendar-check"></i> Planning & Resources</h3>
            <div class="form-grid">
                <!-- Cinquième ligne -->
                <div class="form-group">
                    {{ form_label(form.duration, 'Duration (hours)') }}
                    {{ form_widget(form.duration, {'attr': {'class': 'form-input', 'min': '1'}}) }}
                    {{ form_errors(form.duration) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.courseFile, 'Course File') }}
                    {{ form_widget(form.courseFile, {'attr': {'class': 'form-input'}}) }}
                    {{ form_errors(form.courseFile) }}
                </div>

                <!-- Sixième ligne -->
                <div class="form-group full-width">
                    {{ form_label(form.courseLink, 'Course Link (Video)') }}
                    {{ form_widget(form.courseLink, {'attr': {'class': 'form-input', 'placeholder': 'https://meet.google.com/...'}}) }}
                    {{ form_errors(form.courseLink) }}
                </div>

                <!-- Commentaires -->
                <div class="form-group full-width">
                    {{ form_label(form.comment, 'Comments') }}
                    {{ form_widget(form.comment, {'attr': {'class': 'form-input form-textarea', 'rows': '4', 'placeholder': 'Additional notes or instructions...'}}) }}
                    {{ form_errors(form.comment) }}
                </div>
            </div>
        </div>

        <!-- Boutons d'action -->
        <div class="form-actions">
            <button type="submit" class="btn-submit">
                <i class="icon">💾</i> Add Course
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>

<style>
    /* Using variables from base.html.twig where possible */
    
    .course-form-container {
        padding: 0;
        background-color: #f8f9fa;
        min-height: 100vh;
        font-family: 'Poppins', sans-serif;
        padding-bottom: 4rem;
        padding-top: 2rem; /* Add top padding to container */
    }

    .form-header {
        display: flex;
        flex-direction: column;
        background: var(--sidebar-bg); /* Keep exact color */
        padding: 3rem 2rem 8rem 2rem; /* Increased top padding, keep bottom deep */
        color: white;
        margin: 0 auto; /* Center horizontal */
        position: relative;
        z-index: 1;
        /* Width constraints */
        width: 95%;
        max-width: 1250px;
        border-radius: 20px; /* Rounded all around */
        box-shadow: 0 10px 30px rgba(0, 51, 102, 0.15);
    }
    
    .form-header > div:first-child {
        margin-bottom: 1.5rem;
        width: 100%;
    }

    .header-content {
        text-align: center;
        max-width: 800px;
        margin: 0 auto; /* Center alignment */
    }

    .header-content h1 {
        font-size: 2.5rem;
        color: #ffffff;
        margin-bottom: 0.8rem;
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    .page-subtitle {
        color: rgba(255, 255, 255, 0.9);
        font-size: 1.1rem;
        font-weight: 300;
        line-height: 1.6;
        max-width: 600px;
        margin: 0 auto;
    }

    /* Carte du formulaire */
    .form-card {
        background: #FFFFFF;
        border-radius: 20px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
        padding: 4rem;
        width: 95%; 
        max-width: 1250px; /* Match header width */
        margin: -5rem auto 0 auto; /* Overlap with header */
        position: relative;
        z-index: 10;
        border: 1px solid rgba(0,0,0,0.02);
    }
    
    /* Accent line */
    .form-card::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 6px;
        background: linear-gradient(90deg, #00c6ff, #0072ff);
        border-radius: 20px 20px 0 0;
    }

    .course-form {
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    /* Section styling */
    .form-section {
        border-bottom: 1px solid #e9ecef;
        padding-bottom: 2.5rem;
        margin-bottom: 1rem;
    }
    
    .form-section:last-child {
        border-bottom: none;
        padding-bottom: 0;
        margin-bottom: 0;
    }

    .section-title {
        font-size: 1.25rem;
        color: var(--primary-dark, #003366);
        font-weight: 700;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 0.8rem;
        padding-left: 0.5rem;
        border-left: 4px solid #00c6ff;
        line-height: 1;
    }
    
    .section-title i {
        color: var(--primary-light, #00c6ff);
        font-size: 1.1em;
    }

    /* Grille du formulaire */
    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        column-gap: 3rem;
        row-gap: 2rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
    }

    .form-group.full-width {
        grid-column: 1 / -1;
    }

    .form-group label {
        font-weight: 600;
        color: #344767;
        font-size: 0.95rem;
        margin-left: 0.2rem;
    }

    /* Inputs et Selects */
    .form-input {
        padding: 1rem 1.2rem;
        border: 1px solid #d2d6da;
        border-radius: 12px;
        font-size: 1rem;
        font-family: 'Poppins', sans-serif;
        transition: all 0.2s ease;
        background: #fff;
        color: #495057;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }
    
    .form-input::placeholder {
        color: #adb5bd;
    }

    .form-input:focus {
        outline: none;
        border-color: #35d1f5;
        box-shadow: 0 0 0 4px rgba(53, 209, 245, 0.15);
    }

    .form-input:hover {
        border-color: #b1b7c1;
    }

    .form-textarea {
        resize: vertical;
        min-height: 140px;
        line-height: 1.6;
    }

    /* Erreurs de validation */
    .form-group .form-error,
    .form-group ul {
        color: #ea0606;
        font-size: 0.85rem;
        margin-top: 0.4rem;
        font-weight: 500;
        padding-left: 0;
        list-style: none;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }
    
    .form-group .form-error::before {
        content: '⚠';
    }

    /* Boutons d'action */
    .form-actions {
        display: flex;
        gap: 1.5rem;
        justify-content: flex-end;
        padding-top: 2rem;
        border-top: 1px solid #f0f0f0;
    }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;
        padding: 1rem 3rem;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        font-weight: 600;
        font-size: 1.05rem;
        transition: all 0.2s ease;
        letter-spacing: 0.3px;
        background: linear-gradient(135deg, #003366 0%, #004080 100%);
        color: white;
        box-shadow: 0 4px 6px rgba(0, 51, 102, 0.2);
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 15px rgba(0, 51, 102, 0.25);
    }

    .btn-submit:active {
        transform: translateY(0);
    }

    /* Back Custom Button - White Pill */
    .btn-back-custom {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.7rem 1.5rem;
        border-radius: 50px;
        background: rgba(255, 255, 255, 0.2);
        color: white;
        font-weight: 600;
        text-decoration: none;
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        transition: all 0.2s ease;
        font-size: 0.95rem;
        width: fit-content;
    }

    .btn-back-custom:hover {
        background: white;
        color: #003366;
        transform: translateX(-2px);
    }
    
    .btn-back-custom i {
        font-size: 0.95rem;
    }

    /* Responsive */
    @media (max-width: 1200px) {
        .form-card {
            max-width: 95%;
            padding: 3rem;
        }
    }

    @media (max-width: 768px) {
        .form-header {
            padding: 1.5rem 1.5rem 6rem 1.5rem;
            width: 95%; /* Keep width consistent on mobile */
            border-radius: 16px;
        }

        .header-content h1 {
            font-size: 2rem;
        }
        
        .form-card {
            padding: 2rem;
            margin-top: -4rem;
            width: 95%; /* Keep consistent width */
            border-radius: 16px;
        }

        .form-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }
        
        .form-section {
            padding-bottom: 2rem;
        }

        .btn-submit {
            width: 100%;
            justify-content: center;
        }
    }
</style>

{% endblock %}
