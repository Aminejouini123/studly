<script>
    document.addEventListener('DOMContentLoaded', function() {
        // --- Preview Toggle Functionality ---
        const toggleBtn = document.querySelector('.toggle-preview');
        const previewContent = document.querySelector('.file-content-preview');
        
        if (toggleBtn && previewContent) {
            toggleBtn.addEventListener('click', function(e) {
                e.preventDefault();
                const icon = this.querySelector('i');
                
                // Toggle visibility using CSS class
                const isHidden = previewContent.classList.toggle('hidden');
                
                // Update icon and rotation: 
                // Default (hidden) = fa-chevron-down (expand)
                // Expanded = 180deg rotation (pointing up to collapse)
                if (isHidden) {
                    icon.style.transform = 'rotate(0deg)';
                } else {
                    icon.style.transform = 'rotate(180deg)';
                }
            });
        }

        // --- Dropdown Menu Functionality (3 dots) ---
        const dropdownToggle = document.querySelector('.dropdown-toggle');
        const dropdownMenu = document.querySelector('.dropdown-menu-custom');

        if (dropdownToggle && dropdownMenu) {
            dropdownToggle.addEventListener('click', function(e) {
                e.stopPropagation();
                dropdownMenu.classList.toggle('show');
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', function(e) {
                if (!dropdownMenu.contains(e.target) && !dropdownToggle.contains(e.target)) {
                    dropdownMenu.classList.remove('show');
                }
            });
        }

        // --- Professional Zoom & Fullscreen ---
        const previewContainer = document.querySelector('.file-preview-container');
        const fullscreenBtns = document.querySelectorAll('.fullscreen-trigger');
        const zoomInBtn = document.querySelector('.zoom-in');
        const zoomOutBtn = document.querySelector('.zoom-out');
        const zoomLevelDisplay = document.querySelector('.zoom-level');
        const pdfZoomContainer = document.querySelector('.pdf-zoom-container');
        const previewArea = document.querySelector('.file-content-preview');

        // Fullscreen Logic
        if (fullscreenBtns.length > 0 && previewContainer) {
            fullscreenBtns.forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    // If preview is hidden, expand it first
                    if (previewArea && previewArea.classList.contains('hidden')) {
                         document.querySelector('.toggle-preview').click();
                    }

                    if (!document.fullscreenElement) {
                        if (previewContainer.requestFullscreen) {
                            previewContainer.requestFullscreen();
                        } else if (previewContainer.webkitRequestFullscreen) {
                            previewContainer.webkitRequestFullscreen();
                        }
                    } else {
                        if (document.exitFullscreen) {
                            document.exitFullscreen();
                        }
                    }
                });
            });
        }

        // Zoom Logic (Transform-based)
        if (pdfZoomContainer && zoomLevelDisplay) {
            let scale = 1;
            const resetBtn = document.querySelector('.zoom-reset-btn');
            
            function updateZoom() {
                pdfZoomContainer.style.transform = `scale(${scale})`;
                // Update both width and height to force the parent to scroll correctly
                pdfZoomContainer.style.width = scale > 1 ? `${100 * scale}%` : '100%';
                pdfZoomContainer.style.height = scale > 1 ? `${800 * scale}px` : '800px';
                zoomLevelDisplay.textContent = `${Math.round(scale * 100)}%`;
            }

            // Sync initial state
            updateZoom();

            zoomInBtn?.addEventListener('click', (e) => {
                e.preventDefault();
                if (scale < 4) {
                    scale = parseFloat((scale + 0.25).toFixed(2));
                    updateZoom();
                }
            });

            zoomOutBtn?.addEventListener('click', (e) => {
                e.preventDefault();
                if (scale > 0.5) {
                    scale = parseFloat((scale - 0.25).toFixed(2));
                    updateZoom();
                }
            });

            resetBtn?.addEventListener('click', (e) => {
                e.preventDefault();
                scale = 1;
                updateZoom();
            });
        }

        // Existing Page Navigation (keep hash manipulation as it's the only way to turn pages)
        const pdfIframe = document.querySelector('.pdf-viewer-overlay iframe');
        const prevPageBtn = document.querySelector('.pdf-nav-group .pdf-dark-btn:first-child');
        const nextPageBtn = document.querySelector('.pdf-nav-group .pdf-dark-btn:last-child');
        const pageNumField = document.querySelector('.current-page');

        if (pdfIframe) {
            let currentPage = 1;
            const baseUrl = pdfIframe.src.split('#')[0];

            function turnPage() {
                pdfIframe.src = `${baseUrl}#page=${currentPage}`;
                if (pageNumField) pageNumField.textContent = currentPage;
            }

            prevPageBtn?.addEventListener('click', (e) => {
                e.preventDefault();
                if (currentPage > 1) {
                    currentPage--;
                    turnPage();
                }
            });

            nextPageBtn?.addEventListener('click', (e) => {
                e.preventDefault();
                currentPage++;
                turnPage();
            });
        }
    });
</script>

