    }

    .search-box:focus, .filter-select:focus {
        outline: none;
        border-color: #0059A9;
        box-shadow: 0 0 0 3px rgba(0, 89, 169, 0.06);
    }

    /* Tableau */
    /* Grid Layout */
    .courses-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 2rem;
        padding-top: 1rem;
    }

    /* Course Card V2 */
    .course-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 1.5rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.04);
        transition: all 0.3s ease;
        border: 1px solid transparent;
        display: flex;
        flex-direction: column;
    }

    .course-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 30px rgba(0,0,0,0.08); /* hover shadow */
    }

    /* Header Row */
    .card-header-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 0.5rem;
    }

    .course-title {
        font-size: 1.3rem;
        font-weight: 800;
        color: #0b1e3b; /* Dark Navy */
        margin: 0;
        flex: 1;
        padding-right: 1rem;
    }

    .status-badge {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.3rem 0.6rem;
        border-radius: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-en-attente { background: #fff0f0; color: #c62828; }
    .status-en-cours { background: #fff8e1; color: #f57f17; }
    .status-terminé { background: #e8f5e9; color: #2e7d32; }

    /* Teacher Info */
    .teacher-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #6c757d;
        font-size: 0.9rem;
        margin-bottom: 1.5rem;
    }
    
    .teacher-info i { color: #8898aa; }

    /* Info Grid Row */
    .info-grid-row {
        display: flex;
        justify-content: space-between;
        background: #f8f9fc; /* Very light blue/gray bg */
        padding: 1rem;
        border-radius: 12px;
        margin-bottom: 1.5rem;
    }

    .info-metric {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.3rem;
        flex: 1;
        text-align: center;
    }

    .metric-icon {
        color: #0056b3; /* Primary Blue */
        font-size: 1.1rem;
        margin-bottom: 2px;
    }

    .metric-value {
        font-size: 0.85rem;
        font-weight: 600;
        color: #525f7f;
    }

    /* Tags Row */
    .tags-row {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }

    .tag {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        text-align: center;
        text-transform: uppercase;
    }

    .tag-difficulty.difficulty-facile { background: #e3f2fd; color: #0d47a1; }
    .tag-difficulty.difficulty-moyen { background: #e3f2fd; color: #1565c0; }
    .tag-difficulty.difficulty-difficile { background: #ffebee; color: #c62828; }

    .tag-type { background: #e3f2fd; color: #0d47a1; } 

    .tag-priority { background: #f8f9fa; color: #525f7f; border: 1px solid #e9ecef; } /* BASSE style */

    /* Main Action Button (Details) */
    .btn-details-main {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        background: #0056b3; /* Primary Blue */
        color: white;
        padding: 0.8rem;
        border-radius: 12px; /* Slightly more rounded */
        text-decoration: none;
        font-weight: 700;
        margin-bottom: 1rem; /* Consistent spacing */
        transition: all 0.2s ease;
        box-shadow: 0 4px 6px rgba(0, 86, 179, 0.2);
    }

    .btn-details-main:hover {
        background: #003d80;
        transform: translateY(-2px);
        box-shadow: 0 6px 12px rgba(0, 86, 179, 0.3);
    }

    /* Action Buttons Row (Examen / Activité) */
    .card-action-buttons {
        display: flex;
        flex-direction: column; /* Stack vertically */
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .btn-action-main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.7rem; /* Consistent padding */
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    /* Specific Button Styles - Professional Soft Style */
    .btn-examen {
        background-color: #e6f0fa; /* Very Light Sidebar Blue */
        color: #004080; /* Darker Sidebar Blue for contrast */
        border: 1px solid rgba(0, 89, 169, 0.15); /* Subtle border */
    }

    .btn-examen:hover {
        background-color: #dbeafe; /* Slightly darker on hover */
        color: #002d5a;
        transform: translateY(-1px);
        box-shadow: 0 2px 4px rgba(0, 89, 169, 0.08);
    }

    .btn-activity {
        background-color: #e0faff; /* Very Light Sidebar Cyan */
        color: #007ea7; /* Darker Cyan for contrast */
        border: 1px solid rgba(0, 180, 216, 0.15); /* Subtle border */
    }

    .btn-activity:hover {
        background-color: #d1f5fd; /* Slightly darker on hover */
        color: #006b8f;
        transform: translateY(-1px);
        box-shadow: 0 2px 4px rgba(0, 180, 216, 0.08);
    }

    /* Footer Actions Row (Edit / Delete) */
    .card-footer-actions {
        display: flex;
        gap: 0.75rem;
    }

    .btn-action {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        padding: 0.7rem;
        border-radius: 10px;
        font-size: 0.9rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-edit-sub {
        background: #f3e8ff; /* Soft Purple */
        color: #7e22ce;
        border: 1px solid #e9d5ff; /* Added border for consistency */
    }

    .btn-edit-sub:hover {
        background: #e9d5ff;
        color: #6b21a8;
        transform: translateY(-1px);
    }

    .btn-delete-sub {
        background: #fef2f2; /* Soft Red */
        color: #dc2626;
        border: 1px solid #fecaca; /* Added border */
        width: 100%; /* Ensure full width in flex container if needed */
    }

    .btn-delete-sub:hover {
        background: #fee2e2;
        color: #b91c1c;
        transform: translateY(-1px);
    }

    @media (max-width: 768px) {
        .courses-header {
