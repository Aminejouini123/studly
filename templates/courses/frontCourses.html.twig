    }

    .stat-label {
        color: rgba(255,255,255,0.75);
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* Section Courses */
    .courses-section {
        background: var(--card-light);
        border-radius: 12px;
        box-shadow: 0 4px 14px rgba(10, 45, 80, 0.04);
        overflow: hidden;
    }

    .section-header {
        padding: 1.5rem;
        border-bottom: 2px solid #f0f0f0;
        display: flex;
