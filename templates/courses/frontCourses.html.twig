    }

    .section-header h2 {
        color: #1F1F1F;
        font-size: 1.5rem;
        margin: 0;
    }

    .search-filter {
        display: flex;
        gap: 1rem;
        flex: 1;
        min-width: 300px;
    }

    .search-box, .filter-select {
        flex: 1;
        padding: 0.75rem 1rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 0.95rem;
