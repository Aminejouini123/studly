{% extends 'front/base.html.twig' %}

{% block title %}My Courses{% endblock %}

{% block content %}
<div class="courses-container">
    <!-- En-tête -->
    <div class="courses-header">
        <div class="header-content">
            <h1 class="page-title"> My Courses</h1>
            <p class="page-subtitle">Manage and track all your courses in one place</p>
        </div>
        <a href="{{ path('app_course_new') }}" class="btn-primary btn-lg">
            <i class="icon">➕</i> Add a Course
        </a>
    </div>

    <!-- Statistiques rapides -->
    <div class="stats-banner">
        <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-number">{{ courses|length }}</div>
            <div class="stat-label">Total Courses</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">{{ courses|filter(c => c.status|lower == 'en cours')|length }}</div>
            <div class="stat-label">In Progress</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">{{ courses|filter(c => c.status|lower == 'terminé')|length }}</div>
            <div class="stat-label">Completed</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">{{ courses|filter(c => c.status|lower == 'en attente')|length }}</div>
            <div class="stat-label">Pending</div>
        </div>
        </div>
    </div>

    <!-- Tableau des cours -->
    <div class="courses-section">
        <div class="section-header">
            <h2> Course List</h2>
            <div class="search-filter">
                <input type="text" id="searchInput" class="search-box" placeholder=" Search for a course...">
                <select id="statusFilter" class="filter-select">
                    <option value="">All statuses</option>
                    <option value="en cours">In Progress</option>
                    <option value="terminé">Completed</option>
                    <option value="en attente">Pending</option>
                </select>
            </div>
        </div>

        {% if courses|length > 0 %}
            <div class="courses-grid">
                {% for course in courses %}
                    <div class="course-card" data-status="{{ course.status }}">
                        
                        <div class="card-header-row">
                            <h3 class="course-title">{{ course.name }}</h3>
                            <span class="status-badge status-{{ course.status|lower|replace({' ': '-'}) }}">
                                {{ course.status|upper }}
                            </span>
                        </div>

                        <div class="teacher-info">
                            <i class="fas fa-chalkboard-teacher"></i>
                            <span>{{ course.teacherEmail }}</span>
                        </div>

                        <div class="info-grid-row">
                            <div class="info-metric">
                                <div class="metric-icon"><i class="fas fa-clock"></i></div>
                                <span class="metric-value">{{ course.duration }}h</span>
                            </div>
                            <div class="info-metric">
                                <div class="metric-icon"><i class="fas fa-calendar-alt"></i></div>
                                <span class="metric-value">{{ course.semester }}</span>
                            </div>
                            <div class="info-metric">
                                <div class="metric-icon"><i class="fas fa-weight-hanging"></i></div>
                                <span class="metric-value">Coef: {{ course.coefficient }}</span>
                            </div>
                        </div>

                        <div class="tags-row">
                            <span class="tag tag-difficulty {{ 'difficulty-' ~ course.difficultyLevel|lower }}">{{ course.difficultyLevel|upper }}</span>
                            <span class="tag tag-type">{{ course.type|upper }}</span>
                            <span class="tag tag-priority {{ 'priority-' ~ course.priority|lower }}">{{ course.priority|upper }}</span>
                        </div>

                        <a href="{{ path('app_course_show', {id: course.id}) }}" class="btn-details-main">
                            View Details <i class="fas fa-arrow-right"></i>
                        </a>

                        <div class="card-action-buttons">
                            <a href="{{ path('app_course_exams', {id: course.id}) }}" class="btn-action-main btn-examen">
                                <i class="fas fa-file-alt"></i> Exam
                            </a>
                            <a href="{{ path('app_course_activities', {id: course.id}) }}" class="btn-action-main btn-activity">
                                <i class="fas fa-tasks"></i> Activity
                            </a>
                        </div>

                        <div class="card-footer-actions">
                            <a href="{{ path('app_course_edit', {id: course.id}) }}" class="btn-action btn-edit-sub">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <button type="button" class="btn-action btn-delete-sub" onclick="openDeleteModal({{ course.id }})">
                                <i class="fas fa-trash-alt"></i> Delete
                            </button>
                            <form id="delete-form-{{ course.id }}" method="POST" action="{{ path('app_course_delete', {id: course.id}) }}" style="display:none;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete') }}">
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state">
                <div class="empty-icon-container">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-book-open"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
                </div>
                <h3>No courses found</h3>
                <p>You haven't added any courses yet. Start your learning journey now!</p>
                <a href="{{ path('app_course_new') }}" class="btn-primary btn-lg pulse-animation">
                    <i class="fas fa-plus-circle"></i> Add my first course
                </a>
            </div>
        {% endif %}
    </div>
</div>

<style>
    /* ... existing styles ... */

    /* Empty State Styles */
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 2rem;
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        text-align: center;
        margin-top: 1rem;
        border: 2px dashed #e2e8f0;
    }

    .empty-icon-container {
        width: 100px;
        height: 100px;
        background: #f0f9ff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.5rem;
        color: #0059A9;
    }

    .empty-state h3 {
        font-size: 1.5rem;
        color: #1e293b;
        margin-bottom: 0.75rem;
        font-weight: 700;
    }

    .empty-state p {
        color: #64748b;
        font-size: 1rem;
        max-width: 400px;
        margin-bottom: 2rem;
        line-height: 1.6;
    }

    .pulse-animation {
        animation: pulse 2s infinite;
    }

    @keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(0, 89, 169, 0.4);
        }
        70% {
            box-shadow: 0 0 0 10px rgba(0, 89, 169, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(0, 89, 169, 0);
        }
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    :root {
        --sidebar-blue: #0059A9;
        --sidebar-dark: #01304f; /* slightly lighter than before */
        --sidebar-accent: #00B4D8;
        --card-dark: #eaf6ff; /* soft, professional card background */
        --card-light: #ffffff; /* page card */
        --muted: #6c757d;
        --text-on-dark: rgba(255,255,255,0.92);
    }

    .courses-container {
        padding: 2rem;
        background: linear-gradient(135deg, #f5f9fd 0%, #eef4f9 100%);
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .courses-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--card-light);
        color: #1F1F1F;
        padding: 1.5rem 2rem;
        border-radius: 12px;
        margin-bottom: 1.25rem;
        box-shadow: 0 6px 24px rgba(10, 45, 80, 0.06);
    }

    .header-content h1 {
        font-size: 2rem;
        color: #0b2e4a;
        margin-bottom: 0.25rem;
    }

    .page-subtitle {
        color: var(--muted);
        font-size: 0.95rem;
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #0059A9; /* sidebar blue */
