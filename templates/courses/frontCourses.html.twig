    }

    .btn-lg {
        font-size: 1rem;
        padding: 0.9rem 2rem;
    }

    /* Statistiques - dark banner */
    .stats-banner {
        background: linear-gradient(90deg, rgba(6,40,80,1) 0%, var(--sidebar-blue) 100%);
        padding: 1.5rem;
        border-radius: 12px;
