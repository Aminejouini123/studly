{% extends 'back/base.html.twig' %}

{% block title %}Courses Management{% endblock %}

{% block breadcrumb %}Courses Management{% endblock %}

{% block content %}
    <div class="dashboard-content">
        <h1 class="page-title">Courses Management</h1>
        
        {# Flash Messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}" style="padding: 15px; margin-bottom: 20px; border: 1px solid transparent; border-radius: 4px; {% if label == 'success' %}color: #155724; background-color: #d4edda; border-color: #c3e6cb;{% else %}color: #721c24; background-color: #f8d7da; border-color: #f5c6cb;{% endif %}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="content-card">
            <div class="card-header">
                <h3>All Courses</h3>
                <!-- Add Course button removed as requested -->
            </div>
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Status</th>
                            <th>Details</th>
                            <th>Content</th>
                            <th>Created At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for course in courses %}
                        <tr>
                            <td>{{ course.id }}</td>
                            <td>
                                <strong>{{ course.name }}</strong>
                                <br>
                                <small class="text-muted">{{ course.type }}</small>
                            </td>
                            <td>
                                {% if course.user %}
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <div style="width: 24px; height: 24px; background: #e2e8f0; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 10px; color: #64748b;">
                                            {{ course.user.email|first|upper }}
                                        </div>
                                        <span>{{ course.user.email }}</span>
                                    </div>
                                {% else %}
                                    <span class="status-badge status-pending">Unknown</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="status-badge {{ course.status == 'published' or course.status == 'active' ? 'status-active' : 'status-pending' }}">
                                    {{ course.status }}
                                </span>
                            </td>
                            <td>
                                <span style="font-size: 0.85rem; color: #64748b;">
                                    <i class="fas fa-layer-group"></i> {{ course.difficultyLevel }}
                                    <br>
                                    <i class="fas fa-calendar-alt"></i> {{ course.semester }}
                                </span>
                            </td>
                            <td>
                                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                                    <a href="{{ path('app_course_activities', {'id': course.id}) }}" class="badge-content badge-activity" title="Manage activities">
                                        Activities: {{ course.activities|length }}
                                    </a>
                                    <a href="{{ path('app_course_exams', {'id': course.id}) }}" class="badge-content badge-exam" title="Manage exams">
                                        Exams: {{ course.exams|length }}
                                    </a>
                                </div>
                            </td>
                            <td>{{ course.createdAt ? course.createdAt|date('Y-m-d') : '' }}</td>
                            <td>
                                <div style="display: flex; gap: 8px;">
                                    <a href="{{ path('app_admin_course_show', {'id': course.id}) }}" class="btn-secondary" title="View"><i class="fas fa-eye"></i></a>
                                    <a href="{{ path('app_admin_course_edit', {'id': course.id}) }}" class="btn-secondary" title="Edit"><i class="fas fa-edit"></i></a>
                                    <button type="button" class="btn-secondary" style="color: #ef4444; border-color: #fee2e2;" title="Delete" 
                                            onclick="confirmDelete('{{ path('app_course_delete', {'id': course.id}) }}', '{{ csrf_token('delete' ~ course.id) }}')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="7" style="text-align: center;">No courses found.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# Delete Confirmation Modal #}
    <div id="deleteModal" class="modal-overlay">
        <div class="modal-card">
            <div class="modal-header">
                <h2>Confirm Deletion</h2>
                <button type="button" class="modal-close" onclick="closeDeleteModal()">&times;</button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this course? This action is irreversible.</p>
                <form id="deleteForm" method="post" action="">
                    <input type="hidden" name="_token" id="deleteToken" value="">
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" onclick="closeDeleteModal()">Cancel</button>
                <button type="button" class="btn-action" style="background-color: #ef4444;" onclick="document.getElementById('deleteForm').submit()">Delete</button>
            </div>
        </div>
    </div>

    <script>
        function confirmDelete(actionUrl, token) {
            document.getElementById('deleteForm').action = actionUrl;
            document.getElementById('deleteToken').value = token;
            document.getElementById('deleteModal').classList.add('active');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.remove('active');
        }

        // Close modal when clicking outside
        document.getElementById('deleteModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeDeleteModal();
            }
        });
    </script>

    <style>
        .badge-content {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
        }

        .badge-activity {
            background-color: #e0f2fe;
            color: #0284c7;
            border: 1px solid #bae6fd;
        }

        .badge-activity:hover {
            background-color: #bae6fd;
            color: #0369a1;
        }

        .badge-exam {
            background-color: #fce7f3;
            color: #db2777;
            border: 1px solid #fbcfe8;
        }

        .badge-exam:hover {
            background-color: #fbcfe8;
            color: #be185d;
        }
    </style>
{% endblock %}
