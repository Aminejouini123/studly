{% extends 'back/base.html.twig' %}

{% block title %}Courses Management{% endblock %}

{% block breadcrumb %}Courses Management{% endblock %}

{% block content %}
    <div class="dashboard-content">
        <h1 class="page-title">Courses Management</h1>
        
        {# Flash Messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}" style="padding: 15px; margin-bottom: 20px; border: 1px solid transparent; border-radius: 4px; {% if label == 'success' %}color: #155724; background-color: #d4edda; border-color: #c3e6cb;{% else %}color: #721c24; background-color: #f8d7da; border-color: #f5c6cb;{% endif %}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="content-card">
            <div class="card-header">
                <h3>All Courses</h3>
                <!-- Add Course button removed as requested -->
            </div>
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Status</th>
                            <th>Details</th>
                            <th>Content</th>
                            <th>Created At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for course in courses %}
                        <tr>
                            <td>{{ course.id }}</td>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 4px;">
                                    <span style="font-weight: 700; color: var(--text-main); font-size: 1rem;">{{ course.name }}</span>
                                    <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">{{ course.type }}</span>
                                </div>
                            </td>
                            <td>
                                {% if course.user %}
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <div style="width: 32px; height: 32px; background: linear-gradient(135deg, var(--primary), #a855f7); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; color: #fff; font-weight: 700; box-shadow: var(--shadow-sm);">
                                            {{ course.user.email|first|upper }}
                                        </div>
                                        <div style="display: flex; flex-direction: column;">
                                            <span style="font-size: 0.85rem; font-weight: 600; color: var(--text-main);">{{ course.user.email|split('@')[0]|capitalize }}</span>
                                            <span style="font-size: 0.75rem; color: var(--text-muted);">{{ course.user.email }}</span>
                                        </div>
                                    </div>
                                {% else %}
                                    <span class="status-badge" style="background: #f1f5f9; color: #64748b;">Unknown Author</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="status-badge {{ course.status|lower in ['published', 'active', 'completed', 'in progress'] ? 'status-active' : 'status-pending' }}">
                                    <i class="fas {{ course.status|lower in ['published', 'active'] ? 'fa-check-circle' : 'fa-clock' }}" style="font-size: 0.7rem; margin-right: 4px;"></i>
                                    {{ course.status }}
                                </span>
                            </td>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 4px; font-size: 0.85rem; color: var(--text-muted); font-weight: 500;">
                                    <div style="display: flex; align-items: center; gap: 6px;">
                                        <i class="fas fa-layer-group" style="width: 14px; color: var(--primary); opacity: 0.7;"></i>
                                        <span>{{ course.difficultyLevel }}</span>
                                    </div>
                                    <div style="display: flex; align-items: center; gap: 6px;">
                                        <i class="fas fa-calendar-alt" style="width: 14px; color: var(--primary); opacity: 0.7;"></i>
                                        <span>{{ course.semester }}</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                                    <a href="{{ path('app_course_activities', {'id': course.id}) }}" class="badge-content badge-activity" title="Manage activities">
                                        Activities: {{ course.activities|length }}
                                    </a>
                                    <a href="{{ path('app_course_exams', {'id': course.id}) }}" class="badge-content badge-exam" title="Manage exams">
                                        Exams: {{ course.exams|length }}
                                    </a>
                                </div>
                            </td>
                            <td style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <i class="fas fa-history" style="opacity: 0.5;"></i>
                                    {{ course.createdAt ? course.createdAt|date('M d, Y') : 'N/A' }}
                                </div>
                            </td>
                            <td>
                                <div style="display: flex; gap: 8px;">
                                    <a href="{{ path('app_admin_course_show', {'id': course.id}) }}" class="btn-secondary" title="View Details"><i class="fas fa-eye"></i></a>
                                    <a href="{{ path('app_admin_course_edit', {'id': course.id}) }}" class="btn-secondary" title="Edit Course" style="color: var(--primary); border-color: rgba(99, 102, 241, 0.2);"><i class="fas fa-edit"></i></a>
                                    <button type="button" class="btn-secondary" style="color: #ef4444; border-color: #fee2e2;" title="Delete Course" 
                                            onclick="confirmDelete('{{ path('app_course_delete', {'id': course.id}) }}', '{{ csrf_token('delete' ~ course.id) }}')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="7" style="text-align: center;">No courses found.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# Delete Confirmation Modal #}
    <div id="deleteModal" class="modal-overlay">
        <div class="modal-card" style="max-width: 450px;">
            <div class="modal-header">
                <h2>Confirm Deletion</h2>
                <button type="button" class="modal-close" onclick="closeDeleteModal()">&times;</button>
            </div>
            <div class="modal-body" style="text-align: center; padding: 40px 32px;">
                <div style="width: 64px; height: 64px; background: #fee2e2; color: #ef4444; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin: 0 auto 24px;">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <h3 style="margin-bottom: 12px; font-weight: 800;">Are you sure?</h3>
                <p style="color: var(--text-muted); line-height: 1.6;">This course and all its related activities/exams will be permanently removed. This action cannot be undone.</p>
                <form id="deleteForm" method="post" action="">
                    <input type="hidden" name="_token" id="deleteToken" value="">
                </form>
            </div>
            <div class="modal-footer" style="background: white; border-top: none; padding-top: 0;">
                <button type="button" class="btn-secondary" style="flex: 1;" onclick="closeDeleteModal()">Cancel</button>
                <button type="button" class="btn-action" style="flex: 1; background-color: #ef4444; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);" onclick="document.getElementById('deleteForm').submit()">Delete Course</button>
            </div>
        </div>
    </div>

    <script>
        function confirmDelete(actionUrl, token) {
            document.getElementById('deleteForm').action = actionUrl;
            document.getElementById('deleteToken').value = token;
            document.getElementById('deleteModal').classList.add('active');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.remove('active');
        }

        // Close modal when clicking outside
        document.getElementById('deleteModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeDeleteModal();
            }
        });
    </script>

    <style>
        .badge-content {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
        }

        .badge-activity {
            background-color: #e0f2fe;
            color: #0284c7;
            border: 1px solid #bae6fd;
        }

        .badge-activity:hover {
            background-color: #bae6fd;
            color: #0369a1;
        }

        .badge-exam {
            background-color: #fce7f3;
            color: #db2777;
            border: 1px solid #fbcfe8;
        }

        .badge-exam:hover {
            background-color: #fbcfe8;
            color: #be185d;
        }
    </style>
{% endblock %}
