{% extends 'back/base.html.twig' %}

{% block title %}Edit Event{% endblock %}

{% block breadcrumb %}
    <span style="color: var(--admin-text-muted);">Management</span> / <a href="{{ path('app_admin_temps_index') }}" style="color: var(--admin-text-muted); text-decoration: none;">Temps</a> / <span>Edit</span>
{% endblock %}

{% block content %}
    <div class="dashboard-content">

        <div style="margin-bottom: 24px;">
            <h1 class="page-title" style="margin-bottom: 8px;">Edit Event</h1>
            <p style="color: var(--admin-text-muted); font-size: 0.95rem;">Update the schedule entry <strong>{{ event.title }}</strong></p>
        </div>

        <div class="content-card">
            <div class="card-header">
                <h3>Event Details</h3>
                <div style="display: flex; gap: 10px;">
                    <a href="{{ path('app_admin_temps_index') }}" class="btn-secondary"><i class="fas fa-arrow-left"></i> Back to List</a>
                    <form method="post" action="{{ path('app_admin_temps_delete', {'id': event.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');" style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                        <button type="submit" class="btn-secondary" style="color: #ef4444; border-color: #fee2e2;"><i class="fas fa-trash"></i> Delete</button>
                    </form>
                </div>
            </div>

            <div class="card-body" style="padding: 24px;">
                {{ form_start(form) }}
                     {% if not form.vars.valid %}
                    <div class="alert alert-danger" style="margin-bottom: 20px; color: #dc2626;">
                        {{ form_errors(form) }}
                    </div>
                    {% endif %}

                    <div class="form-group">
                        <label class="form-label">Title</label>
                        {{ form_widget(form.title) }}
                         <small style="color: #dc2626;">{{ form_errors(form.title) }}</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Description</label>
                        {{ form_widget(form.description) }}
                         <small style="color: #dc2626;">{{ form_errors(form.description) }}</small>
                    </div>
                
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                        <div class="form-group">
                            <label class="form-label">Type</label>
                            {{ form_widget(form.type) }}
                             <small style="color: #dc2626;">{{ form_errors(form.type) }}</small>
                        </div>
                         <div class="form-group">
                            <label class="form-label">Date</label>
                            {{ form_widget(form.date) }}
                             <small style="color: #dc2626;">{{ form_errors(form.date) }}</small>
                        </div>
                    </div>
                    
                     <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                        <div class="form-group">
                            <label class="form-label">Duration (minutes)</label>
                            {{ form_widget(form.duration) }}
                             <small style="color: #dc2626;">{{ form_errors(form.duration) }}</small>
                        </div>
                         <div class="form-group">
                            <label class="form-label">Location</label>
                            {{ form_widget(form.location) }}
                             <small style="color: #dc2626;">{{ form_errors(form.location) }}</small>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
                        <div class="form-group">
                            <label class="form-label">Status</label>
                            {{ form_widget(form.status) }}
                             <small style="color: #dc2626;">{{ form_errors(form.status) }}</small>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Priority</label>
                            {{ form_widget(form.priority) }}
                             <small style="color: #dc2626;">{{ form_errors(form.priority) }}</small>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Difficulty (1-5)</label>
                            {{ form_widget(form.difficulty) }}
                             <small style="color: #dc2626;">{{ form_errors(form.difficulty) }}</small>
                        </div>
                    </div>

                    <div style="margin-top: 24px; display: flex; gap: 12px; justify-content: flex-end;">
                        <a href="{{ path('app_admin_temps_index') }}" class="btn-action" style="background: white; color: var(--admin-text-main); border: 1px solid var(--admin-border);">Cancel</a>
                        <button type="submit" class="btn-action"><i class="fas fa-save"></i> Update Event</button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
