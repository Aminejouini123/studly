<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Reset your password | Studly</title>
    <style type="text/css">
        #outlook a { padding: 0; }
        body { width: 100% !important; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background-color: #f1f5f9; color: #334155; }
        table { border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
        td { border-collapse: collapse; }
        
        .wrapper { width: 100%; table-layout: fixed; background-color: #f1f5f9; padding: 60px 0; }
        .container { width: 100%; max-width: 700px; margin: 0 auto; background-color: #ffffff; border-radius: 20px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.04); }
        h1 { font-size: 34px; font-weight: 800; color: #0b1120; margin: 0 0 20px 0; letter-spacing: -0.03em; text-align: center; }
        p { font-size: 16px; line-height: 1.7; color: #475569; margin: 0; }
        .header { padding: 50px 0 45px 0; text-align: center; }
        .logo-text { font-size: 30px; font-weight: 900; color: #2563eb; letter-spacing: -1.5px; }
        .content-body { padding: 0 70px 60px 70px; }
        .greeting { font-size: 19px; font-weight: 700; color: #0f172a; margin-bottom: 14px; }
        .card { background-color: #0b1120; border-radius: 28px; padding: 50px; color: #ffffff; box-shadow: 0 30px 60px -12px rgba(11, 17, 32, 0.2); margin: 45px 0; }
        .btn-card { display: inline-block; background-color: #ffffff; color: #2563eb !important; padding: 18px 45px; border-radius: 16px; text-decoration: none !important; font-weight: 800; font-size: 16px; box-shadow: 0 15px 25px -5px rgba(0, 0, 0, 0.15); }
        .footer { padding: 70px 40px; background-color: #0b1120; color: #94a3b8; text-align: center; }
        .footer-logo { font-size: 28px; font-weight: 800; color: #ffffff; margin-bottom: 30px; letter-spacing: -0.8px; }
        .copyright { font-size: 13px; border-top: 1px solid rgba(255, 255, 255, 0.05); padding-top: 40px; max-width: 500px; margin: 0 auto; line-height: 2; opacity: 0.7; }
        .link-text { font-size: 12px; color: #94a3b8; margin-top: 15px; word-break: break-all; }
    </style>
</head>
<body>
    <table border="0" cellpadding="0" cellspacing="0" width="100%" class="wrapper">
        <tr>
            <td align="center">
                <table border="0" cellpadding="0" cellspacing="0" width="700" class="container">
                    <tr>
                        <td class="header">
                            <table border="0" cellpadding="0" cellspacing="0" style="margin: 0 auto;">
                                <tr>
                                    <td style="font-size: 40px; vertical-align: middle; padding-right: 12px; line-height: 1;">🚀</td>
                                    <td class="logo-text" style="vertical-align: middle; padding-top: 4px;">Studly</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td class="content-body" style="padding-top: 10px;">
                            <h1 style="margin-bottom: 35px; line-height: 1.1;">Reset your password</h1>
                            <p class="greeting" style="font-size: 19px; font-weight: 800; color: #0b1120; margin-bottom: 20px;">Hello{% if user and user.firstName %} {{ user.firstName }}{% endif %},</p>
                            <p style="font-size: 17px; color: #4b5563; margin-bottom: 20px;">You requested a password reset. Click the button below to choose a new password. This link expires in 1 hour.</p>
                            <div class="card" style="text-align: center;">
                                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                    <tr>
                                        <td align="center">
                                            <a href="{{ resetUrl }}" class="btn-card">Reset password</a>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td align="center" class="link-text">If the button does not work, copy and paste this link into your browser:<br />{{ resetUrl }}</td>
                                    </tr>
                                </table>
                            </div>
                            <p style="font-size: 14px; color: #64748b;">If you did not request this reset, you can ignore this email. Your password will remain unchanged.</p>
                        </td>
                    </tr>
                    <tr>
                        <td class="footer">
                            <div class="footer-logo">Studly</div>
                            <div class="copyright">
                                &copy; {{ "now"|date("Y") }} Studly Inc. All rights reserved.
                            </div>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
