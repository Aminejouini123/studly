{% extends 'front/base.html.twig' %}

{% block title %}Ajouter une pièce jointe{% endblock %}

{% block body %}
<div class="container-fluid py-5" style="background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%); min-height: 94vh; display: flex; align-items: center;">
    <div class="row justify-content-center w-100">
        <div class="col-md-5">
            <div class="glass-card-upload shadow-lg" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); border-radius: 24px; border: 1px solid rgba(255, 255, 255, 0.5); overflow: hidden; animation: fadeInUp 0.6s ease-out;">
                <div class="p-4 text-center" style="background: linear-gradient(90deg, #0059A9 0%, #003d80 100%); color: white;">
                    <div class="mb-3">
                        <i class="fas fa-paperclip fa-3x mb-2" style="filter: drop-shadow(0 4px 6px rgba(0,0,0,0.1));"></i>
                    </div>
                    <h2 class="h4 fw-bold mb-1">Joindre un fichier</h2>
                    <p class="mb-0 opacity-75 small">{{ project_task.title }}</p>
                </div>
                
                <div class="p-4 p-lg-5">
                    <div class="alert alert-info border-0 shadow-sm mb-4" style="background: #e0f2fe; color: #0369a1; border-radius: 12px; font-size: 0.85rem;">
                        <i class="fas fa-info-circle me-2 font-weight-bold"></i>
                        Ajoutez un document de travail ou une ressource pour cette tâche.
                    </div>

                    {{ form_start(form, {'attr': {'id': 'attachmentForm'}}) }}
                        <div class="upload-zone mb-4" style="border: 2px dashed #cbd5e1; border-radius: 16px; padding: 40px 20px; text-align: center; transition: all 0.3s; background: #f8fafc; cursor: pointer;" onclick="document.getElementById('{{ form.attachment.vars.id }}').click()">
                            <div id="uploadContent">
                                <i class="fas fa-file-upload fa-2x text-primary mb-3"></i>
                                <h5 class="h6 fw-bold text-dark mb-1">Cliquez ou glissez votre fichier</h5>
                                <p class="text-muted small mb-0">PDF, Word, Images ou ZIP (Max 10Mo)</p>
                            </div>
                            <div id="fileSelected" class="d-none">
                                <i class="fas fa-file-check fa-3x text-success mb-3"></i>
                                <h5 class="h6 fw-bold text-success mb-1" id="fileName">Fichier sélectionné</h5>
                                <button type="button" class="btn btn-link btn-sm text-danger text-decoration-none" onclick="event.stopPropagation(); resetUpload()">Changer de fichier</button>
                            </div>
                            {{ form_widget(form.attachment, {'attr': {'class': 'd-none', 'onchange': 'handleFileSelect(this)'}}) }}
                        </div>

                        <div class="d-grid gap-3 mt-5">
                            <button type="submit" class="btn btn-primary shadow-sm" style="background: #0059A9; border: none; padding: 14px; border-radius: 12px; font-weight: 700; font-size: 1rem; transition: all 0.3s;">
                                <i class="fas fa-cloud-upload-alt me-2"></i> Télécharger le fichier
                            </button>
                            <a href="{{ path('app_groups_show', {id: project_task.project.group.id}) }}" class="btn btn-light text-muted" style="border-radius: 12px; padding: 10px; font-weight: 600;">
                                Annuler
                            </a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
    .upload-zone:hover { border-color: #0059A9; background: #eff6ff; }
    .btn-primary:hover { background: #003d80; transform: translateY(-2px); box-shadow: 0 10px 15px -3px rgba(0, 89, 169, 0.3); }
</style>

<script>
    function handleFileSelect(input) {
        if (input.files && input.files[0]) {
            document.getElementById('uploadContent').classList.add('d-none');
            document.getElementById('fileSelected').classList.remove('d-none');
            document.getElementById('fileName').textContent = input.files[0].name;
            document.querySelector('.upload-zone').style.borderColor = '#22c55e';
            document.querySelector('.upload-zone').style.background = '#f0fdf4';
        }
    }

    function resetUpload() {
        document.getElementById('{{ form.attachment.vars.id }}').value = '';
        document.getElementById('uploadContent').classList.remove('d-none');
        document.getElementById('fileSelected').classList.add('d-none');
        document.querySelector('.upload-zone').style.borderColor = '#cbd5e1';
        document.querySelector('.upload-zone').style.background = '#f8fafc';
    }
</script>
{% endblock %}
