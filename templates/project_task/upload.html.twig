{% extends 'front/base.html.twig' %}

{% block title %}Déposer un travail{% endblock %}

{% block body %}
<div class="course-detail-container">
    <div class="detail-wrapper" style="max-width: 700px;">
        <div class="top-bar">
            <a href="{{ path('app_groups_show', {id: project_task.project.group.id}) }}" class="back-link">
                <i class="fas fa-arrow-left"></i> Retour au tableau
            </a>
        </div>

        <div class="hero-header" style="padding: 1.5rem; border-radius: 16px; margin-bottom: 2rem;">
            <div class="hero-meta">
                <span class="badge-pill type">Dépôt de travail</span>
            </div>
            <h1 class="hero-title" style="font-size: 1.5rem; margin-bottom: 0.5rem;">{{ project_task.title }}</h1>
            <p class="mb-0 opacity-75 small">Veuillez sélectionner le fichier final pour cette tâche.</p>
        </div>

        <div class="glass-card">
            <div class="card-header" style="margin-bottom: 1.5rem;">
                <div class="icon-gradient"><i class="fas fa-file-upload"></i></div>
                <h2 style="font-size: 1.1rem; font-weight: 700;">Sélection du fichier</h2>
            </div>
            
            <div class="card-body p-0">
                {{ form_start(form) }}
                    <div class="mb-4">
                        {{ form_label(form.deliverable, 'Fichier deliverable', {'label_attr': {'class': 'form-label fw-bold', 'style': 'color: #1e293b;'}}) }}
                        {{ form_widget(form.deliverable, {'attr': {'class': 'form-control', 'style': 'border-radius: 10px; padding: 10px;'}}) }}
                        <div class="mt-2" style="font-size: 0.85rem; color: #64748b;">
                            <i class="fas fa-info-circle me-1" style="color: var(--primary);"></i> 
                            Formats acceptés : PDF, Word, Images, ZIP (Max 10Mo)
                        </div>
                    </div>

                    <div style="display: flex; gap: 12px; margin-top: 2rem;">
                        <button type="submit" class="btn btn-primary" style="background: #0059A9; border: none; padding: 12px 24px; border-radius: 12px; font-weight: 700; flex: 1;">
                            <i class="fas fa-check-circle me-2"></i> Envoyer le travail
                        </button>
                        <a href="{{ path('app_groups_show', {id: project_task.project.group.id}) }}" class="btn btn-light" style="padding: 12px 24px; border-radius: 12px; font-weight: 600; color: #64748b;">
                            Annuler
                        </a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

<style>
    :root { --primary: #0059A9; --glass-bg: rgba(255, 255, 255, 0.95); --shadow-soft: 0 10px 40px -10px rgba(0,0,0,0.05); --radius-lg: 24px; --radius-md: 16px; }
    .course-detail-container { min-height: 94vh; padding: 2rem; background: #f8fafc; }
    .detail-wrapper { margin: 0 auto; }
    .top-bar { margin-bottom: 2rem; }
    .back-link { display: inline-flex; align-items: center; gap: 8px; color: #0059A9; text-decoration: none; font-weight: 600; }
    .hero-header { background: linear-gradient(135deg, #0059A9 0%, #003366 100%); color: #fff; box-shadow: var(--shadow-soft); }
    .badge-pill { padding: 4px 12px; border-radius: 999px; font-size: 0.75rem; font-weight: 600; background: rgba(255,255,255,0.2); }
    .glass-card { background: var(--glass-bg); border-radius: var(--radius-md); padding: 2rem; box-shadow: var(--shadow-soft); border: 1px solid rgba(0,0,0,0.04); }
    .card-header { display: flex; align-items: center; gap: 12px; }
    .icon-gradient { color: #0059A9; font-size: 1.2rem; }
</style>
{% endblock %}
