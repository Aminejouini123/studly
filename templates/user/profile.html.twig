{% extends 'front/base.html.twig' %}

{% block title %}My Profile{% endblock %}

{% block content %}
<style>
    .profile-header {
        background: linear-gradient(135deg, #003366 0%, #0056b3 100%);
        border-radius: 16px;
        padding: 40px;
        color: white;
        position: relative;
        margin-bottom: 80px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }
    
    .profile-cover-content {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

    .profile-avatar-wrapper {
        position: absolute;
        bottom: -50px;
        left: 40px;
        border: 4px solid white;
        border-radius: 50%;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        background: white;
    }

    .profile-avatar-lg {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        background-color: #f1f5f9;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 3rem;
        color: #003366;
        font-weight: 700;
    }

    .profile-header-info {
        margin-left: 150px; /* Space for avatar */
        flex: 1;
    }

    .profile-header-name {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .profile-header-role {
        background: rgba(255,255,255,0.2);
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.9rem;
        backdrop-filter: blur(5px);
    }

    .profile-stats {
        display: flex;
        gap: 20px;
        margin-right: 20px;
    }

    .stat-box {
        text-align: center;
        background: rgba(255,255,255,0.1);
        padding: 10px 20px;
        border-radius: 12px;
        backdrop-filter: blur(5px);
    }

    .stat-num { font-size: 1.5rem; font-weight: 700; display: block; }
    .stat-label { font-size: 0.8rem; opacity: 0.9; }

    .profile-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 30px;
    }

    .section-card {
        background: white;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        margin-bottom: 30px;
        border: 1px solid #e9ecef;
    }

    .section-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 20px;
        color: #1a1a1a;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .edit-btn {
        background: #0056b3;
        color: white;
        padding: 8px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 0.9rem;
        transition: 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .edit-btn:hover { background: #003366; transform: translateY(-2px); }

    .info-group {
        margin-bottom: 20px;
    }

    .info-label {
        font-size: 0.85rem;
        color: #6c757d;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .info-value {
        font-size: 1.05rem;
        color: #333;
        font-weight: 500;
    }

    .skills-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .skill-badge {
        background: #f1f5f9;
        color: #475569;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 500;
    }

    @media (max-width: 768px) {
        .profile-grid { grid-template-columns: 1fr; }
        .profile-cover-content { flex-direction: column; align-items: center; text-align: center; }
        .profile-header-info { margin-left: 0; margin-top: 60px; }
        .profile-avatar-wrapper { left: 50%; transform: translateX(-50%); bottom: -60px; }
        .profile-stats { margin-top: 20px; margin-right: 0; }
    }
</style>

<div class="profile-header">
    <div class="profile-cover-content">
        <div class="profile-avatar-wrapper">
            {% if user.profilePicture %}
                <img src="{{ asset('uploads/avatars/' ~ user.profilePicture) }}" alt="Avatar" class="profile-avatar-lg">
            {% else %}
                <div class="profile-avatar-lg">{{ user.firstName|first }}{{ user.lastName|first }}</div>
            {% endif %}
        </div>
        <div class="profile-header-info">
            <h1 class="profile-header-name">{{ user.firstName }} {{ user.lastName }}</h1>
            <span class="profile-header-role">{{ user.jobTitle|default('Member') }}</span>
        </div>
        <div class="profile-stats">
            <div class="stat-box">
                <span class="stat-num">{{ user.createdAt|date('Y') }}</span>
                <span class="stat-label">Joined</span>
            </div>
            <div class="stat-box" style="{% if user.googleId %}background: rgba(34, 197, 94, 0.2);{% else %}background: rgba(239, 68, 68, 0.1);{% endif %}">
                <span class="stat-num" style="font-size: 1rem;">
                    {% if user.googleId %}
                        <i class="fab fa-google"></i> Connected
                    {% else %}
                        <i class="fab fa-google"></i> Not Linked
                    {% endif %}
                </span>
                <span class="stat-label">Google Calendar</span>
            </div>
        </div>
    </div>
</div>

<div class="profile-grid">
    <!-- Left Column: Personal Info -->
    <div class="left-col">
        <div class="section-card">
            <div class="section-title">
                About Me
                <a href="{{ path('app_user_profile_edit') }}" class="edit-btn">
                    <i class="fas fa-edit"></i> Edit Profile
                </a>
            </div>
            <p class="info-value" style="color: #666; line-height: 1.6;">
                {{ user.bio|default('No bio added yet.')|nl2br }}
            </p>
        </div>

        <div class="section-card">
            <div class="section-title">Personal Information</div>
            <div class="dashboard-grid" style="grid-template-columns: 1fr 1fr; gap: 20px;">
                <div class="info-group">
                    <div class="info-label">Full Name</div>
                    <div class="info-value">{{ user.firstName }} {{ user.lastName }}</div>
                </div>
                <div class="info-group">
                    <div class="info-label">Email</div>
                    <div class="info-value">{{ user.email }}</div>
                </div>
                <div class="info-group">
                    <div class="info-label">Phone</div>
                    <div class="info-value">{{ user.phoneNumber|default('N/A') }}</div>
                </div>
                <div class="info-group">
                    <div class="info-label">Address</div>
                    <div class="info-value">{{ user.address|default('N/A') }}</div>
                </div>
                <div class="info-group">
                    <div class="info-label">Date of Birth</div>
                    <div class="info-value">{{ user.dateOfBirth ? user.dateOfBirth|date('M d, Y') : 'N/A' }}</div>
                </div>
                <div class="info-group">
                    <div class="info-label">Website</div>
                    <div class="info-value">
                        {% if user.website %}
                            <a href="{{ user.website }}" target="_blank" style="color: #0056b3; text-decoration: none;">{{ user.website }}</a>
                        {% else %}
                            N/A
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Activity Section -->
        <div class="section-card">
            <div class="section-title">
                Activity History
            </div>
            
            <!-- Heatmap Container -->
            <div class="heatmap-wrapper" style="margin-bottom: 30px; overflow-x: auto; padding-bottom: 15px;">
                <div class="info-label" style="margin-bottom: 15px;">Activity Heatmap (Last 12 Months)</div>
                <div id="activity-heatmap" class="heatmap" style="display: flex; gap: 3px; min-width: 700px;">
                    <!-- Will be populated by JS -->
                </div>
                <div class="heatmap-legend" style="display: flex; justify-content: flex-end; align-items: center; gap: 5px; margin-top: 10px; font-size: 0.75rem; color: #666;">
                    <span>Less</span>
                    <div style="width: 12px; height: 12px; background: #ebedf0; border-radius: 2px;"></div>
                    <div style="width: 12px; height: 12px; background: #9be9a8; border-radius: 2px;"></div>
                    <div style="width: 12px; height: 12px; background: #40c463; border-radius: 2px;"></div>
                    <div style="width: 12px; height: 12px; background: #30a14e; border-radius: 2px;"></div>
                    <div style="width: 12px; height: 12px; background: #216e39; border-radius: 2px;"></div>
                <div id="heatmap-debug" style="font-size: 0.7rem; color: #999; margin-top: 5px;">
                    Debug: Detected {{ heatmapData|length }} active days.
                </div>
            </div>

            <div class="info-label" style="margin-bottom: 15px;">Recent Actions</div>
            <div class="activity-timeline">
                {% if recentActions is empty %}
                    <p style="color: #999; font-style: italic; text-align: center; padding: 20px;">No activity recorded yet.</p>
                {% else %}
                    <ul style="list-style: none; padding: 0; margin: 0;">
                        {% for action in recentActions %}
                            <li style="display: flex; gap: 15px; margin-bottom: 20px; position: relative; padding-left: 20px; border-left: 2px solid #e2e8f0;">
                                <div style="position: absolute; left: -7px; top: 0; width: 12px; height: 12px; border-radius: 50%; background: #0056b3; border: 2px solid white;"></div>
                                <div style="flex: 1;">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 4px;">
                                        <span style="font-weight: 600; font-size: 0.95rem; color: #1e293b;">
                                            {% if action.actionType == 'course_created' %}
                                                <i class="fas fa-book" style="color: #3b82f6; margin-right: 5px;"></i>
                                            {% elseif action.actionType == 'group_created' %}
                                                <i class="fas fa-users" style="color: #10b981; margin-right: 5px;"></i>
                                            {% elseif action.actionType == 'exam_created' %}
                                                <i class="fas fa-file-alt" style="color: #f59e0b; margin-right: 5px;"></i>
                                            {% elseif action.actionType == 'project_created' %}
                                                <i class="fas fa-project-diagram" style="color: #8b5cf6; margin-right: 5px;"></i>
                                            {% elseif action.actionType == 'pomodoro_completed' %}
                                                <i class="fas fa-stopwatch" style="color: #ef4444; margin-right: 5px;"></i>
                                            {% else %}
                                                <i class="fas fa-dot-circle" style="color: #64748b; margin-right: 5px;"></i>
                                            {% endif %}
                                            {{ action.description }}
                                        </span>
                                        <span style="font-size: 0.8rem; color: #64748b; white-space: nowrap;">{{ action.createdAt|date('M d, H:i') }}</span>
                                    </div>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </div>

        <!-- Education Section -->
        <div class="section-card">
            <div class="section-title">Education</div>
            <div class="info-group">
                <div class="info-label">Level of Study</div>
                <div class="info-value">{{ user.educationLevel|default('Not specified') }}</div>
            </div>
        </div>
    </div>

    <!-- Right Column: Skills & Social -->
    <div class="right-col">
        <div class="section-card">
            <div class="section-title">Skills</div>
            <div class="skills-badges">
                {% if user.skills %}
                    {% for skill in user.skills %}
                        <span class="skill-badge">{{ skill }}</span>
                    {% endfor %}
                {% else %}
                    <span style="color: #999; font-style: italic;">No skills listed</span>
                {% endif %}
            </div>
        </div>
        
        {% if is_granted('ROLE_ADMIN') %}
        <div class="section-card">
            <div class="section-title">Admin Info</div>
            <div class="info-group">
                <div class="info-label">Account Status</div>
                <div class="info-value">
                    <span class="status-badge status-{{ user.statut == 'Active' ? 'active' : 'pending' }}">{{ user.statut }}</span>
                </div>
            </div>
            <div class="info-group">
                <div class="info-label">User ID</div>
                <div class="info-value">{{ user.id }}</div>
            </div>
        </div>
        {% endif %}

        <!-- Face ID Registration -->
        <div class="section-card">
            <div class="section-title">Face ID Authentication</div>
            <div id="face-id-container">
                <p>Register your face for faster and more secure login.</p>
                <div id="face-video-container" style="display: none; position: relative; margin-top: 15px;">
                    <video id="face-video" width="100%" height="auto" autoplay muted style="border-radius: 8px; border: 2px solid #0056b3;"></video>
                </div>
                <div id="face-feedback" style="margin-top: 10px; font-weight: 500; font-size: 0.9rem;"></div>
                
                <div style="margin-top: 20px; display: flex; gap: 10px;">
                    <button class="edit-btn" id="btn-start-camera" type="button" style="cursor: pointer; border: none; font-family: inherit;">
                        <i class="fas fa-camera"></i> Start Camera
                    </button>
                    <button class="edit-btn" id="btn-capture-face" type="button" style="cursor: pointer; border: none; font-family: inherit; display: none; background: #28a745;">
                        <i class="fas fa-expand-scan"></i> Capture & Register
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', async () => {
        const video = document.getElementById('face-video');
        const btnStart = document.getElementById('btn-start-camera');
        const btnCapture = document.getElementById('btn-capture-face');
        const videoContainer = document.getElementById('face-video-container');
        const feedback = document.getElementById('face-feedback');
        let stream = null;

        btnStart.addEventListener('click', async () => {
            btnStart.disabled = true;
            feedback.innerHTML = '<span style="color: #0056b3;">Loading AI Models... Please wait.</span>';
            
            try {
                // Models must be placed in public/models
                await Promise.all([
                    faceapi.nets.ssdMobilenetv1.loadFromUri('/models'),
                    faceapi.nets.faceLandmark68Net.loadFromUri('/models'),
                    faceapi.nets.faceRecognitionNet.loadFromUri('/models')
                ]);
                
                feedback.innerHTML = '<span style="color: #0056b3;">Accessing camera...</span>';
                stream = await navigator.mediaDevices.getUserMedia({ video: {} });
                video.srcObject = stream;
                
                video.onloadedmetadata = () => {
                    videoContainer.style.display = 'block';
                    btnStart.style.display = 'none';
                    btnCapture.style.display = 'inline-flex';
                    btnCapture.disabled = false; // Reset disabled state here!
                    feedback.innerHTML = '<span style="color: #28a745;">Camera ready. Position your face clearly.</span>';
                };
            } catch (err) {
                console.error(err);
                feedback.innerHTML = '<span style="color: #dc3545;">Failed to load camera or models. Did you download them to /public/models?</span>';
                btnStart.disabled = false;
            }
        });

        btnCapture.addEventListener('click', async () => {
            btnCapture.disabled = true;
            feedback.innerHTML = '<span style="color: #0056b3;">Analyzing face (taking 3 captures)...</span>';

            const descriptors = [];
            const requiredCaptures = 3;

            try {
                for (let i = 0; i < requiredCaptures; i++) {
                    const detection = await faceapi.detectSingleFace(video).withFaceLandmarks().withFaceDescriptor();
                    
                    if (!detection) {
                        feedback.innerHTML = `<span style="color: #dc3545;">No face detected in capture ${i+1}. Please face the camera directly and try again.</span>`;
                        btnCapture.disabled = false;
                        return;
                    }
                    
                    descriptors.push(detection.descriptor);
                    feedback.innerHTML = `<span style="color: #0056b3;">Capture ${i+1}/${requiredCaptures} successful...</span>`;
                    
                    if (i < requiredCaptures - 1) {
                        await new Promise(resolve => setTimeout(resolve, 500));
                    }
                }

                // Average the 3 descriptors
                const averagedDescriptor = new Float32Array(128);
                for (let i = 0; i < 128; i++) {
                    let sum = 0;
                    for (let j = 0; j < requiredCaptures; j++) {
                        sum += descriptors[j][i];
                    }
                    averagedDescriptor[i] = sum / requiredCaptures;
                }

                feedback.innerHTML = '<span style="color: #0056b3;">Saving Face ID securely...</span>';
                const csrfToken = '{{ csrf_token('face_register') }}';

                const response = await fetch('{{ path('app_face_register') }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': csrfToken
                    },
                    body: JSON.stringify({
                        descriptor: Array.from(averagedDescriptor)
                    })
                });

                const data = await response.json();
                
                if (response.ok) {
                    feedback.innerHTML = '<span style="color: #28a745;"><i class="fas fa-check-circle"></i> Face ID registered successfully!</span>';
                } else {
                    throw new Error(data.error || 'Server error');
                }

            } catch (err) {
                console.error(err);
                feedback.innerHTML = `<span style="color: #dc3545;">Error: ${err.message}</span>`;
            } finally {
                // Stop camera
                if (stream) {
                    stream.getTracks().forEach(track => track.stop());
                }
                btnCapture.style.display = 'none';
                btnStart.style.display = 'inline-flex';
                btnStart.innerHTML = '<i class="fas fa-camera"></i> Register Again';
                btnStart.disabled = false;
            }
        });
    });

    // Activity Heatmap Initialization
    (function() {
        const heatmapData = {{ heatmapData|json_encode|raw }};
        const heatmapContainer = document.getElementById('activity-heatmap');
        const debugInfo = document.getElementById('heatmap-debug');
        if (!heatmapContainer) return;

        const weeks = 53;
        const daysPerWeek = 7;
        
        // Get today's local date part
        const now = new Date();
        const yToday = now.getFullYear();
        const mToday = String(now.getMonth() + 1).padStart(2, '0');
        const dToday = String(now.getDate()).padStart(2, '0');
        const todayStr = `${yToday}-${mToday}-${dToday}`;
        
        // Start date: Sunday 52 weeks ago. Use noon to avoid DST issues!
        const startDate = new Date();
        startDate.setHours(12, 0, 0, 0); 
        startDate.setDate(startDate.getDate() - (weeks * 7) + 1);
        startDate.setDate(startDate.getDate() - startDate.getDay());

        heatmapContainer.innerHTML = ''; 

        let matches = 0;
        for (let w = 0; w < weeks; w++) {
            const weekCol = document.createElement('div');
            weekCol.style.display = 'flex';
            weekCol.style.flexDirection = 'column';
            weekCol.style.gap = '3px';

            for (let d = 0; d < daysPerWeek; d++) {
                const dayDate = new Date(startDate);
                dayDate.setDate(startDate.getDate() + (w * 7) + d);
                
                const y = dayDate.getFullYear();
                const m = String(dayDate.getMonth() + 1).padStart(2, '0');
                const dd = String(dayDate.getDate()).padStart(2, '0');
                const dateString = `${y}-${m}-${dd}`;
                
                const count = heatmapData[dateString] || 0;
                if (count > 0) matches++;

                const daySquare = document.createElement('div');
                daySquare.style.width = '12px';
                daySquare.style.height = '12px';
                daySquare.style.borderRadius = '2px';
                daySquare.title = `${dateString}: ${count} actions`;
                
                // Highlight today
                if (dateString === todayStr) {
                    daySquare.style.outline = '2px solid #0056b3';
                    daySquare.style.outlineOffset = '1px';
                }

                // Set color based on count
                if (count === 0) daySquare.style.background = '#ebedf0';
                else if (count < 3) daySquare.style.background = '#9be9a8';
                else if (count < 6) daySquare.style.background = '#40c463';
                else if (count < 10) daySquare.style.background = '#30a14e';
                else daySquare.style.background = '#216e39';

                weekCol.appendChild(daySquare);
            }
            heatmapContainer.appendChild(weekCol);
        }

        if (debugInfo) {
            debugInfo.innerHTML = `Data points: ${Object.keys(heatmapData).length} | Rendered matches: ${matches} | Last key: ${Object.keys(heatmapData).pop() || 'none'}`;
        }
    })();
</script>
{% endblock %}
