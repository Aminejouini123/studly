{% extends 'front/base.html.twig' %}

{% block title %}My Profile{% endblock %}

{% block content %}
<style>
    .profile-header {
        background: linear-gradient(135deg, #003366 0%, #0056b3 100%);
        border-radius: 16px;
        padding: 40px;
        color: white;
        position: relative;
        margin-bottom: 80px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }
    
    .profile-cover-content {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

    .profile-avatar-wrapper {
        position: absolute;
        bottom: -50px;
        left: 40px;
        border: 4px solid white;
        border-radius: 50%;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        background: white;
    }

    .profile-avatar-lg {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        background-color: #f1f5f9;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 3rem;
        color: #003366;
        font-weight: 700;
    }

    .profile-header-info {
        margin-left: 150px; /* Space for avatar */
        flex: 1;
    }

    .profile-header-name {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .profile-header-role {
        background: rgba(255,255,255,0.2);
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.9rem;
        backdrop-filter: blur(5px);
    }

    .profile-stats {
        display: flex;
        gap: 20px;
        margin-right: 20px;
    }

    .stat-box {
        text-align: center;
        background: rgba(255,255,255,0.1);
        padding: 10px 20px;
        border-radius: 12px;
        backdrop-filter: blur(5px);
    }

    .stat-num { font-size: 1.5rem; font-weight: 700; display: block; }
    .stat-label { font-size: 0.8rem; opacity: 0.9; }

    .profile-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 30px;
    }

    .section-card {
        background: white;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        margin-bottom: 30px;
        border: 1px solid #e9ecef;
    }

    .section-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 20px;
        color: #1a1a1a;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .edit-btn {
        background: #0056b3;
        color: white;
        padding: 8px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 0.9rem;
        transition: 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .edit-btn:hover { background: #003366; transform: translateY(-2px); }

    .info-group {
        margin-bottom: 20px;
    }

    .info-label {
        font-size: 0.85rem;
        color: #6c757d;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .info-value {
        font-size: 1.05rem;
        color: #333;
        font-weight: 500;
    }

    .skills-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .skill-badge {
        background: #f1f5f9;
        color: #475569;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 500;
    }

    @media (max-width: 768px) {
        .profile-grid { grid-template-columns: 1fr; }
        .profile-cover-content { flex-direction: column; align-items: center; text-align: center; }
        .profile-header-info { margin-left: 0; margin-top: 60px; }
        .profile-avatar-wrapper { left: 50%; transform: translateX(-50%); bottom: -60px; }
        .profile-stats { margin-top: 20px; margin-right: 0; }
    }
</style>

<div class="profile-header">
    <div class="profile-cover-content">
        <div class="profile-avatar-wrapper">
            {% if user.profilePicture %}
                <img src="{{ asset('uploads/avatars/' ~ user.profilePicture) }}" alt="Avatar" class="profile-avatar-lg">
            {% else %}
                <div class="profile-avatar-lg">{{ user.firstName|first }}{{ user.lastName|first }}</div>
            {% endif %}
        </div>
        <div class="profile-header-info">
            <h1 class="profile-header-name">{{ user.firstName }} {{ user.lastName }}</h1>
            <span class="profile-header-role">{{ user.jobTitle|default('Member') }}</span>
        </div>
        <div class="profile-stats">
            <div class="stat-box">
                <span class="stat-num">{{ user.createdAt|date('Y') }}</span>
                <span class="stat-label">Joined</span>
            </div>
            <div class="stat-box" style="{% if user.googleId %}background: rgba(34, 197, 94, 0.2);{% else %}background: rgba(239, 68, 68, 0.1);{% endif %}">
                <span class="stat-num" style="font-size: 1rem;">
                    {% if user.googleId %}
                        <i class="fab fa-google"></i> Connected
                    {% else %}
                        <i class="fab fa-google"></i> Not Linked
                    {% endif %}
                </span>
                <span class="stat-label">Google Calendar</span>
            </div>
        </div>
    </div>
</div>

<div class="profile-grid">
    <!-- Left Column: Personal Info -->
    <div class="left-col">
        <div class="section-card">
            <div class="section-title">
                About Me
                <a href="{{ path('app_user_profile_edit') }}" class="edit-btn">
                    <i class="fas fa-edit"></i> Edit Profile
                </a>
            </div>
            <p class="info-value" style="color: #666; line-height: 1.6;">
                {{ user.bio|default('No bio added yet.')|nl2br }}
            </p>
        </div>

        <div class="section-card">
            <div class="section-title">Personal Information</div>
            <div class="dashboard-grid" style="grid-template-columns: 1fr 1fr; gap: 20px;">
                <div class="info-group">
                    <div class="info-label">Full Name</div>
                    <div class="info-value">{{ user.firstName }} {{ user.lastName }}</div>
                </div>
                <div class="info-group">
                    <div class="info-label">Email</div>
                    <div class="info-value">{{ user.email }}</div>
                </div>
                <div class="info-group">
                    <div class="info-label">Phone</div>
                    <div class="info-value">{{ user.phoneNumber|default('N/A') }}</div>
                </div>
                <div class="info-group">
                    <div class="info-label">Address</div>
                    <div class="info-value">{{ user.address|default('N/A') }}</div>
                </div>
                <div class="info-group">
                    <div class="info-label">Date of Birth</div>
                    <div class="info-value">{{ user.dateOfBirth ? user.dateOfBirth|date('M d, Y') : 'N/A' }}</div>
                </div>
                <div class="info-group">
                    <div class="info-label">Website</div>
                    <div class="info-value">
                        {% if user.website %}
                            <a href="{{ user.website }}" target="_blank" style="color: #0056b3; text-decoration: none;">{{ user.website }}</a>
                        {% else %}
                            N/A
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Education Section -->
        <div class="section-card">
            <div class="section-title">Education</div>
            <div class="info-group">
                <div class="info-label">Level of Study</div>
                <div class="info-value">{{ user.educationLevel|default('Not specified') }}</div>
            </div>
        </div>
    </div>

    <!-- Right Column: Skills & Social -->
    <div class="right-col">
        <div class="section-card">
            <div class="section-title">Skills</div>
            <div class="skills-badges">
                {% if user.skills %}
                    {% for skill in user.skills %}
                        <span class="skill-badge">{{ skill }}</span>
                    {% endfor %}
                {% else %}
                    <span style="color: #999; font-style: italic;">No skills listed</span>
                {% endif %}
            </div>
        </div>
        
        {% if is_granted('ROLE_ADMIN') %}
        <div class="section-card">
            <div class="section-title">Admin Info</div>
            <div class="info-group">
                <div class="info-label">Account Status</div>
                <div class="info-value">
                    <span class="status-badge status-{{ user.statut == 'Active' ? 'active' : 'pending' }}">{{ user.statut }}</span>
                </div>
            </div>
            <div class="info-group">
                <div class="info-label">User ID</div>
                <div class="info-value">{{ user.id }}</div>
            </div>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
