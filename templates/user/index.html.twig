{% extends 'back/base.html.twig' %}

{% block title %}User Management{% endblock %}

{% block breadcrumb %}User Management{% endblock %}

{% block content %}
    <div class="dashboard-content">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: none; padding: 0;">
            <h1 class="page-title" style="margin: 0;">User Management</h1>
            <button class="btn-action" onclick="openModal()">
                <i class="fas fa-plus"></i> Create New
            </button>
        </div>

        <!-- Create/Edit User Modal -->
        <div class="modal-overlay" id="userModal">
            <div class="modal-card">
                <div class="modal-header">
                    <h2>Create New User</h2>
                    <button class="modal-close" onclick="closeModal()">&times;</button>
                </div>
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="modal-body">
                    <div class="form-group">
                        {{ form_label(form.email, 'Email Address', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'name@example.com', 'id': 'user_email'}}) }}
                        {{ form_errors(form.email) }}
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div class="form-group">
                            {{ form_label(form.firstName, 'First Name', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.firstName, {'attr': {'class': 'form-control', 'id': 'user_firstName'}}) }}
                            {{ form_errors(form.firstName) }}
                        </div>
                        <div class="form-group">
                            {{ form_label(form.lastName, 'Last Name', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.lastName, {'attr': {'class': 'form-control', 'id': 'user_lastName'}}) }}
                            {{ form_errors(form.lastName) }}
                        </div>
                    </div>
                    <div class="form-group">
                        {{ form_label(form.roles, 'User Role', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.roles, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.roles) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.plainPassword, 'Password', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control', 'placeholder': 'Min 6 characters', 'id': 'user_plainPassword'}}) }}
                        {{ form_errors(form.plainPassword) }}
                    </div>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div class="form-group">
                            {{ form_label(form.dateOfBirth, 'Date of Birth', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.dateOfBirth, {'attr': {'class': 'form-control', 'id': 'user_dateOfBirth'}}) }}
                            {{ form_errors(form.dateOfBirth) }}
                        </div>
                        <div class="form-group">
                            {{ form_label(form.phoneNumber, 'Phone Number', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.phoneNumber, {'attr': {'class': 'form-control', 'id': 'user_phoneNumber'}}) }}
                            {{ form_errors(form.phoneNumber) }}
                        </div>
                    </div>

                    <!-- Address & Status Side-by-Side -->
                    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px;">
                        <div class="form-group">
                            {{ form_label(form.address, 'Address', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.address, {'attr': {'class': 'form-control', 'rows': '1', 'id': 'user_address', 'style': 'resize: none; height: 38px;'}}) }}
                            {{ form_errors(form.address) }}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.statut, 'Status', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.statut, {'attr': {'class': 'form-control', 'id': 'user_statut'}}) }}
                            {{ form_errors(form.statut) }}
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="closeModal()">Cancel</button>
                    <button type="submit" class="btn-action">Create User</button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>

        <div class="content-card">
    <style>
        /* Refined Filter Toolbar Styles */
        .filter-toolbar {
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(10px);
            padding: 24px;
            border-radius: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 32px;
            border: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
        }

        .search-container {
            flex: 1;
            max-width: 400px;
            position: relative;
        }

        .search-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            pointer-events: none;
            transition: var(--transition);
        }

        .search-input {
            width: 100%;
            padding: 12px 16px 12px 48px;
            background: #fff;
            border: 1.5px solid #eef2f6;
            border-radius: 12px;
            font-size: 0.95rem;
            transition: var(--transition);
        }

        .search-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        }
        
        .search-input:focus + .search-icon {
            color: var(--primary);
        }

        .filter-actions {
            display: flex;
            gap: 12px;
        }

        .custom-select-wrapper {
            position: relative;
        }

        @media (max-width: 768px) {
            .filter-toolbar {
                flex-direction: column;
                align-items: stretch;
            }
            .search-container {
                max-width: 100%;
            }
            .filter-actions {
                flex-wrap: wrap;
            }
        }
    </style>

    <div class="content-card">
        <!-- Search & Filter Toolkit -->
        <div class="filter-toolbar">
            <div class="search-container">
                <input type="text" id="searchInput" class="search-input" placeholder="Search by email, name...">
                <i class="fas fa-search search-icon"></i>
            </div>
            
            <div class="filter-actions">
                <div class="custom-select-wrapper">
                    <select id="roleFilter" class="custom-select">
                        <option value="">All Roles</option>
                        <option value="student">Student</option>
                        <option value="admin">Admin</option>
                    </select>
                    <i class="fas fa-chevron-down select-arrow"></i>
                </div>

                <div class="custom-select-wrapper">
                    <select id="sortOrder" class="custom-select">
                        <option value="DESC">Newest First</option>
                        <option value="ASC">Oldest First</option>
                    </select>
                    <i class="fas fa-sort-amount-down select-arrow"></i>
                </div>
            </div>
        </div>

            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Identity</th>
                            <th>Contact</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Joined</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="userTableBody">
                    {% for user in users %}
                        <tr>
                            <td>{{ user.id }}</td>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 2px;">
                                    <span style="font-weight: 700; color: var(--text-main); font-size: 1rem;">{{ user.firstName }} {{ user.lastName }}</span>
                                    <span style="font-size: 0.85rem; color: var(--text-muted); font-weight: 500;">{{ user.email }}</span>
                                    <div style="margin-top: 4px; display: flex; align-items: center; gap: 6px; font-size: 0.75rem; color: var(--text-muted);">
                                        <i class="fas fa-calendar-alt" style="font-size: 0.7rem;"></i>
                                        <span>DOB: {{ user.dateOfBirth ? user.dateOfBirth|date('M d, Y') : 'N/A' }}</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 6px;">
                                    {% if user.phoneNumber %}
                                        <div style="display: flex; align-items: center; gap: 8px; font-size: 0.9rem;">
                                            <i class="fas fa-phone" style="width: 14px; color: var(--primary); opacity: 0.7;"></i>
                                            <span style="font-weight: 500;">{{ user.phoneNumber }}</span>
                                        </div>
                                    {% endif %}
                                    {% if user.address %}
                                        <div style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--text-muted);" title="{{ user.address }}">
                                            <i class="fas fa-map-marker-alt" style="width: 14px; color: var(--primary); opacity: 0.7;"></i>
                                            <span>{{ user.address|length > 25 ? user.address|slice(0, 25) ~ '...' : user.address }}</span>
                                        </div>
                                    {% endif %}
                                    {% if not user.phoneNumber and not user.address %}
                                        <span style="color: var(--text-muted); font-style: italic; font-size: 0.85rem;">No contact info</span>
                                    {% endif %}
                                </div>
                            </td>
                            <td>
                                {% if 'ROLE_ADMIN' in user.roles %}
                                    <span class="status-badge" style="background: #e0e7ff; color: #3730a3; border: 1px solid #c7d2fe;">Admin</span>
                                {% elseif 'ROLE_ETUDIANT' in user.roles %}
                                    <span class="status-badge" style="background: #f0f9ff; color: #0369a1; border: 1px solid #bae6fd;">Student</span>
                                {% else %}
                                    <span class="status-badge" style="background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0;">User</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="status-badge {{ user.statut == 'Active' ? 'status-active' : (user.statut == 'Pending' ? 'status-pending' : '') }}" 
                                      style="{{ user.statut == 'Inactive' ? 'background: #fee2e2; color: #991b1b;' : '' }}">
                                    {{ user.statut }}
                                </span>
                            </td>
                            <td style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">
                                {{ user.createdAt ? user.createdAt|date('M d, Y') : 'N/A' }}
                            </td>
                            <td style="display: flex; gap: 8px;">
                                <button class="btn-secondary" style="color: var(--primary); border-color: rgba(99, 102, 241, 0.2);" 
                                    onclick='openEditModal({
                                        id: {{ user.id }},
                                        email: "{{ user.email|e("js") }}",
                                        firstName: "{{ user.firstName|e("js") }}",
                                        lastName: "{{ user.lastName|e("js") }}",
                                        roles: {{ user.roles|json_encode|raw }},
                                        dateOfBirth: "{{ user.dateOfBirth ? user.dateOfBirth|date('Y-m-d') : '' }}",
                                        phoneNumber: "{{ user.phoneNumber|default('')|e("js") }}",
                                        address: "{{ user.address|default('')|e("js")|replace({"\n": "\\n", "\r": ""}) }}",
                                        statut: "{{ user.statut|default('Pending')|e("js") }}"
                                    })' title="Edit User">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <form method="post" action="{{ path('app_admin_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Are you sure you want to delete this user?');" style="display: inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                    <button class="btn-secondary" style="color: #ef4444; border-color: #fee2e2;" title="Delete User">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 40px; color: var(--admin-text-muted);">
                                <i class="fas fa-inbox" style="font-size: 2rem; margin-bottom: 10px; display: block;"></i>
                                No users found matching your criteria
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        const modal = document.getElementById('userModal');
        const modalTitle = modal.querySelector('.modal-header h2');
        const modalBtn = modal.querySelector('.modal-footer .btn-action');
        const form = modal.querySelector('form');
        
        // Store default action for "Create" mode
        const createAction = "{{ path('app_admin_user_index') }}";

        function openModal() {
            // Reset to Create Mode
            modalTitle.innerText = 'Create New User';
            modalBtn.innerText = 'Create User';
            form.action = createAction;
            form.reset();
            
            // Clear role checkboxes
            document.querySelectorAll('input[name="user[roles][]"]').forEach(cb => cb.checked = false);

            modal.style.display = 'flex';
            setTimeout(() => modal.classList.add('active'), 10);
        }

        function openEditModal(user) {
            // Switch to Edit Mode
            modalTitle.innerText = 'Edit User';
            modalBtn.innerText = 'Update User';
            
            // Update Form Action (Correctly handles routing)
            form.action = "/admin/user/" + user.id + "/edit";
            
            // Populate Fields
            document.getElementById('user_email').value = user.email;
            document.getElementById('user_firstName').value = user.firstName;
            document.getElementById('user_lastName').value = user.lastName;
            document.getElementById('user_dateOfBirth').value = user.dateOfBirth;
            document.getElementById('user_phoneNumber').value = user.phoneNumber;
            document.getElementById('user_address').value = user.address;
            
            // Handle Status Select
            const statusSelect = document.getElementById('user_statut');
            if(statusSelect) statusSelect.value = user.statut;
            
            // Handle Roles
            document.querySelectorAll('input[name="user[roles][]"]').forEach(cb => {
                cb.checked = user.roles.includes(cb.value);
            });

            // Make Password Optional visual cue (optional)
            document.getElementById('user_plainPassword').placeholder = "Leave blank to keep current";

            modal.style.display = 'flex';
            setTimeout(() => modal.classList.add('active'), 10);
        }

        function closeModal() {
            modal.classList.remove('active');
            setTimeout(() => modal.style.display = 'none', 300);
        }

        // Auto-open if there are form errors (keeps current mode, server renders form with errors)
        {% if not form.vars.valid %}
            window.onload = function() {
                modal.style.display = 'flex';
                setTimeout(() => modal.classList.add('active'), 10);
            }
        {% endif %}

        // Close on overlay click
        window.onclick = function(event) {
            if (event.target == modal) {
                closeModal();
            }
        }
        // Real-time Search & Filter Logic
        const searchInput = document.getElementById('searchInput');
        const roleFilter = document.getElementById('roleFilter');
        const sortOrder = document.getElementById('sortOrder');
        const tableBody = document.getElementById('userTableBody');

        function fetchUsers() {
            const query = searchInput.value;
            const role = roleFilter.value;
            const sort = sortOrder.value;

            const url = `{{ path('app_admin_user_index') }}?q=${encodeURIComponent(query)}&role=${encodeURIComponent(role)}&sort=${encodeURIComponent(sort)}`;

            fetch(url, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.text())
            .then(html => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const newBody = doc.getElementById('userTableBody').innerHTML;
                tableBody.innerHTML = newBody;
            })
            .catch(error => console.error('Error fetching users:', error));
        }

        // Debounce function to limit API calls
        function debounce(func, wait) {
            let timeout;
            return function executedFunction(...args) {
                const later = () => {
                    clearTimeout(timeout);
                    func(...args);
                };
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
            };
        }

        const debouncedFetch = debounce(fetchUsers, 300);

        searchInput.addEventListener('input', debouncedFetch);
        roleFilter.addEventListener('change', fetchUsers);
        sortOrder.addEventListener('change', fetchUsers);
    </script>
{% endblock %}
