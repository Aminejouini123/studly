{% extends 'back/base.html.twig' %}

{% block title %}Time Management{% endblock %}

{% block breadcrumb %}Time Management{% endblock %}

{% block content %}
    <div class="dashboard-content">
        <h1 class="page-title">Time Management</h1>
        <div class="content-card">
            <div class="card-header">
                <h3>Schedule</h3>
                <button class="btn-action"><i class="fas fa-plus"></i> Add Entry</button>
            </div>
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Event</th>
                            <th>Date</th>
                            <th>Duration</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="5" style="text-align: center;">No schedule entries found.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
