{% extends 'front/base.html.twig' %}

{% block title %}Time Management - Student Hub{% endblock %}

{% block content %}
<style>
/* Time management form design — cleaner grid, spacing and responsive layout */
.time-management-header { margin-bottom: 18px; }
.time-management-header h1 { font-size: 1.8rem; color: #1a1a1a; }
.row { display:flex; gap:12px; align-items:center; justify-content:space-between; }

/* Add Event toggle button */
.form-toggle-btn { display:inline-flex; align-items:center; gap:10px; padding:12px 20px; border-radius:999px; background:linear-gradient(90deg,var(--primary-dark),var(--primary-light)); color:#fff; border:none; cursor:pointer; font-weight:700; font-size:0.98rem; box-shadow:0 10px 26px rgba(0,51,102,0.15); transition:transform .14s ease, box-shadow .14s ease, opacity .12s; }
.form-toggle-btn i { font-size:1.05rem; }
.form-toggle-btn:hover { transform:translateY(-2px); box-shadow:0 12px 30px rgba(0,51,102,0.12); }
.form-toggle-btn:active { transform:translateY(0); }
.form-toggle-btn:focus { outline:3px solid rgba(0,51,102,0.12); outline-offset:2px; }
.form-toggle-btn.open { background:linear-gradient(90deg,var(--primary-light),var(--primary-dark)); }
@media (max-width:700px){ .form-toggle-btn { width:100%; justify-content:center; } }

.form-card { background:#fff; border:1px solid var(--border-color); border-radius:12px; padding:18px; box-shadow:var(--shadow-sm); max-width:1100px; margin:0 auto 16px; }
.form-card.hidden { display:none; }
.form-card .card-header { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:12px; }
.form-card h2 { margin:0; font-size:1.2rem; color:var(--text-dark); }
.form-card p.lead { margin:4px 0 0; color:var(--text-muted); font-size:0.95rem; }

.form-grid { display:grid; grid-template-columns: 1fr 1fr; gap:12px 18px; align-items:start; }
.form-grid .full { grid-column:1 / -1; }
.form-group { display:flex; flex-direction:column; gap:6px; margin-bottom:8px; }
.form-group label { font-weight:600; color:var(--text-dark); font-size:0.94rem; }
.form-control { padding:10px 12px; border-radius:10px; border:1px solid var(--border-color); background:#fff; font-size:0.95rem; }
.form-control:focus { outline:none; border-color:var(--primary-dark); box-shadow:0 6px 18px rgba(0,51,102,0.06); }

.form-actions { display:flex; gap:12px; justify-content:flex-end; margin-top:8px; }
.btn-primary { padding:10px 16px; border-radius:10px; background:linear-gradient(135deg,var(--primary-dark),var(--primary-light)); color:#fff; border:none; font-weight:700; }
.btn-secondary { padding:10px 14px; border-radius:10px; border:1px solid var(--border-color); background:transparent; color:var(--primary-dark); }

/* Compact variant: single-column, tighter spacing, preview hidden */
.form-card.compact { max-width:760px; margin:0 auto 16px; }
.form-card.compact .form-body { display:block; }
.form-card.compact .form-grid { grid-template-columns: 1fr; gap:8px; }
.form-card.compact .full { grid-column: 1 / -1; }
.form-card.compact .preview { display:none; }
.form-card.compact .form-actions { justify-content:flex-end; }
.form-card.compact .btn-primary { min-width:160px; }

.form-error-message { color:#ff4757; font-size:0.85rem; margin-top:6px; display:flex; gap:8px; align-items:center; }

/* Modern Event Card Design */
/* Events layout */
.events-grid { 
    display: grid; 
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); 
    gap: 26px; 
    margin-top: 26px; 
}

/* Event card – refined spacing, hierarchy and visual polish */
.event-card { 
    background: #ffffff; 
    border: 1px solid rgba(233, 236, 239, 0.9); 
    border-radius: 18px; 
    padding: 22px 22px 20px; 
    box-shadow: var(--shadow-sm); 
    display: flex; 
    flex-direction: column; 
    gap: 14px; 
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease, background-color 0.25s ease; 
    position: relative; 
    overflow: hidden; 
}

.event-card:hover { 
    transform: translateY(-4px); 
    box-shadow: var(--shadow-md); 
    border-color: rgba(0, 123, 255, 0.18); 
    background-color: #fbfdff;
}

.event-card::before { 
    content: ''; 
    position: absolute; 
    top: 0; left: 0; width: 100%; height: 4px; 
    background: linear-gradient(90deg, var(--primary-dark), var(--primary-light)); 
    opacity: 0; 
    transition: opacity 0.3s; 
}

.event-card:hover::before { opacity: 1; }

.event-header { 
    display: flex; 
    justify-content: space-between; 
    align-items: flex-start; 
    gap: 14px; 
}

.event-title { 
    font-size: 1.2rem; 
    font-weight: 700; 
    color: var(--text-dark); 
    margin: 0; 
    line-height: 1.3; 
}

.event-date { 
    display: flex; 
    align-items: center; 
    gap: 6px; 
    font-size: 0.82rem; 
    color: var(--text-muted); 
    background: #f8f9fb; 
    padding: 6px 11px; 
    border-radius: 999px; 
    white-space: nowrap; 
}

.event-description { 
    font-size: 0.95rem; 
    color: var(--text-muted); 
    line-height: 1.5; 
    flex-grow: 1; /* Pushes footer down */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.event-badges { 
    display: flex; 
    flex-wrap: wrap; 
    gap: 8px; 
    margin-top: 4px; 
}

.badge { 
    display: inline-flex; 
    align-items: center; 
    gap: 5px; 
    padding: 4px 10px; 
    border-radius: 999px; 
    font-size: 0.8rem; 
    font-weight: 600; 
}

.badge.priority { background: rgba(255, 193, 7, 0.15); color: #b4890a; }
.badge.status { background: rgba(0, 198, 255, 0.1); color: #009ec3; }
.badge.duration { background: rgba(108, 117, 125, 0.1); color: var(--text-muted); }

/* Footer actions – clearer hierarchy, spacing and responsive layout */
.event-actions { 
    display: flex; 
    align-items: center; 
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 16px;
    margin-top: 20px; 
    padding-top: 16px; 
    border-top: 1px solid var(--border-color); 
}

.event-actions-main,
.event-actions-secondary {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
}

.event-actions-secondary {
    margin-left: auto;
}

.btn-icon { 
    display: inline-flex; 
    align-items: center; 
    justify-content: center; 
    gap: 8px;
    padding: 9px 18px;
    min-height: 40px;
    border-radius: 999px; 
    border: none; 
    font-size: 0.9rem; 
    font-weight: 600;
    cursor: pointer; 
    text-decoration: none;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
    transition: transform 0.2s, box-shadow 0.2s, background 0.2s, color 0.2s;
}

.btn-icon i {
    font-size: 0.9rem;
}

.btn-icon-label {
    font-size: 0.85rem;
    font-weight: 500;
}

.btn-icon.edit { 
    background: linear-gradient(135deg, #e4f0ff, #c7ddff); 
    color: var(--accent-blue); 
}
.btn-icon.edit:hover { 
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(0, 86, 179, 0.25);
}

.btn-icon.delete { 
    background: linear-gradient(135deg, #ffe1e6, #ffb3c0); 
    color: #b3263a; 
}
.btn-icon.delete:hover { 
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(255, 71, 87, 0.25);
}

.btn-motivation { 
    display: inline-flex; 
    align-items: center; 
    justify-content: center;
    gap: 8px; 
    padding: 9px 18px; 
    border-radius: 999px; 
    background: linear-gradient(135deg, var(--primary-dark), var(--primary-light)); 
    color: #fff; 
    font-weight: 600; 
    font-size: 0.9rem; 
    text-decoration: none; 
    box-shadow: 0 4px 10px rgba(0, 51, 102, 0.2); 
    transition: transform 0.2s, box-shadow 0.2s; 
}

.btn-motivation:hover { 
    transform: translateY(-2px); 
    box-shadow: 0 6px 15px rgba(0, 51, 102, 0.3); 
    color: #fff; 
}

.btn-motivation.focus {
    background: linear-gradient(135deg, #ff9f43, #ff6b6b);
}

/* Weekly stats card – API visualisation */
.weekly-stats-card {
    margin-top: 18px;
}

.weekly-stats-header {
    margin-bottom: 10px;
}

.weekly-stats-header h2 {
    margin: 0;
    font-size: 1.1rem;
}

.weekly-stats-subtitle {
    margin: 4px 0 0;
    font-size: 0.9rem;
    color: var(--text-muted);
}

.weekly-stats-body {
    margin-top: 6px;
}

.weekly-stats-layout {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.weekly-stats-empty,
.weekly-stats-loading,
.weekly-stats-error {
    font-size: 0.9rem;
}

.weekly-stats-empty,
.weekly-stats-loading {
    color: var(--text-muted);
}

.weekly-stats-error {
    color: #ff4757;
}

.weekly-stats-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.weekly-stats-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 0;
    font-size: 0.9rem;
    border-bottom: 1px solid rgba(233, 236, 239, 0.8);
}

.weekly-stats-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.weekly-stats-week {
    font-weight: 600;
}

.weekly-stats-range {
    font-size: 0.8rem;
    color: var(--text-muted);
}

.weekly-stats-hours {
    font-weight: 600;
    color: var(--primary-dark);
    margin-bottom: 4px;
    text-align: right;
}

.weekly-stats-bar {
    width: 110px;
    height: 6px;
    border-radius: 999px;
    background: rgba(0, 123, 255, 0.08);
    overflow: hidden;
}

.weekly-stats-bar-fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--primary-dark), var(--primary-light));
    width: 0;
    transition: width 0.4s ease;
}

.weekly-stats-chart {
    min-height: 180px;
}

.weekly-stats-chart canvas {
    width: 100%;
    max-height: 230px;
}

@media (max-width: 768px) {
    .event-card {
        padding: 18px 16px;
        gap: 14px;
    }

    .event-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .event-actions {
        flex-direction: column;
        align-items: stretch;
    }

    .event-actions-main,
    .event-actions-secondary {
        width: 100%;
        justify-content: space-between;
    }

    .event-actions-secondary {
        justify-content: flex-end;
    }

    .btn-motivation {
        flex: 1;
    }
}

@keyframes pulse-highlight {
    0% { transform: scale(1); box-shadow: var(--shadow-sm); border-color: transparent; }
    50% { transform: scale(1.02); box-shadow: 0 4px 20px rgba(0, 198, 255, 0.3); border-color: var(--primary-light); }
    100% { transform: scale(1); box-shadow: var(--shadow-sm); border-color: transparent; }
}

.event-card {
    transition: transform 0.4s ease, box-shadow 0.3s ease, border-color 0.3s ease;
}

.event-card.search-match {
    border: 2px solid var(--primary-light);
    box-shadow: 0 8px 24px rgba(0, 198, 255, 0.15);
    background-color: #fbfdff;
    position: relative;
    z-index: 10;
}
</style>

<div class="time-management-header">
    <div class="row">
        <div>
            <h1>⏰ Time Management</h1>
            <p class="text-muted">Create and manage your events</p>
        </div>
        <div>
            <button id="toggle-event-form" class="form-toggle-btn"><i class="fas fa-calendar-plus"></i> Add Event</button>
        </div>
    </div>
</div>

<!-- Flash Messages -->
{% for message in app.flashes('success') %}
    <div class="alert alert-success" style="margin-bottom:12px; padding:12px; border-radius:8px; background:rgba(76,175,80,0.08); color:#4caf50; border:1px solid rgba(76,175,80,0.2);">
        <i class="fas fa-check-circle"></i> {{ message }}
    </div>
{% endfor %}
{% for message in app.flashes('error') %}
    <div class="alert alert-error" style="margin-bottom:12px; padding:12px; border-radius:8px; background:rgba(255,71,87,0.06); color:#ff4757; border:1px solid rgba(255,71,87,0.12);">
        <i class="fas fa-exclamation-circle"></i> {{ message }}
    </div>
{% endfor %}

{# Create form template (not rendered until Add clicked) #}
<div id="temps-main">
    <template id="event-form-template">
        <div class="form-card" style="margin-bottom:18px;">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            <div class="card-header">
                <div>
                    <h2>Create Event</h2>
                    <p class="lead">Add a new event to your schedule</p>
                </div>
            </div>

            <div class="form-body">
                <div class="form-grid">
                    <div class="form-group">
                        {{ form_label(form.title, 'Title') }}
                        {{ form_widget(form.title, {'attr': {'placeholder':'Event title', 'class':'form-control'}}) }}
                        {% for err in form.title.vars.errors %}
                            <div class="form-error-message">{{ err.message }}</div>
                        {% endfor %}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.date, 'Date') }}
                        {{ form_widget(form.date, {'attr': {'type':'date','class':'form-control'}}) }}
                        {% for err in form.date.vars.errors %}
                            <div class="form-error-message">{{ err.message }}</div>
                        {% endfor %}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.type, 'Type') }}
                        {{ form_widget(form.type, {'attr': {'placeholder':'e.g., Exam', 'class':'form-control'}}) }}
                        {% for err in form.type.vars.errors %}
                            <div class="form-error-message">{{ err.message }}</div>
                        {% endfor %}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.duration, 'Duration (min)') }}
                        {{ form_widget(form.duration, {'attr': {'type':'number','min':1,'max':1440,'class':'form-control'}}) }}
                        {% for err in form.duration.vars.errors %}
                            <div class="form-error-message">{{ err.message }}</div>
                        {% endfor %}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.location, 'Location') }}
                        {{ form_widget(form.location, {'attr': {'placeholder':'e.g., Room 101, Online', 'class':'form-control'}}) }}
                        {% for err in form.location.vars.errors %}
                            <div class="form-error-message">{{ err.message }}</div>
                        {% endfor %}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.difficulty, 'Difficulty (1-5)') }}
                        {{ form_widget(form.difficulty, {'attr': {'type':'number','min':1,'max':5,'class':'form-control'}}) }}
                        {% for err in form.difficulty.vars.errors %}
                            <div class="form-error-message">{{ err.message }}</div>
                        {% endfor %}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.priority, 'Priority') }}
                        {{ form_widget(form.priority, {'attr': {'class':'form-control'}}) }}
                        {% for err in form.priority.vars.errors %}
                            <div class="form-error-message">{{ err.message }}</div>
                        {% endfor %}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.status, 'Status') }}
                        {{ form_widget(form.status, {'attr': {'class':'form-control'}}) }}
                        {% for err in form.status.vars.errors %}
                            <div class="form-error-message">{{ err.message }}</div>
                        {% endfor %}
                    </div>

                    <div class="full">
                        <div class="form-group">
                            {{ form_label(form.description, 'Description') }}
                            {{ form_widget(form.description, {'attr': {'rows':4, 'class':'form-control'}}) }}
                            {% for err in form.description.vars.errors %}
                                <div class="form-error-message">{{ err.message }}</div>
                            {% endfor %}
                        </div>
                    </div>

                </div>

                <aside class="preview">
                    <div class="preview-title">Preview</div>
                    <div class="preview-card">
                        <div class="preview-card-title">New Event</div>
                        <div class="preview-card-meta">—</div>
                        <div class="preview-card-desc">No description yet</div>
                    </div>
                </aside>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Create Event</button>
                <button data-cancel="event-form" type="button" class="btn-secondary">Cancel</button>
            </div>

            {{ form_end(form) }}
        </div>
    </template>

    <div id="event-form-container"></div>

    {# Events list #}
    <div id="events-list">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
        <div style="display:flex; align-items:center; gap:15px;">
            <h2 style="margin:0;">Your Events</h2>
            <div class="sort-controls" style="display:flex; gap:8px;">
                <a href="{{ path('app_temps') }}" class="badge {{ app.request.query.get('sort') != 'priority' ? 'priority' : 'duration' }}" style="text-decoration:none; cursor:pointer; padding:6px 12px; font-size:0.85rem;">
                    <i class="fas fa-calendar"></i> Date
                </a>
                <a href="{{ path('app_temps', {'sort': 'priority'}) }}" class="badge {{ app.request.query.get('sort') == 'priority' ? 'priority' : 'duration' }}" style="text-decoration:none; cursor:pointer; padding:6px 12px; font-size:0.85rem;">
                    <i class="fas fa-layer-group"></i> Priority
                </a>
            </div>
        </div>
        {% if events %}
            <div class="events-count">{{ events|length }} event{{ events|length > 1 ? 's' : '' }}</div>
        {% endif %}
    </div>

    {% if events is empty %}
        <div class="no-events">No events yet. Use "Add Event" to create one.</div>
    {% else %}
        <div class="events-grid">
            {% for event in events %}
                <div class="event-card">
                    <div class="event-header">
                        <h3 class="event-title">{{ event.title }}</h3>
                        {% if event.date %}
                            <div class="event-date">
                                <i class="fas fa-calendar-day"></i> {{ event.date|date('M d, Y') }}
                            </div>
                        {% endif %}
                    </div>

                    <div class="event-description">
                        {{ event.description|default('No description provided.') }}
                    </div>

                    <div class="event-badges">
                        {% if event.duration %}
                            <span class="badge duration"><i class="fas fa-clock"></i> {{ event.duration }}m</span>
                        {% endif %}
                        {% if event.priority %}
                            <span class="badge priority"><i class="fas fa-bolt"></i> {{ event.priority }}</span>
                        {% endif %}
                        {% if event.status %}
                            <span class="badge status"><i class="fas fa-info-circle"></i> {{ event.status }}</span>
                        {% endif %}
                        {% if event.pomodoroSessions|length > 0 %}
                            <div class="pomodoro-summary" style="margin-top:10px;">
                                <details>
                                    <summary style="cursor:pointer; font-size:0.85rem; color:#ff5722; font-weight:600;">
                                        <i class="fas fa-stopwatch"></i> {{ event.pomodoroSessions|length }} Sessions Plan
                                    </summary>
                                    <ul style="list-style:none; padding:10px; margin:5px 0 0; background:#fff5f2; border-radius:8px; font-size:0.8rem;">
                                        {% for session in event.pomodoroSessions %}
                                            <li style="display:flex; justify-content:space-between; margin-bottom:4px; padding-bottom:4px; border-bottom:1px solid rgba(255,87,34,0.1);">
                                                <span>
                                                    {% if session.type == 'WORK' %}🍅 Work{% elseif session.type == 'SHORT_BREAK' %}☕ Short Break{% else %}🛌 Long Break{% endif %}
                                                </span>
                                                <strong>{{ session.duration }}m</strong>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </details>
                            </div>
                        {% endif %}
                    </div>

                    <div class="event-actions">
                        {% if app.user and event.user and event.user.id == app.user.id %}
                            <div class="event-actions-main">
                                <a href="{{ path('app_motivation_panel', {id: event.id}) }}" class="btn-motivation">
                                    <i class="fas fa-lightbulb"></i>
                                    <span>Motivation</span>
                                </a>
                                <a href="{{ path('app_event_pomodoro', {id: event.id}) }}" class="btn-motivation focus">
                                    <i class="fas fa-stopwatch"></i>
                                    <span>Focus</span>
                                </a>
                            </div>

                            <div class="event-actions-secondary">
                                <a href="{{ path('app_temps_edit', {id: event.id}) }}" class="btn-icon edit" title="Edit Event" aria-label="Edit Event">
                                    <i class="fas fa-pen"></i>
                                </a>
                                <form method="POST" action="{{ path('app_temps_delete', {id: event.id}) }}" style="margin:0;" onsubmit="return confirm('Delete this event?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                                    <button type="submit" class="btn-icon delete" title="Delete Event" aria-label="Delete Event">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            </div>
                        {% else %}
                            <div style="width:100%; text-align:center; color:var(--text-muted); font-size:0.9rem;">
                                <i class="fas fa-lock"></i> Read Only
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
    </div>

    {# Weekly time statistics (API-backed) #}
    <div class="form-card weekly-stats-card">
        <div class="card-header weekly-stats-header">
            <div>
                <h2>Weekly Time Overview</h2>
                <p class="lead weekly-stats-subtitle">Total hours worked per week, based on your events.</p>
            </div>
        </div>
        <div class="weekly-stats-layout">
            <div id="weekly-time-stats" class="weekly-stats-body"></div>
            <div class="weekly-stats-chart">
                <canvas id="weekly-time-chart"></canvas>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
// Dynamic form injection, toggle behavior, client validation and live preview
(function(){
    document.addEventListener('DOMContentLoaded', function(){
        var toggle = document.getElementById('toggle-event-form');
        var template = document.getElementById('event-form-template');
        var container = document.getElementById('event-form-container');
        var tempsMain = document.getElementById('temps-main');

        function setMinDateIn(root){
            var d = new Date();
            var iso = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
            (root || document).querySelectorAll('input[type="date"]').forEach(function(i){ i.setAttribute('min', iso); });
        }

        function bindFormHandlers(card){
            if(!card) return;
            setMinDateIn(card);

            var cancel = card.querySelector('[data-cancel="event-form"]');
            if(cancel) cancel.addEventListener('click', function(){
                container.innerHTML = '';
                if(tempsMain) tempsMain.classList.remove('expanded');
                if(toggle) toggle.innerHTML = '<i class="fas fa-calendar-plus"></i> Add Event';
            });

            var form = card.querySelector('form');
            if(form){
                form.addEventListener('submit', function(e){
                    // inline client validation
                    var ok = true;
                    var title = form.querySelector('input[name$="[title]"]');
                    var date = form.querySelector('input[name$="[date]"]');
                    var priority = form.querySelector('select[name$="[priority]"]');
                    var status = form.querySelector('select[name$="[status]"]');
                    function clearErrors(){ form.querySelectorAll('.form-error-message.js-client').forEach(function(el){ el.remove(); }); form.querySelectorAll('.has-error').forEach(function(el){ el.classList.remove('has-error'); }); }
                    function showError(input, msg){ var containerDiv = input.closest('div') || input.parentNode; containerDiv.classList.add('has-error'); var m = document.createElement('div'); m.className = 'form-error-message js-client'; m.innerHTML = '<i class="fas fa-exclamation-circle"></i> ' + msg; containerDiv.appendChild(m); }
                    clearErrors();
                    if(!title || !title.value.trim()){ showError(title || form, 'Title is required'); ok = false; }
                    if(!date || !date.value){ showError(date || form, 'Date is required'); ok = false; }
                    if(!priority || !priority.value){ showError(priority || form, 'Priority is required'); ok = false; }
                    if(!status || !status.value){ showError(status || form, 'Status is required'); ok = false; }
                    if(!ok){ e.preventDefault(); return false; }
                    return true;
                });
            }

            // live preview
            var titleIn = card.querySelector('input[name$="[title]"]');
            var dateIn = card.querySelector('input[name$="[date]"]');
            var typeIn = card.querySelector('input[name$="[type]"]');
            var descIn = card.querySelector('textarea[name$="[description]"]');
            var previewTitle = card.querySelector('.preview-card-title');
            var previewMeta = card.querySelector('.preview-card-meta');
            var previewDesc = card.querySelector('.preview-card-desc');
            function update(){
                if(previewTitle) previewTitle.textContent = (titleIn && titleIn.value.trim()) ? titleIn.value.trim() : 'New Event';
                var parts = [];
                if(dateIn && dateIn.value) parts.push(new Date(dateIn.value).toLocaleDateString());
                if(typeIn && typeIn.value.trim()) parts.push(typeIn.value.trim());
                if(previewMeta) previewMeta.textContent = parts.length ? parts.join(' • ') : '—';
                if(previewDesc) previewDesc.textContent = (descIn && descIn.value.trim()) ? descIn.value.trim() : 'No description yet';
            }
            [titleIn, dateIn, typeIn, descIn].forEach(function(el){ if(el) el.addEventListener('input', update); });
            update();
        }

        // initial state: ensure container empty and events visible
        if(container) container.innerHTML = '';
        if(tempsMain) tempsMain.classList.remove('expanded');
        if(toggle) toggle.innerHTML = '<i class="fas fa-calendar-plus"></i> Add Event';

        if(!toggle || !template || !container) return;

        toggle.addEventListener('click', function(){
                    if(container.children.length === 0){
                        // insert form from template (compact vertical variant)
                        var clone = document.importNode(template.content, true);
                        container.appendChild(clone);
                        var card = container.querySelector('.form-card');
                        // compact style: don't expand parent grid, show single-column form
                        if(card) card.classList.add('compact');
                        if(toggle) toggle.innerHTML = '<i class="fas fa-times"></i> Close';
                        // bind handlers for the newly-inserted form
                        bindFormHandlers(card);
                    } else {
                        // remove form
                        container.innerHTML = '';
                        if(tempsMain) tempsMain.classList.remove('expanded');
                        if(toggle) toggle.innerHTML = '<i class="fas fa-calendar-plus"></i> Add Event';
                    }
        });

    });
})();
</script>


<script>
// Load weekly time statistics from the REST API and render them on the Time Management page
(function () {
    document.addEventListener('DOMContentLoaded', function () {
        var container = document.getElementById('weekly-time-stats');
        var chartCanvas = document.getElementById('weekly-time-chart');
        if (!container) {
            return;
        }

        function renderEmpty() {
            container.innerHTML = '<div class="weekly-stats-empty">No time data yet. Create events with a duration to see weekly stats.</div>';
        }

        function formatDateLabel(iso) {
            if (!iso) {
                return '';
            }
            // Expecting "YYYY-MM-DD" from API
            var parts = String(iso).split('-');
            if (parts.length !== 3) {
                return iso;
            }
            var year = parts[0];
            var monthIndex = parseInt(parts[1], 10) - 1;
            var day = parts[2];

            var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
            var monthLabel = months[monthIndex] || parts[1];

            // Example: "07 Dec 2026"
            return day + ' ' + monthLabel + ' ' + year;
        }

        container.innerHTML = '<div class="weekly-stats-loading">Loading weekly stats...</div>';

        fetch('/api/events/stats', {
            headers: {
                'Accept': 'application/json'
            },
            credentials: 'same-origin'
        })
            .then(function (response) {
                if (!response.ok) {
                    throw new Error('HTTP ' + response.status);
                }
                return response.json();
            })
            .then(function (payload) {
                var data = payload && payload.data ? payload.data : [];
                if (!data.length) {
                    renderEmpty();
                    return;
                }

                var maxHours = 0;
                data.forEach(function (item) {
                    var h = parseFloat(item.totalHours) || 0;
                    if (h > maxHours) {
                        maxHours = h;
                    }
                });

                var list = document.createElement('div');
                list.className = 'weekly-stats-list';

                data.forEach(function (item) {
                    var row = document.createElement('div');
                    row.className = 'weekly-stats-row';

                    var info = document.createElement('div');
                    info.className = 'weekly-stats-info';

                    var weekLabel = document.createElement('span');
                    weekLabel.className = 'weekly-stats-week';
                    weekLabel.textContent = item.week || '';

                    var dateRange = document.createElement('span');
                    dateRange.className = 'weekly-stats-range';
                    dateRange.textContent = formatDateLabel(item.startDate) + ' → ' + formatDateLabel(item.endDate);

                    info.appendChild(weekLabel);
                    info.appendChild(dateRange);

                    var right = document.createElement('div');
                    right.style.display = 'flex';
                    right.style.flexDirection = 'column';
                    right.style.alignItems = 'flex-end';

                    var hours = parseFloat(item.totalHours) || 0;
                    var hoursLabel = document.createElement('span');
                    hoursLabel.className = 'weekly-stats-hours';
                    hoursLabel.textContent = (Math.round(hours * 10) / 10) + ' h';

                    var bar = document.createElement('div');
                    bar.className = 'weekly-stats-bar';
                    var barFill = document.createElement('div');
                    barFill.className = 'weekly-stats-bar-fill';
                    var percent = maxHours > 0 ? (hours / maxHours) * 100 : 0;
                    barFill.style.width = percent + '%';
                    bar.appendChild(barFill);

                    right.appendChild(hoursLabel);
                    right.appendChild(bar);

                    row.appendChild(info);
                    row.appendChild(right);
                    list.appendChild(row);
                });

                container.innerHTML = '';
                container.appendChild(list);

                // Build chart if Chart.js is available and canvas is present
                if (chartCanvas && typeof Chart !== 'undefined') {
                    var ctx = chartCanvas.getContext('2d');
                    if (chartCanvas._chartInstance) {
                        chartCanvas._chartInstance.destroy();
                    }

                    var labels = data.map(function (item) { return item.week; });
                    var hoursData = data.map(function (item) {
                        return parseFloat(item.totalHours) || 0;
                    });

                    var gradient = ctx.createLinearGradient(0, 0, 0, 220);
                    gradient.addColorStop(0, 'rgba(0, 198, 255, 0.9)');
                    gradient.addColorStop(1, 'rgba(0, 51, 102, 0.2)');

                    chartCanvas._chartInstance = new Chart(ctx, {
                        type: 'bar',
                        data: {
                            labels: labels,
                            datasets: [{
                                label: 'Hours per week',
                                data: hoursData,
                                backgroundColor: gradient,
                                borderRadius: 8,
                                borderWidth: 0,
                                barPercentage: 0.6,
                                categoryPercentage: 0.6
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    display: false
                                },
                                tooltip: {
                                    callbacks: {
                                        label: function (ctx) {
                                            return (ctx.parsed.y || 0) + ' h';
                                        }
                                    }
                                }
                            },
                            scales: {
                                x: {
                                    ticks: {
                                        font: {
                                            size: 11
                                        }
                                    },
                                    grid: {
                                        display: false
                                    }
                                },
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        stepSize: 1,
                                        font: {
                                            size: 11
                                        }
                                    },
                                    grid: {
                                        color: 'rgba(230, 236, 241, 0.8)'
                                    }
                                }
                            }
                        }
                    });
                }
            })
            .catch(function () {
                container.innerHTML = '<div class="weekly-stats-error">Unable to load weekly stats right now.</div>';
            });
    });
})();
</script>



<script>
// Ensure edit links and delete buttons work even if CSS overlays interfere
(function(){
    document.addEventListener('DOMContentLoaded', function(){
        // edit buttons: navigate to href explicitly
        document.querySelectorAll('.event-action.btn-edit').forEach(function(btn){
            btn.addEventListener('click', function(e){
                var href = btn.getAttribute('href');
                if(href){
                    // allow default for normal clicks, but force navigation if something blocks it
                    window.location.href = href;
                    e.preventDefault();
                }
            });
        });

        // delete buttons: ensure form submission works programmatically
        document.querySelectorAll('.event-action.btn-delete').forEach(function(btn){
            btn.addEventListener('click', function(e){
                // if button is inside a form, submit that form
                var form = btn.closest('form');
                if(!form){
                    // try to find a form sibling
                    form = btn.parentElement.querySelector('form');
                }
                if(form){
                    e.preventDefault();
                    if(confirm('Delete this event?')){
                        form.submit();
                    }
                }
            });
        });
    });
})();
</script>

<script>
// Search highlighting with FLIP animation for smooth reordering
(function() {
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('event-search-input');
        if (!searchInput) return;

        const container = document.querySelector('.events-grid');
        // We'll query cards dynamically inside the input event or update the list if cards are added/removed.
        // For now, assuming static list after load.
        let cards = Array.from(document.querySelectorAll('.event-card'));
        
        let debounceTimer;

        searchInput.addEventListener('input', function(e) {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                const term = e.target.value.toLowerCase().trim();
                
                // Refresh list in case DOM changed
                cards = Array.from(document.querySelectorAll('.event-card'));

                // 1. First: Record initial positions
                const firstRects = new Map();
                cards.forEach(card => {
                    firstRects.set(card, card.getBoundingClientRect());
                });

                // 2. Identify best match
                let bestCard = null;
                let maxScore = 0;

                if (term.length > 0) {
                    cards.forEach(card => {
                        const title = card.querySelector('.event-title') ? card.querySelector('.event-title').textContent.toLowerCase() : '';
                        const desc = card.querySelector('.event-description') ? card.querySelector('.event-description').textContent.toLowerCase() : '';
                        
                        let score = 0;
                        if (title.startsWith(term)) score = 100;
                        else if (title.includes(term)) score = 50;
                        else if (desc.includes(term)) score = 10;
                        
                        // We strictly want only one, so we pick the first highest score we see, 
                        // or we could collect all and sort, but first-highest is usually fine for "best match".
                        // Logic: Update if strictly greater to keep first occurrence of high score,
                        // or update if >= to get last. Let's keep first occurrence of best score.
                        if (score > maxScore) {
                            maxScore = score;
                            bestCard = card;
                        }
                    });
                }

                // 3. Apply state changes
                cards.forEach(card => {
                    if (card === bestCard) {
                        card.classList.add('search-match');
                        card.style.order = "-1"; // Move to top
                    } else {
                        card.classList.remove('search-match');
                        card.style.order = "0"; // Reset order
                    }
                });

                // 4. Last: Record final positions
                const lastRects = new Map();
                cards.forEach(card => {
                    lastRects.set(card, card.getBoundingClientRect());
                });

                // 5. Invert: Calculate delta and apply transform
                cards.forEach(card => {
                    const first = firstRects.get(card);
                    const last = lastRects.get(card);
                    
                    if (!first || !last) return;

                    const deltaX = first.left - last.left;
                    const deltaY = first.top - last.top;

                    // Only animate if position changed significantly
                    if (Math.abs(deltaX) > 0.5 || Math.abs(deltaY) > 0.5) {
                        card.style.transition = 'none';
                        card.style.transform = `translate(${deltaX}px, ${deltaY}px)`;
                    }
                });

                // Force reflow
                document.body.offsetHeight; 

                // 6. Play: Remove transform to animate to final position
                cards.forEach(card => {
                    if (card.style.transform && card.style.transform !== '') {
                        card.style.transition = 'transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1)';
                        card.style.transform = '';
                    }
                });

            }, 50); // Debounce delay
        });
    });
})();
</script>

