{% extends 'front/base.html.twig' %}

{% block title %}Time Management - Student Hub{% endblock %}

{% block content %}
<style>
/* Time management form design — cleaner grid, spacing and responsive layout */
.time-management-header { margin-bottom: 18px; }
.time-management-header h1 { font-size: 1.8rem; color: #1a1a1a; }
.row { display:flex; gap:12px; align-items:center; justify-content:space-between; }

/* Add Event toggle button */
.form-toggle-btn { display:inline-flex; align-items:center; gap:8px; padding:10px 14px; border-radius:10px; background:linear-gradient(90deg,var(--primary-dark),var(--primary-light)); color:#fff; border:none; cursor:pointer; font-weight:700; box-shadow:0 8px 22px rgba(0,51,102,0.08); transition:transform .12s ease, box-shadow .12s ease, opacity .12s; }
.form-toggle-btn i { font-size:1rem; }
.form-toggle-btn:hover { transform:translateY(-2px); box-shadow:0 12px 30px rgba(0,51,102,0.12); }
.form-toggle-btn:active { transform:translateY(0); }
.form-toggle-btn:focus { outline:3px solid rgba(0,51,102,0.12); outline-offset:2px; }
.form-toggle-btn.open { background:linear-gradient(90deg,var(--primary-light),var(--primary-dark)); }
@media (max-width:700px){ .form-toggle-btn { width:100%; justify-content:center; } }

.form-card { background:#fff; border:1px solid var(--border-color); border-radius:12px; padding:18px; box-shadow:var(--shadow-sm); max-width:1100px; margin:0 auto 16px; }
.form-card.hidden { display:none; }
.form-card .card-header { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:12px; }
.form-card h2 { margin:0; font-size:1.2rem; color:var(--text-dark); }
.form-card p.lead { margin:4px 0 0; color:var(--text-muted); font-size:0.95rem; }

.form-grid { display:grid; grid-template-columns: 1fr 1fr; gap:12px 18px; align-items:start; }
.form-grid .full { grid-column:1 / -1; }
.form-group { display:flex; flex-direction:column; gap:6px; margin-bottom:8px; }
.form-group label { font-weight:600; color:var(--text-dark); font-size:0.94rem; }
.form-control { padding:10px 12px; border-radius:10px; border:1px solid var(--border-color); background:#fff; font-size:0.95rem; }
.form-control:focus { outline:none; border-color:var(--primary-dark); box-shadow:0 6px 18px rgba(0,51,102,0.06); }

.form-actions { display:flex; gap:12px; justify-content:flex-end; margin-top:8px; }
.btn-primary { padding:10px 16px; border-radius:10px; background:linear-gradient(135deg,var(--primary-dark),var(--primary-light)); color:#fff; border:none; font-weight:700; }
.btn-secondary { padding:10px 14px; border-radius:10px; border:1px solid var(--border-color); background:transparent; color:var(--primary-dark); }

/* Compact variant: single-column, tighter spacing, preview hidden */
.form-card.compact { max-width:760px; margin:0 auto 16px; }
.form-card.compact .form-body { display:block; }
.form-card.compact .form-grid { grid-template-columns: 1fr; gap:8px; }
.form-card.compact .full { grid-column: 1 / -1; }
.form-card.compact .preview { display:none; }
.form-card.compact .form-actions { justify-content:flex-end; }
.form-card.compact .btn-primary { min-width:160px; }

.form-error-message { color:#ff4757; font-size:0.85rem; margin-top:6px; display:flex; gap:8px; align-items:center; }

.events-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:18px; margin-top:18px; }
.event-card { background:#fff; border:1px solid var(--border-color); border-radius:12px; padding:18px; box-shadow:var(--shadow-sm); display:flex; flex-direction:column; gap:12px; }
.event-actions { display:flex; gap:8px; margin-top:auto; }
.event-action { padding:8px 10px; border-radius:8px; text-decoration:none; text-align:center; font-weight:600; }
.btn-edit { background:rgba(0,51,102,0.06); color:var(--primary-dark); border:1px solid var(--border-color); }
.btn-delete { background:rgba(255,71,87,0.06); color:#ff4757; border:1px solid transparent; }

/* Hierarchy: make labels slightly bolder, primary inputs subtle, and group headings clear */
.form-card .section-title { font-size:0.98rem; font-weight:700; color:var(--primary-dark); margin-bottom:10px; }

@media (max-width:900px) {
    .form-grid { grid-template-columns: 1fr; gap:10px; }
    .row { flex-direction:column; align-items:stretch; }
    .form-card { padding:14px; }
}

/* Horizontal layout when Add Event is opened: form left, preview right */
.form-body { display:block; }
.form-card.horizontal .form-body { display:flex; gap:20px; align-items:flex-start; }
.form-card.horizontal .form-grid { flex:1; min-width:0; }
.preview { width:320px; border-left:1px solid var(--border-color); padding-left:16px; }
.preview .preview-title { font-weight:700; margin:0 0 8px 0; }
.preview .preview-card { background:linear-gradient(180deg,#fff,#fbfbfb); border-radius:10px; padding:12px; box-shadow:var(--shadow-xs); }
.preview .preview-card-title { font-weight:700; font-size:1rem; margin-bottom:6px; }
.preview .preview-card-meta { font-size:0.9rem; color:var(--text-muted); margin-bottom:8px; }
.preview .preview-card-desc { font-size:0.9rem; color:var(--text-muted); }

@media (max-width:900px) {
    .form-card.horizontal { flex-direction:column; }
    .preview { width:100%; border-left:none; padding-left:0; margin-top:12px; }
    .form-body { display:block; }
}

/* Parent container expanded state: push events list to the right */
#temps-main { display:block; }
#temps-main.expanded { display:grid; grid-template-columns: 1fr 420px; gap:20px; align-items:start; }

@media (max-width:900px) {
    #temps-main.expanded { display:block; }
}

</style>

<div class="time-management-header">
    <div class="row">
        <div>
            <h1>⏰ Time Management</h1>
            <p class="text-muted">Create and manage your events</p>
        </div>
        <div>
            <button id="toggle-event-form" class="form-toggle-btn"><i class="fas fa-calendar-plus"></i> Add Event</button>
        </div>
    </div>
</div>

<!-- Flash Messages -->
{% for message in app.flashes('success') %}
    <div class="alert alert-success" style="margin-bottom:12px; padding:12px; border-radius:8px; background:rgba(76,175,80,0.08); color:#4caf50; border:1px solid rgba(76,175,80,0.2);">
        <i class="fas fa-check-circle"></i> {{ message }}
    </div>
{% endfor %}
{% for message in app.flashes('error') %}
    <div class="alert alert-error" style="margin-bottom:12px; padding:12px; border-radius:8px; background:rgba(255,71,87,0.06); color:#ff4757; border:1px solid rgba(255,71,87,0.12);">
        <i class="fas fa-exclamation-circle"></i> {{ message }}
    </div>
{% endfor %}

{# Create form template (not rendered until Add clicked) #}
<div id="temps-main">
    <template id="event-form-template">
        <div class="form-card" style="margin-bottom:18px;">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            <div class="card-header">
                <div>
                    <h2>Create Event</h2>
                    <p class="lead">Add a new event to your schedule</p>
                </div>
            </div>

            <div class="form-body">
                <div class="form-grid">
                    <div class="form-group">
                        {{ form_label(form.title, 'Title') }}
                        {{ form_widget(form.title, {'attr': {'placeholder':'Event title', 'class':'form-control'}}) }}
                        {% for err in form.title.vars.errors %}
                            <div class="form-error-message">{{ err.message }}</div>
                        {% endfor %}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.date, 'Date') }}
                        {{ form_widget(form.date, {'attr': {'type':'date','class':'form-control'}}) }}
                        {% for err in form.date.vars.errors %}
                            <div class="form-error-message">{{ err.message }}</div>
                        {% endfor %}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.type, 'Type') }}
                        {{ form_widget(form.type, {'attr': {'placeholder':'e.g., Exam', 'class':'form-control'}}) }}
                        {% for err in form.type.vars.errors %}
                            <div class="form-error-message">{{ err.message }}</div>
                        {% endfor %}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.duration, 'Duration (min)') }}
                        {{ form_widget(form.duration, {'attr': {'type':'number','min':1,'max':1440,'class':'form-control'}}) }}
                        {% for err in form.duration.vars.errors %}
                            <div class="form-error-message">{{ err.message }}</div>
                        {% endfor %}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.location, 'Location') }}
                        {{ form_widget(form.location, {'attr': {'placeholder':'e.g., Room 101, Online', 'class':'form-control'}}) }}
                        {% for err in form.location.vars.errors %}
                            <div class="form-error-message">{{ err.message }}</div>
                        {% endfor %}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.difficulty, 'Difficulty (1-5)') }}
                        {{ form_widget(form.difficulty, {'attr': {'type':'number','min':1,'max':5,'class':'form-control'}}) }}
                        {% for err in form.difficulty.vars.errors %}
                            <div class="form-error-message">{{ err.message }}</div>
                        {% endfor %}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.priority, 'Priority') }}
                        {{ form_widget(form.priority, {'attr': {'class':'form-control'}}) }}
                        {% for err in form.priority.vars.errors %}
                            <div class="form-error-message">{{ err.message }}</div>
                        {% endfor %}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.status, 'Status') }}
                        {{ form_widget(form.status, {'attr': {'class':'form-control'}}) }}
                        {% for err in form.status.vars.errors %}
                            <div class="form-error-message">{{ err.message }}</div>
                        {% endfor %}
                    </div>

                    <div class="full">
                        <div class="form-group">
                            {{ form_label(form.description, 'Description') }}
                            {{ form_widget(form.description, {'attr': {'rows':4, 'class':'form-control'}}) }}
                            {% for err in form.description.vars.errors %}
                                <div class="form-error-message">{{ err.message }}</div>
                            {% endfor %}
                        </div>
                    </div>

                </div>

                <aside class="preview">
                    <div class="preview-title">Preview</div>
                    <div class="preview-card">
                        <div class="preview-card-title">New Event</div>
                        <div class="preview-card-meta">—</div>
                        <div class="preview-card-desc">No description yet</div>
                    </div>
                </aside>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Create Event</button>
                <button data-cancel="event-form" type="button" class="btn-secondary">Cancel</button>
            </div>

            {{ form_end(form) }}
        </div>
    </template>

    <div id="event-form-container"></div>

    {# Events list #}
    <div id="events-list">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
        <h2 style="margin:0;">Your Events</h2>
        {% if events %}
            <div class="events-count">{{ events|length }} event{{ events|length > 1 ? 's' : '' }}</div>
        {% endif %}
    </div>

    {% if events is empty %}
        <div class="no-events">No events yet. Use "Add Event" to create one.</div>
    {% else %}
        <div class="events-grid">
            {% for event in events %}
                <div class="event-card">
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:8px;">
                        <div style="font-weight:700;">{{ event.title }}</div>
                        <div style="font-size:0.85rem; color:var(--text-muted);">{{ event.date ? event.date|date('M d, Y') }}</div>
                    </div>

                    <div style="color:var(--text-muted);">{{ event.description|default('No description') }}</div>

                    <div class="event-details" style="display:flex; gap:8px; flex-wrap:wrap; color:var(--text-muted);">
                        {% if event.duration %}<div><i class="fas fa-hourglass-end"></i> {{ event.duration }}m</div>{% endif %}
                        {% if event.priority %}<div><i class="fas fa-bolt"></i> {{ event.priority }}</div>{% endif %}
                        {% if event.status %}<div><i class="fas fa-info-circle"></i> {{ event.status }}</div>{% endif %}
                    </div>

                    <div class="event-actions">
                        {% if app.user and event.user and event.user.id == app.user.id %}
                            <a href="{{ path('app_temps_edit', {id: event.id}) }}" class="event-action btn-edit"> <i class="fas fa-edit"></i> Edit</a>
                            <form method="POST" action="{{ path('app_temps_delete', {id: event.id}) }}" style="flex:1; margin:0;" onsubmit="return confirm('Delete this event?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                                <button type="submit" class="event-action btn-delete"> <i class="fas fa-trash"></i> Delete</button>
                            </form>
                            <button data-motivation-event="{{ event.id }}" class="event-action btn-primary" style="margin-left:8px; background:linear-gradient(90deg,#2d9cdb,#20c0ff);"> <i class="fas fa-lightbulb"></i> Motivation</button>
                        {% else %}
                            <div style="color:var(--text-muted); font-size:0.9rem;">Not editable</div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
    </div>
</div>

<script>
// Dynamic form injection, toggle behavior, client validation and live preview
(function(){
    document.addEventListener('DOMContentLoaded', function(){
        var toggle = document.getElementById('toggle-event-form');
        var template = document.getElementById('event-form-template');
        var container = document.getElementById('event-form-container');
        var tempsMain = document.getElementById('temps-main');

        function setMinDateIn(root){
            var d = new Date();
            var iso = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
            (root || document).querySelectorAll('input[type="date"]').forEach(function(i){ i.setAttribute('min', iso); });
        }

        function bindFormHandlers(card){
            if(!card) return;
            setMinDateIn(card);

            var cancel = card.querySelector('[data-cancel="event-form"]');
            if(cancel) cancel.addEventListener('click', function(){
                container.innerHTML = '';
                if(tempsMain) tempsMain.classList.remove('expanded');
                if(toggle) toggle.innerHTML = '<i class="fas fa-calendar-plus"></i> Add Event';
            });

            var form = card.querySelector('form');
            if(form){
                form.addEventListener('submit', function(e){
                    // inline client validation
                    var ok = true;
                    var title = form.querySelector('input[name$="[title]"]');
                    var date = form.querySelector('input[name$="[date]"]');
                    var priority = form.querySelector('select[name$="[priority]"]');
                    var status = form.querySelector('select[name$="[status]"]');
                    function clearErrors(){ form.querySelectorAll('.form-error-message.js-client').forEach(function(el){ el.remove(); }); form.querySelectorAll('.has-error').forEach(function(el){ el.classList.remove('has-error'); }); }
                    function showError(input, msg){ var containerDiv = input.closest('div') || input.parentNode; containerDiv.classList.add('has-error'); var m = document.createElement('div'); m.className = 'form-error-message js-client'; m.innerHTML = '<i class="fas fa-exclamation-circle"></i> ' + msg; containerDiv.appendChild(m); }
                    clearErrors();
                    if(!title || !title.value.trim()){ showError(title || form, 'Title is required'); ok = false; }
                    if(!date || !date.value){ showError(date || form, 'Date is required'); ok = false; }
                    if(!priority || !priority.value){ showError(priority || form, 'Priority is required'); ok = false; }
                    if(!status || !status.value){ showError(status || form, 'Status is required'); ok = false; }
                    if(!ok){ e.preventDefault(); return false; }
                    return true;
                });
            }

            // live preview
            var titleIn = card.querySelector('input[name$="[title]"]');
            var dateIn = card.querySelector('input[name$="[date]"]');
            var typeIn = card.querySelector('input[name$="[type]"]');
            var descIn = card.querySelector('textarea[name$="[description]"]');
            var previewTitle = card.querySelector('.preview-card-title');
            var previewMeta = card.querySelector('.preview-card-meta');
            var previewDesc = card.querySelector('.preview-card-desc');
            function update(){
                if(previewTitle) previewTitle.textContent = (titleIn && titleIn.value.trim()) ? titleIn.value.trim() : 'New Event';
                var parts = [];
                if(dateIn && dateIn.value) parts.push(new Date(dateIn.value).toLocaleDateString());
                if(typeIn && typeIn.value.trim()) parts.push(typeIn.value.trim());
                if(previewMeta) previewMeta.textContent = parts.length ? parts.join(' • ') : '—';
                if(previewDesc) previewDesc.textContent = (descIn && descIn.value.trim()) ? descIn.value.trim() : 'No description yet';
            }
            [titleIn, dateIn, typeIn, descIn].forEach(function(el){ if(el) el.addEventListener('input', update); });
            update();
        }

        // initial state: ensure container empty and events visible
        if(container) container.innerHTML = '';
        if(tempsMain) tempsMain.classList.remove('expanded');
        if(toggle) toggle.innerHTML = '<i class="fas fa-calendar-plus"></i> Add Event';

        if(!toggle || !template || !container) return;

        toggle.addEventListener('click', function(){
                    if(container.children.length === 0){
                        // insert form from template (compact vertical variant)
                        var clone = document.importNode(template.content, true);
                        container.appendChild(clone);
                        var card = container.querySelector('.form-card');
                        // compact style: don't expand parent grid, show single-column form
                        if(card) card.classList.add('compact');
                        if(toggle) toggle.innerHTML = '<i class="fas fa-times"></i> Close';
                        // bind handlers for the newly-inserted form
                        bindFormHandlers(card);
                    } else {
                        // remove form
                        container.innerHTML = '';
                        if(tempsMain) tempsMain.classList.remove('expanded');
                        if(toggle) toggle.innerHTML = '<i class="fas fa-calendar-plus"></i> Add Event';
                    }
        });

    });
})();
</script>

<script>
// Motivation button: delegate clicks, load motivation panel and inject into the right column
(function(){
    document.addEventListener('DOMContentLoaded', function(){
        var container = document.getElementById('event-form-container');
        var tempsMain = document.getElementById('temps-main');

        function showError(msg){ console.error(msg); alert(msg); }

        function loadPanel(eventId, triggerBtn){
            if(triggerBtn) triggerBtn.disabled = true;
            fetch('/temps/' + eventId + '/motivations', {headers:{'X-Requested-With':'XMLHttpRequest'}})
                .then(function(r){ if(!r.ok) throw new Error('Fetch failed ' + r.status); return r.text(); })
                .then(function(html){
                    if(container) container.innerHTML = html;
                    if(tempsMain) tempsMain.classList.add('expanded');
                    bindPanelActions(container, eventId);
                })
                .catch(function(err){
                    console.error('Failed to load motivation panel', err);
                    showError('Impossible de charger le panneau Motivation.');
                })
                .finally(function(){ if(triggerBtn) triggerBtn.disabled = false; });
        }

        function bindPanelActions(containerEl, eventId){
            if(!containerEl) return;
            // close
            var close = containerEl.querySelector('[data-close-motivation]');
            if(close) close.addEventListener('click', function(){ containerEl.innerHTML=''; if(tempsMain) tempsMain.classList.remove('expanded'); });

            // delete
            containerEl.querySelectorAll('[data-delete-motivation]').forEach(function(del){
                del.addEventListener('click', function(){
                    if(!confirm('Delete motivation?')) return;
                    var token = del.getAttribute('data-csrf') || '';
                    fetch('/temps/' + eventId + '/motivations/delete', {method:'POST', headers:{'X-Requested-With':'XMLHttpRequest','Content-Type':'application/json'}, body: JSON.stringify({'_token': token})})
                        .then(function(r){ if(!r.ok) throw new Error('Delete failed ' + r.status); return r.json(); })
                        .then(function(json){ if(json.success){ containerEl.innerHTML=''; if(tempsMain) tempsMain.classList.remove('expanded'); } else { showError('Delete failed'); } })
                        .catch(function(e){ console.error(e); showError('Suppression impossible.'); });
                });
            });

            // save form via AJAX
            var form = containerEl.querySelector('form.motivation-form');
            if(form){
                form.addEventListener('submit', function(e){
                    e.preventDefault();
                    var btn = form.querySelector('button[type="submit"]');
                    if(btn) btn.disabled = true;
                    var data = new FormData(form);
                    fetch(form.getAttribute('action') || ('/temps/' + eventId + '/motivations/save'), {method:'POST', body:data, headers:{'X-Requested-With':'XMLHttpRequest'}})
                        .then(function(r){ if(!r.ok) throw new Error('Save failed ' + r.status); return r.text(); })
                        .then(function(html){ if(containerEl) containerEl.innerHTML = html; bindPanelActions(containerEl, eventId); })
                        .catch(function(err){ console.error('Save failed', err); showError('Impossible de sauvegarder.'); })
                        .finally(function(){ if(btn) btn.disabled = false; });
                });
            }
        }

        // Delegate clicks on motivation buttons anywhere in the document
        document.body.addEventListener('click', function(e){
            var btn = e.target.closest('[data-motivation-event]');
            if(!btn) return;
            e.preventDefault();
            var id = btn.getAttribute('data-motivation-event');
            if(!id) return;
            loadPanel(id, btn);
        });
    });
})();
</script>

<script>
// Ensure edit links and delete buttons work even if CSS overlays interfere
(function(){
    document.addEventListener('DOMContentLoaded', function(){
        // edit buttons: navigate to href explicitly
        document.querySelectorAll('.event-action.btn-edit').forEach(function(btn){
            btn.addEventListener('click', function(e){
                var href = btn.getAttribute('href');
                if(href){
                    // allow default for normal clicks, but force navigation if something blocks it
                    window.location.href = href;
                    e.preventDefault();
                }
            });
        });

        // delete buttons: ensure form submission works programmatically
        document.querySelectorAll('.event-action.btn-delete').forEach(function(btn){
            btn.addEventListener('click', function(e){
                // if button is inside a form, submit that form
                var form = btn.closest('form');
                if(!form){
                    // try to find a form sibling
                    form = btn.parentElement.querySelector('form');
                }
                if(form){
                    e.preventDefault();
                    if(confirm('Delete this event?')){
                        form.submit();
                    }
                }
            });
        });
    });
})();
</script>

{% endblock %}
