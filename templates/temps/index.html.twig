{% extends 'front/base.html.twig' %}

{% block title %}Time Management - Student Hub{% endblock %}

{% block content %}
<style>
/* Time management form design — cleaner grid, spacing and responsive layout */
.time-management-header { margin-bottom: 18px; }
.time-management-header h1 { font-size: 1.8rem; color: #1a1a1a; }
.row { display:flex; gap:12px; align-items:center; justify-content:space-between; }

/* Add Event toggle button */
.form-toggle-btn { display:inline-flex; align-items:center; gap:10px; padding:12px 20px; border-radius:999px; background:linear-gradient(90deg,var(--primary-dark),var(--primary-light)); color:#fff; border:none; cursor:pointer; font-weight:700; font-size:0.98rem; box-shadow:0 10px 26px rgba(0,51,102,0.15); transition:transform .14s ease, box-shadow .14s ease, opacity .12s; }
.form-toggle-btn i { font-size:1.05rem; }
.form-toggle-btn:hover { transform:translateY(-2px); box-shadow:0 12px 30px rgba(0,51,102,0.12); }
.form-toggle-btn:active { transform:translateY(0); }
.form-toggle-btn:focus { outline:3px solid rgba(0,51,102,0.12); outline-offset:2px; }
.form-toggle-btn.open { background:linear-gradient(90deg,var(--primary-light),var(--primary-dark)); }
@media (max-width:700px){ .form-toggle-btn { width:100%; justify-content:center; } }

.form-card { background:#fff; border:1px solid var(--border-color); border-radius:12px; padding:18px; box-shadow:var(--shadow-sm); max-width:1100px; margin:0 auto 16px; }
.form-card.hidden { display:none; }
.form-card .card-header { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:12px; }
.form-card h2 { margin:0; font-size:1.2rem; color:var(--text-dark); }
.form-card p.lead { margin:4px 0 0; color:var(--text-muted); font-size:0.95rem; }

.form-grid { display:grid; grid-template-columns: 1fr 1fr; gap:12px 18px; align-items:start; }
.form-grid .full { grid-column:1 / -1; }
.form-group { display:flex; flex-direction:column; gap:6px; margin-bottom:8px; }
.form-group label { font-weight:600; color:var(--text-dark); font-size:0.94rem; }
.form-control { padding:10px 12px; border-radius:10px; border:1px solid var(--border-color); background:#fff; font-size:0.95rem; }
.form-control:focus { outline:none; border-color:var(--primary-dark); box-shadow:0 6px 18px rgba(0,51,102,0.06); }

.form-actions { display:flex; gap:12px; justify-content:flex-end; margin-top:8px; }
.btn-primary { padding:10px 16px; border-radius:10px; background:linear-gradient(135deg,var(--primary-dark),var(--primary-light)); color:#fff; border:none; font-weight:700; }
.btn-secondary { padding:10px 14px; border-radius:10px; border:1px solid var(--border-color); background:transparent; color:var(--primary-dark); }

/* Compact variant: single-column, tighter spacing, preview hidden */
.form-card.compact { max-width:760px; margin:0 auto 16px; }
.form-card.compact .form-body { display:block; }
.form-card.compact .form-grid { grid-template-columns: 1fr; gap:8px; }
.form-card.compact .full { grid-column: 1 / -1; }
.form-card.compact .preview { display:none; }
.form-card.compact .form-actions { justify-content:flex-end; }
.form-card.compact .btn-primary { min-width:160px; }

.form-error-message { color:#ff4757; font-size:0.85rem; margin-top:6px; display:flex; gap:8px; align-items:center; }

/* Modern Event Card Design */
/* Events layout */
.events-grid { 
    display: grid; 
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); 
    gap: 26px; 
    margin-top: 26px; 
}

/* Event card – refined spacing, hierarchy and visual polish */
.event-card { 
    background: #ffffff; 
    border: 1px solid rgba(233, 236, 239, 0.9); 
    border-radius: 18px; 
    padding: 22px 22px 20px; 
    box-shadow: var(--shadow-sm); 
    display: flex; 
    flex-direction: column; 
    gap: 14px; 
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease, background-color 0.25s ease; 
    position: relative; 
    overflow: hidden; 
}

.event-card:hover { 
    transform: translateY(-4px); 
    box-shadow: var(--shadow-md); 
    border-color: rgba(0, 123, 255, 0.18); 
    background-color: #fbfdff;
}

.event-card::before { 
    content: ''; 
    position: absolute; 
    top: 0; left: 0; width: 100%; height: 4px; 
    background: linear-gradient(90deg, var(--primary-dark), var(--primary-light)); 
    opacity: 0; 
    transition: opacity 0.3s; 
}

.event-card:hover::before { opacity: 1; }

.event-header { 
    display: flex; 
    justify-content: space-between; 
    align-items: flex-start; 
    gap: 14px; 
}

.event-title { 
    font-size: 1.2rem; 
    font-weight: 700; 
    color: var(--text-dark); 
    margin: 0; 
    line-height: 1.3; 
}

.event-date { 
    display: flex; 
    align-items: center; 
    gap: 6px; 
    font-size: 0.82rem; 
    color: var(--text-muted); 
    background: #f8f9fb; 
    padding: 6px 11px; 
    border-radius: 999px; 
    white-space: nowrap; 
}

.event-description { 
    font-size: 0.95rem; 
    color: var(--text-muted); 
    line-height: 1.5; 
    flex-grow: 1; /* Pushes footer down */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.event-badges { 
    display: flex; 
    flex-wrap: wrap; 
    gap: 8px; 
    margin-top: 4px; 
}

.badge { 
    display: inline-flex; 
    align-items: center; 
    gap: 5px; 
    padding: 4px 10px; 
    border-radius: 999px; 
    font-size: 0.8rem; 
    font-weight: 600; 
}

.badge.priority { background: rgba(255, 193, 7, 0.15); color: #b4890a; }
.badge.status { background: rgba(0, 198, 255, 0.1); color: #009ec3; }
.badge.duration { background: rgba(108, 117, 125, 0.1); color: var(--text-muted); }

/* Footer actions – clearer hierarchy, spacing and responsive layout */
.event-actions { 
    display: flex; 
    align-items: center; 
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 16px;
    margin-top: 20px; 
    padding-top: 16px; 
    border-top: 1px solid var(--border-color); 
}

.event-actions-main,
.event-actions-secondary {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
}

.event-actions-secondary {
    margin-left: auto;
}

.btn-icon { 
    display: inline-flex; 
    align-items: center; 
    justify-content: center; 
    gap: 8px;
    padding: 9px 18px;
    min-height: 40px;
    border-radius: 999px; 
    border: none; 
    font-size: 0.9rem; 
    font-weight: 600;
    cursor: pointer; 
    text-decoration: none;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
    transition: transform 0.2s, box-shadow 0.2s, background 0.2s, color 0.2s;
}

.btn-icon i {
    font-size: 0.9rem;
}

.btn-icon-label {
    font-size: 0.85rem;
    font-weight: 500;
}

.btn-icon.edit { 
    background: linear-gradient(135deg, #e4f0ff, #c7ddff); 
    color: var(--accent-blue); 
}
.btn-icon.edit:hover { 
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(0, 86, 179, 0.25);
}

.btn-icon.delete { 
    background: linear-gradient(135deg, #ffe1e6, #ffb3c0); 
    color: #b3263a; 
}
.btn-icon.delete:hover { 
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(255, 71, 87, 0.25);
}

.btn-motivation { 
    display: inline-flex; 
    align-items: center; 
    justify-content: center;
    gap: 8px; 
    padding: 9px 18px; 
    border-radius: 999px; 
    background: linear-gradient(135deg, var(--primary-dark), var(--primary-light)); 
    color: #fff; 
    font-weight: 600; 
    font-size: 0.9rem; 
    text-decoration: none; 
    box-shadow: 0 4px 10px rgba(0, 51, 102, 0.2); 
    transition: transform 0.2s, box-shadow 0.2s; 
}

.btn-motivation:hover { 
    transform: translateY(-2px); 
    box-shadow: 0 6px 15px rgba(0, 51, 102, 0.3); 
    color: #fff; 
}

.btn-motivation.focus {
    background: linear-gradient(135deg, #ff9f43, #ff6b6b);
}

/* Weekly stats card – API visualisation */
.weekly-stats-card {
    margin-top: 18px;
}

.weekly-stats-header {
    margin-bottom: 10px;
}

.weekly-stats-header h2 {
    margin: 0;
    font-size: 1.1rem;
}

.weekly-stats-subtitle {
    margin: 4px 0 0;
    font-size: 0.9rem;
    color: var(--text-muted);
}

.weekly-stats-body {
    margin-top: 6px;
}

.weekly-stats-layout {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.weekly-stats-empty,
.weekly-stats-loading,
.weekly-stats-error {
    font-size: 0.9rem;
}

.weekly-stats-empty,
.weekly-stats-loading {
    color: var(--text-muted);
}

.weekly-stats-error {
    color: #ff4757;
}

.weekly-stats-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.weekly-stats-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 0;
    font-size: 0.9rem;
    border-bottom: 1px solid rgba(233, 236, 239, 0.8);
}

.weekly-stats-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.weekly-stats-week {
    font-weight: 600;
}

.weekly-stats-range {
    font-size: 0.8rem;
    color: var(--text-muted);
}

.weekly-stats-hours {
    font-weight: 600;
    color: var(--primary-dark);
    margin-bottom: 4px;
    text-align: right;
}

.weekly-stats-bar {
    width: 110px;
    height: 6px;
    border-radius: 999px;
    background: rgba(0, 123, 255, 0.08);
    overflow: hidden;
}

.weekly-stats-bar-fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--primary-dark), var(--primary-light));
    width: 0;
    transition: width 0.4s ease;
}

.weekly-stats-chart {
    min-height: 180px;
}

.weekly-stats-chart canvas {
    width: 100%;
    max-height: 230px;
}

@media (max-width: 768px) {
    .event-card {
        padding: 18px 16px;
        gap: 14px;
    }

    .event-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .event-actions {
        flex-direction: column;
        align-items: stretch;
    }

    .event-actions-main,
    .event-actions-secondary {
        width: 100%;
        justify-content: space-between;
    }

    .event-actions-secondary {
        justify-content: flex-end;
    }

    .btn-motivation {
        flex: 1;
    }
}

@keyframes pulse-highlight {
    0% { transform: scale(1); box-shadow: var(--shadow-sm); border-color: transparent; }
    50% { transform: scale(1.02); box-shadow: 0 4px 20px rgba(0, 198, 255, 0.3); border-color: var(--primary-light); }
    100% { transform: scale(1); box-shadow: var(--shadow-sm); border-color: transparent; }
}

.event-card {
    transition: transform 0.4s ease, box-shadow 0.3s ease, border-color 0.3s ease, opacity 0.3s ease;
}

.event-card.search-match {
    animation: pulse-highlight 0.6s ease-in-out;
    border: 2px solid var(--primary-light);
    box-shadow: 0 8px 24px rgba(0, 198, 255, 0.15);
    background-color: #fbfdff;
    position: relative;
    z-index: 10;
}


/* Same layout/colors as Courses (gestion) */
.courses-container { padding: 2rem; background: linear-gradient(135deg, #f5f9fd 0%, #eef4f9 100%); min-height: 100vh; }
.courses-header { display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 1.5rem 2rem; border-radius: 12px; margin-bottom: 1.25rem; box-shadow: 0 6px 24px rgba(10, 45, 80, 0.06); }
.courses-header .header-content h1 { font-size: 2rem; color: #0b2e4a; margin-bottom: 0.25rem; }
.courses-header .page-subtitle { color: #6c757d; font-size: 0.95rem; }
.courses-container .btn-primary { display: inline-flex; align-items: center; gap: 0.5rem; background: #0059A9; color: white; padding: 0.75rem 1.5rem; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; text-decoration: none; transition: all 0.3s ease; }
.courses-container .btn-primary:hover { background: #001F3F; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0, 89, 169, 0.3); }
.courses-container .btn-lg { font-size: 1rem; padding: 0.9rem 2rem; }
.stats-banner { background: linear-gradient(90deg, rgba(6,40,80,1) 0%, #0059A9 100%); padding: 1.5rem; border-radius: 12px; margin-bottom: 2rem; box-shadow: inset 0 -6px 20px rgba(0,0,0,0.12); }
.stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; max-width: 1200px; margin: 0 auto; }
.stats-banner .stat-card { background: linear-gradient(180deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%); padding: 1.25rem 1rem; border-radius: 10px; text-align: center; color: rgba(255,255,255,0.95); box-shadow: 0 6px 18px rgba(0,0,0,0.18); border: 1px solid rgba(255,255,255,0.04); }
.stats-banner .stat-number { font-size: 2.25rem; font-weight: 800; color: #d2f0ea; margin-bottom: 0.5rem; }
.stats-banner .stat-label { color: rgba(255,255,255,0.75); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; }
.courses-section { background: #fff; border-radius: 12px; box-shadow: 0 4px 14px rgba(10, 45, 80, 0.04); overflow: hidden; margin-bottom: 2rem; padding: 1.5rem; }
.section-header { padding-bottom: 1rem; margin-bottom: 1rem; border-bottom: 2px solid #f0f0f0; }
.form-toggle-btn { border: none; }
</style>

<div class="courses-container">
    <!-- En-tête -->
    <div class="courses-header">
        <div class="header-content">
            <h1 class="page-title">Gestion du Temps</h1>
            <p class="page-subtitle">Créez et gérez vos événements et plannings</p>
        </div>
        <div style="display:flex; gap:10px;">
            <button id="toggle-view-btn" class="btn-primary" style="background: var(--sidebar-bg);"><i class="fas fa-calendar-alt"></i> <span>Voir Calendrier</span></button>
            <button type="button" id="toggle-event-form" class="btn-primary btn-lg form-toggle-btn">
                <i class="fas fa-calendar-plus"></i> Ajouter un événement
            </button>
        </div>
    </div>

    <!-- Flash Messages -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}" style="padding: 15px; margin-bottom: 20px; border: 1px solid transparent; border-radius: 4px; {% if label == 'success' %}color: #155724; background-color: #d4edda; border-color: #c3e6cb;{% else %}color: #721c24; background-color: #f8d7da; border-color: #f5c6cb;{% endif %}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Stats banner -->
    <div class="stats-banner">
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-number">{{ events|length }}</div>
                <div class="stat-label">Événements</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">{{ completed_count|default(0) }}</div>
                <div class="stat-label">Terminés</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">{{ (events|length) - (completed_count|default(0)) }}</div>
                <div class="stat-label">En cours</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">{{ events|length }}</div>
                <div class="stat-label">Total</div>
            </div>
        </div>
    </div>
    
    <!-- Unified Visual Calendar -->
    <div id="calendar-view-container" class="courses-section" style="display: none; margin-bottom: 2rem;">
        <div id="calendar"></div>
    </div>

    {# Create form template (not rendered until Add clicked) #}
    <div id="temps-main">
        <template id="event-form-template">
            <div class="form-card" style="margin-bottom:18px;">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="card-header">
                    <div>
                        <h2>Create Event</h2>
                        <p class="lead">Add a new event to your schedule</p>
                    </div>
                </div>

                <div class="form-body">
                    <div class="form-grid">
                        <div class="form-group">
                            {{ form_label(form.title, 'Title') }}
                            {{ form_widget(form.title, {'attr': {'placeholder':'Event title', 'class':'form-control'}}) }}
                            {% for err in form.title.vars.errors %}
                                <div class="form-error-message">{{ err.message }}</div>
                            {% endfor %}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.date, 'Date') }}
                            {{ form_widget(form.date, {'attr': {'type':'date','class':'form-control'}}) }}
                            {% for err in form.date.vars.errors %}
                                <div class="form-error-message">{{ err.message }}</div>
                            {% endfor %}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.type, 'Type') }}
                            {{ form_widget(form.type, {'attr': {'placeholder':'e.g., Exam', 'class':'form-control'}}) }}
                            {% for err in form.type.vars.errors %}
                                <div class="form-error-message">{{ err.message }}</div>
                            {% endfor %}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.duration, 'Duration (min)') }}
                            {{ form_widget(form.duration, {'attr': {'type':'number','min':1,'max':1440,'class':'form-control'}}) }}
                            {% for err in form.duration.vars.errors %}
                                <div class="form-error-message">{{ err.message }}</div>
                            {% endfor %}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.location, 'Location') }}
                            {{ form_widget(form.location, {'attr': {'placeholder':'e.g., Room 101, Online', 'class':'form-control'}}) }}
                            {% for err in form.location.vars.errors %}
                                <div class="form-error-message">{{ err.message }}</div>
                            {% endfor %}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.difficulty, 'Difficulty (1-5)') }}
                            {{ form_widget(form.difficulty, {'attr': {'type':'number','min':1,'max':5,'class':'form-control'}}) }}
                            {% for err in form.difficulty.vars.errors %}
                                <div class="form-error-message">{{ err.message }}</div>
                            {% endfor %}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.priority, 'Priority') }}
                            {{ form_widget(form.priority, {'attr': {'class':'form-control'}}) }}
                            {% for err in form.priority.vars.errors %}
                                <div class="form-error-message">{{ err.message }}</div>
                            {% endfor %}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.status, 'Status') }}
                            {{ form_widget(form.status, {'attr': {'class':'form-control'}}) }}
                            {% for err in form.status.vars.errors %}
                                <div class="form-error-message">{{ err.message }}</div>
                            {% endfor %}
                        </div>

                        <div class="full">
                            <div class="form-group">
                                {{ form_label(form.description, 'Description') }}
                                {{ form_widget(form.description, {'attr': {'rows':4, 'class':'form-control'}}) }}
                                {% for err in form.description.vars.errors %}
                                    <div class="form-error-message">{{ err.message }}</div>
                                {% endfor %}
                            </div>
                        </div>

                    </div>

                    <aside class="preview">
                        <div class="preview-title">Preview</div>
                        <div class="preview-card">
                            <div class="preview-card-title">New Event</div>
                            <div class="preview-card-meta">—</div>
                            <div class="preview-card-desc">No description yet</div>
                        </div>
                    </aside>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Create Event</button>
                    <button data-cancel="event-form" type="button" class="btn-secondary">Cancel</button>
                </div>

                {{ form_end(form) }}
            </div>
        </template>

        <div id="event-form-container"></div>

        <!-- Section IA Planning -->
        <div class="courses-section ai-card" style="background: linear-gradient(135deg, #ffffff 0%, #f0f7ff 100%); border: 1px solid #cce5ff; cursor: pointer;" id="ai-planning-header">
            <div class="section-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: none; margin-bottom: 0;">
                <div>
                    <h2 style="margin:0; font-size:1.5rem; color:#0059A9;"><i class="fas fa-robot"></i> Planification Intelligente (IA)</h2>
                    <p style="margin:5px 0 0; color:#555;">Cliquez pour organiser votre journée selon votre état émotionnel <i class="fas fa-chevron-down" id="ai-caret" style="margin-left: 10px; transition: transform 0.3s;"></i></p>
                </div>
                <div id="ai-download-container" onclick="event.stopPropagation();">
                    {% if app.session.get('last_planning_pdf') %}
                        <a href="{{ path('app_temps_download_planning') }}" id="btn-download-planning" class="btn-primary" style="background: #27ae60;">
                            <i class="fas fa-file-pdf"></i> Télécharger mon dernier planning
                        </a>
                    {% endif %}
                </div>
            </div>

            <div id="ai-planning-body" style="display: none; margin-top: 25px; border-top: 1px solid #cce5ff; padding-top: 20px;">
                <form id="ai-planning-form" action="{{ path('app_temps_analyze') }}" method="POST">
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
                        <div class="form-group">
                            <label for="energy"><i class="fas fa-battery-three-quarters"></i> Niveau d'énergie (1-10)</label>
                            <input type="range" name="energy" id="energy" min="1" max="10" value="5" class="form-control js-ai-input" oninput="this.nextElementSibling.value = this.value">
                            <output style="text-align: center; font-weight: bold; color: #0059A9;">5</output>
                        </div>
                        <div class="form-group">
                            <label for="stress"><i class="fas fa-brain"></i> Niveau de stress (1-10)</label>
                            <input type="range" name="stress" id="stress" min="1" max="10" value="5" class="form-control js-ai-input" oninput="this.nextElementSibling.value = this.value">
                            <output style="text-align: center; font-weight: bold; color: #e74c3c;">5</output>
                        </div>
                        <div class="form-group">
                            <label for="sleep"><i class="fas fa-bed"></i> Qualité du sommeil (1-10)</label>
                            <input type="range" name="sleep" id="sleep" min="1" max="10" value="5" class="form-control js-ai-input" oninput="this.nextElementSibling.value = this.value">
                            <output style="text-align: center; font-weight: bold; color: #f1c40f;">5</output>
                        </div>
                    </div>
                    <div class="form-group" style="margin-top: 15px;">
                        <label for="mood"><i class="fas fa-smile"></i> Comment vous sentez-vous aujourd'hui ? (Analyse de sentiment)</label>
                        <textarea name="mood" id="mood" rows="2" class="form-control js-ai-input" placeholder="Ex: Je me sens un peu fatigué mais motivé pour finir mon projet..."></textarea>
                    </div>
                    <div style="margin-top: 20px; text-align: right;">
                        <button type="submit" class="btn-primary" style="padding: 12px 25px; font-size: 1rem;">
                            <i class="fas fa-magic"></i> Analyser et Générer mon Planning
                        </button>
                    </div>
                </form>
            </div>
        </div>
        <div class="courses-section">
            <div class="section-header">
                <h2 style="margin:0; font-size:1.5rem; color:#1F1F1F;">Liste des événements</h2>
            </div>
            <div id="events-list">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                    <div style="display:flex; align-items:center; gap:15px;">
                        <h2 style="margin:0; font-size:1.1rem;">Vos événements</h2>
                        <div class="sort-controls" style="display:flex; gap:8px;">
                            <a href="{{ path('app_temps') }}" class="badge {{ app.request.query.get('sort') != 'priority' ? 'priority' : 'duration' }}" style="text-decoration:none; cursor:pointer; padding:6px 12px; font-size:0.85rem;">
                                <i class="fas fa-calendar"></i> Date
                            </a>
                            <a href="{{ path('app_temps', {'sort': 'priority'}) }}" class="badge {{ app.request.query.get('sort') == 'priority' ? 'priority' : 'duration' }}" style="text-decoration:none; cursor:pointer; padding:6px 12px; font-size:0.85rem;">
                                <i class="fas fa-layer-group"></i> Priority
                            </a>
                        </div>
                    </div>
                </div>

                {% if events is empty %}
                    <div class="empty-state" style="padding:3rem; text-align:center; background:#fff; border:2px dashed #e2e8f0; border-radius:16px;">
                        <div style="width:80px; height:80px; background:#f0f9ff; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 1rem; color:#0059A9;"><i class="fas fa-calendar-plus" style="font-size:2rem;"></i></div>
                        <h3 style="font-size:1.25rem; color:#1e293b; margin-bottom:0.5rem;">Aucun événement</h3>
                        <p style="color:#64748b; margin-bottom:1.5rem;">Cliquez sur « Ajouter un événement » pour créer votre premier planning.</p>
                    </div>
                {% else %}
                    <div class="events-grid">
                        {% for event in events %}
                            <div class="event-card">
                                <div class="event-header">
                                    <h3 class="event-title">{{ event.title }}</h3>
                                    {% if event.date %}
                                        <div class="event-date">
                                            <i class="fas fa-calendar-day"></i> {{ event.date|date('M d, Y') }}
                                        </div>
                                    {% endif %}
                                </div>

                                <div class="event-description">
                                    {{ event.description|default('No description provided.') }}
                                </div>

                                <div class="event-badges">
                                    {% if event.duration %}
                                        <span class="badge duration"><i class="fas fa-clock"></i> {{ event.duration }}m</span>
                                    {% endif %}
                                    {% if event.priority %}
                                        <span class="badge priority"><i class="fas fa-bolt"></i> {{ event.priority }}</span>
                                    {% endif %}
                                    {% if event.status %}
                                        <span class="badge status"><i class="fas fa-info-circle"></i> {{ event.status }}</span>
                                    {% endif %}
                                    {% if event.googleEventId %}
                                        <span class="badge" style="background: rgba(66, 133, 244, 0.1); color: #4285F4;" title="Linked with Google Calendar">
                                            <i class="fab fa-google"></i> Synced
                                        </span>
                                    {% endif %}
                                    {% if event.pomodoroSessions|length > 0 %}
                                        <div class="pomodoro-summary" style="margin-top:10px;">
                                            <details>
                                                <summary style="cursor:pointer; font-size:0.85rem; color:#ff5722; font-weight:600;">
                                                    <i class="fas fa-stopwatch"></i> {{ event.pomodoroSessions|length }} Sessions Plan
                                                </summary>
                                                <ul style="list-style:none; padding:10px; margin:5px 0 0; background:#fff5f2; border-radius:8px; font-size:0.8rem;">
                                                    {% for session in event.pomodoroSessions %}
                                                        <li style="display:flex; justify-content:space-between; margin-bottom:4px; padding-bottom:4px; border-bottom:1px solid rgba(255,87,34,0.1);">
                                                            <span>
                                                                {% if session.type == 'WORK' %}🍅 Work{% elseif session.type == 'SHORT_BREAK' %}☕ Short Break{% else %}🛌 Long Break{% endif %}
                                                            </span>
                                                            <strong>{{ session.duration }}m</strong>
                                                        </li>
                                                    {% endfor %}
                                                </ul>
                                            </details>
                                        </div>
                                    {% endif %}
                                </div>

                                <div class="event-actions">
                                    {% if app.user and event.user and event.user.id == app.user.id %}
                                        <div class="event-actions-main">
                                            <a href="{{ path('app_motivation_panel', {id: event.id}) }}" class="btn-motivation">
                                                <i class="fas fa-lightbulb"></i>
                                                <span>Motivation</span>
                                            </a>
                                            <a href="{{ path('app_event_pomodoro', {id: event.id}) }}" class="btn-motivation focus">
                                                <i class="fas fa-stopwatch"></i>
                                                <span>Focus</span>
                                            </a>
                                            {% if not event.googleEventId and app.user and app.user.googleAccessToken %}
                                                <a href="{{ path('app_temps_sync', {id: event.id}) }}" class="btn-motivation" style="background: #4285F4;" title="Sync to Google">
                                                    <i class="fab fa-google"></i>
                                                    <span>Sync</span>
                                                </a>
                                            {% endif %}
                                        </div>

                                        <div class="event-actions-secondary">
                                            <a href="{{ path('app_temps_edit', {id: event.id}) }}" class="btn-icon edit" title="Edit Event" aria-label="Edit Event">
                                                <i class="fas fa-pen"></i>
                                            </a>
                                            <form method="POST" action="{{ path('app_temps_delete', {id: event.id}) }}" style="margin:0;" onsubmit="return confirm('Delete this event?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                                                <button type="submit" class="btn-icon delete" title="Delete Event" aria-label="Delete Event">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    {% else %}
                                        <div style="width:100%; text-align:center; color:var(--text-muted); font-size:0.9rem;">
                                            <i class="fas fa-lock"></i> Read Only
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            {% if google_events is not empty %}
                <div class="section-header" style="margin-top: 40px;">
                    <h2 style="margin:0; font-size:1.5rem; color:#1F1F1F; display: flex; align-items: center; gap: 10px;">
                        <i class="fab fa-google" style="color: #4285F4;"></i> Google Calendar (Cette semaine)
                    </h2>
                </div>
                <div class="events-grid">
                    {% for g_event in google_events %}
                        <div class="event-card" style="border-left: 5px solid #4285F4;">
                            <div class="event-header">
                                <h3 class="event-title">{{ g_event.summary }}</h3>
                                <div class="event-date">
                                    <i class="fas fa-clock"></i> {{ g_event.start|date('M d, H:i') }}
                                </div>
                            </div>
                            <div class="event-description">
                                {{ g_event.description|default('No description provided.') }}
                                {% if g_event.location %}
                                    <div style="margin-top: 8px; font-size: 0.85rem;">
                                        <i class="fas fa-map-marker-alt" style="color: #ea4335;"></i> {{ g_event.location }}
                                    </div>
                                {% endif %}
                            </div>
                            <div class="event-badges">
                                <span class="badge" style="background: rgba(66, 133, 244, 0.1); color: #4285F4;">
                                    <i class="fab fa-google"></i> External Event
                                </span>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        {# Weekly stats card – API visualisation #}
        <div class="form-card weekly-stats-card">
            <div class="card-header weekly-stats-header">
                <div>
                    <h2>Weekly Time Overview</h2>
                    <p class="lead weekly-stats-subtitle">Total hours worked per week, based on your events.</p>
                </div>
            </div>
            <div class="weekly-stats-layout">
                <div id="weekly-time-stats" class="weekly-stats-body"></div>
                <div class="weekly-stats-chart">
                    <canvas id="weekly-time-chart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/moment@2.29.4/moment.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/locales/fr.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
// Dynamic form injection, toggle behavior, client validation and live preview
(function(){
    document.addEventListener('DOMContentLoaded', function(){
        var toggle = document.getElementById('toggle-event-form');
        var template = document.getElementById('event-form-template');
        var container = document.getElementById('event-form-container');
        var tempsMain = document.getElementById('temps-main');

        function setMinDateIn(root){
            // Optional: Uncomment to prevent past dates
            // var d = new Date();
            // var iso = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
            // (root || document).querySelectorAll('input[type="date"]').forEach(function(i){ i.setAttribute('min', iso); });
        }

        function bindFormHandlers(card){
            if(!card) return;
            setMinDateIn(card);

            var cancel = card.querySelector('[data-cancel="event-form"]');
            if(cancel) cancel.addEventListener('click', function(){
                container.innerHTML = '';
                if(tempsMain) tempsMain.classList.remove('expanded');
                if(toggle) toggle.innerHTML = '<i class="fas fa-calendar-plus"></i> Ajouter un événement';
            });

            var form = card.querySelector('form');
            if(form){
                form.addEventListener('submit', function(e){
                    // inline client validation
                    var ok = true;
                    var title = form.querySelector('input[name$="[title]"]');
                    var date = form.querySelector('input[name$="[date]"]');
                    var priority = form.querySelector('select[name$="[priority]"]');
                    var status = form.querySelector('select[name$="[status]"]');
                    function clearErrors(){ form.querySelectorAll('.form-error-message.js-client').forEach(function(el){ el.remove(); }); form.querySelectorAll('.has-error').forEach(function(el){ el.classList.remove('has-error'); }); }
                    function showError(input, msg){ var containerDiv = input.closest('div') || input.parentNode; containerDiv.classList.add('has-error'); var m = document.createElement('div'); m.className = 'form-error-message js-client'; m.innerHTML = '<i class="fas fa-exclamation-circle"></i> ' + msg; containerDiv.appendChild(m); }
                    clearErrors();
                    if(!title || !title.value.trim()){ showError(title || form, 'Title is required'); ok = false; }
                    if(!date || !date.value){ showError(date || form, 'Date is required'); ok = false; }
                    if(!priority || !priority.value){ showError(priority || form, 'Priority is required'); ok = false; }
                    if(!status || !status.value){ showError(status || form, 'Status is required'); ok = false; }
                    if(!ok){ e.preventDefault(); return false; }
                    return true;
                });
            }

            // live preview
            var titleIn = card.querySelector('input[name$="[title]"]');
            var dateIn = card.querySelector('input[name$="[date]"]');
            var typeIn = card.querySelector('input[name$="[type]"]');
            var descIn = card.querySelector('textarea[name$="[description]"]');
            var previewTitle = card.querySelector('.preview-card-title');
            var previewMeta = card.querySelector('.preview-card-meta');
            var previewDesc = card.querySelector('.preview-card-desc');
            function update(){
                if(previewTitle) previewTitle.textContent = (titleIn && titleIn.value.trim()) ? titleIn.value.trim() : 'New Event';
                var parts = [];
                if(dateIn && dateIn.value) parts.push(new Date(dateIn.value).toLocaleDateString());
                if(typeIn && typeIn.value.trim()) parts.push(typeIn.value.trim());
                if(previewMeta) previewMeta.textContent = parts.length ? parts.join(' • ') : '—';
                if(previewDesc) previewDesc.textContent = (descIn && descIn.value.trim()) ? descIn.value.trim() : 'No description yet';
            }
            [titleIn, dateIn, typeIn, descIn].forEach(function(el){ if(el) el.addEventListener('input', update); });
            update();
        }

        // initial state: ensure container empty and events visible
        if(container) container.innerHTML = '';
        if(tempsMain) tempsMain.classList.remove('expanded');
        if(toggle) toggle.innerHTML = '<i class="fas fa-calendar-plus"></i> Ajouter un événement';

        if(!toggle || !template || !container) return;

        toggle.addEventListener('click', function(){
                    if(container.children.length === 0){
                        // insert form from template (compact vertical variant)
                        var clone = document.importNode(template.content, true);
                        container.appendChild(clone);
                        var card = container.querySelector('.form-card');
                        // compact style: don't expand parent grid, show single-column form
                        if(card) card.classList.add('compact');
                        if(toggle) toggle.innerHTML = '<i class="fas fa-times"></i> Fermer';
                        // bind handlers for the newly-inserted form
                        bindFormHandlers(card);
                    } else {
                        // remove form
                        container.innerHTML = '';
                        if(tempsMain) tempsMain.classList.remove('expanded');
                        if(toggle) toggle.innerHTML = '<i class="fas fa-calendar-plus"></i> Ajouter un événement';
                    }
        });

        // Search functionality
        var searchInput = document.getElementById('event-search-input'); // Changed to match base.html.twig ID
        if(searchInput){
            // ... (keep existing search logic) ...
            searchInput.addEventListener('input', function(e){
                var term = e.target.value.toLowerCase().trim();
                var cards = document.querySelectorAll('.event-card');
                var hasVisible = false;
                
                cards.forEach(function(card){
                    // ... (keep existing filtering logic) ...
                    var title = (card.querySelector('.event-title') ? card.querySelector('.event-title').textContent : '').toLowerCase();
                    var desc = (card.querySelector('.event-description') ? card.querySelector('.event-description').textContent : '').toLowerCase();
                    var badges = Array.from(card.querySelectorAll('.badge')).map(el => el.textContent.toLowerCase()).join(' ');
                    
                    if(title.includes(term) || desc.includes(term) || badges.includes(term)){
                        card.style.display = '';
                        hasVisible = true;
                        if(term.length >= 1) {
                            card.classList.remove('search-match'); // Reset animation
                            void card.offsetWidth; // Trigger reflow
                            card.classList.add('search-match');
                        } else {
                            card.classList.remove('search-match');
                        }
                    } else {
                        card.style.display = 'none';
                        card.classList.remove('search-match');
                    }
                });
                
                // Show/hide empty state message
                var grid = document.querySelector('.events-grid');
                if(grid) {
                    var emptyMsg = document.getElementById('search-no-results');
                    if(!hasVisible && term.length > 0){
                         if(!emptyMsg){
                             var msg = document.createElement('div');
                             msg.id = 'search-no-results';
                             msg.style = 'grid-column: 1/-1; text-align:center; padding:3rem; color:#64748b; font-style:italic; animation: fadeIn 0.3s ease;';
                             msg.innerHTML = '<i class="fas fa-search" style="font-size:2rem; margin-bottom:15px; display:block; opacity:0.5; color:var(--primary-dark);"></i><span style="font-size:1.1rem; font-weight:500;">Aucun événement trouvé pour "' + e.target.value + '"</span><br><span style="font-size:0.9rem; opacity:0.8;">Essayez avec d\'autres mots-clés.</span>';
                             grid.appendChild(msg);
                         } else {
                             // Update existing message text update
                             var span = emptyMsg.querySelector('span');
                             if(span) span.textContent = 'Aucun événement trouvé pour "' + e.target.value + '"';
                         }
                    } else {
                        if(emptyMsg) emptyMsg.remove();
                    }
                }
            });
        }

        // Weekly Stats Chart Implementation
        function initWeeklyStats() {
            var ctx = document.getElementById('weekly-time-chart');
            if(!ctx) return;
            
            var googleEventsData = {{ google_events|default([])|json_encode|raw }};
            
            // Gather data from DOM
            var events = [];
            document.querySelectorAll('.event-card').forEach(function(card){
                var dateText = card.querySelector('.event-date') ? card.querySelector('.event-date').textContent.trim() : '';
                var durationText = card.querySelector('.badge.duration') ? card.querySelector('.badge.duration').textContent.trim() : '0';
                var duration = parseInt(durationText) || 0; // minutes
                
                if(dateText && duration > 0){
                    var date = new Date(dateText);
                    if(!isNaN(date.getTime())){
                        events.push({date: date, duration: duration});
                    }
                }
            });

            // Add Google Events to data
            googleEventsData.forEach(function(ev){
                var start = new Date(ev.start);
                var end = new Date(ev.end);
                if(!isNaN(start.getTime()) && !isNaN(end.getTime())){
                    var duration = Math.round((end - start) / (1000 * 60)); // minutes
                    events.push({date: start, duration: duration, isGoogle: true});
                }
            });

            // Group by week
            var weeks = {};
            events.forEach(function(ev){
                var d = new Date(ev.date);
                d.setHours(0,0,0,0);
                // get Monday of the week
                var day = d.getDay() || 7;
                if(day !== 1) d.setHours(-24 * (day - 1));
                
                var key = d.toLocaleDateString('fr-FR', {day:'numeric', month:'short'}); // e.g. "16 févr."
                if(!weeks[key]) weeks[key] = 0;
                weeks[key] += ev.duration;
            });

            // Sort weeks
            var labels = Object.keys(weeks).sort(function(a,b){
                // simplistic sort usually works if keys are dates, but these are strings. 
                // Better approach: ensure source array is sorted or use timestamps as keys.
                // For now, let's rely on event list order if it's chronological, or simple string sort.
                return 0; // naive
            });
            var dataPoints = labels.map(function(k){ return (weeks[k] / 60).toFixed(1); }); // hours

            // Render Chart
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels.length ? labels : ['Cette semaine'],
                    datasets: [{
                        label: 'Heures planifiées',
                        data: dataPoints.length ? dataPoints : [0],
                        backgroundColor: 'rgba(0, 89, 169, 0.7)',
                        borderRadius: 6,
                        barThickness: 20,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { borderDash: [4, 4], drawBorder: false },
                            ticks: { font: { size: 11 } }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 11 } }
                        }
                    }
                }
            });
            
            // Render Text Stats
            var statsContainer = document.getElementById('weekly-time-stats');
            if(statsContainer){
                var totalMin = events.reduce((acc, curr) => acc + curr.duration, 0);
                var totalHours = (totalMin / 60).toFixed(1);
                 statsContainer.innerHTML = '<div style="display:flex; justify-content:space-between; margin-bottom:10px;">' + 
                    '<span><strong>Total:</strong> ' + totalHours + 'h (' + events.length + ' événements)</span>' +
                    '</div>';
            }
        }
        
        initWeeklyStats();

        // View Toggling logic
        var toggleViewBtn = document.getElementById('toggle-view-btn');
        var listView = document.getElementById('events-list').closest('.courses-section');
        var googleView = document.querySelector('.section-header + .events-grid'); // Search for the Google grid
        var calendarContainer = document.getElementById('calendar-view-container');
        var isCalendar = false;

        toggleViewBtn.addEventListener('click', function() {
            isCalendar = !isCalendar;
            if (isCalendar) {
                listView.style.display = 'none';
                if (googleView) googleView.previousElementSibling.style.display = 'none';
                if (googleView) googleView.style.display = 'none';
                calendarContainer.style.display = 'block';
                toggleViewBtn.innerHTML = '<i class="fas fa-arrow-left"></i> <span>Retour</span>';
                calendar.render();
            } else {
                listView.style.display = 'block';
                if (googleView) googleView.previousElementSibling.style.display = 'block';
                if (googleView) googleView.style.display = 'grid';
                calendarContainer.style.display = 'none';
                toggleViewBtn.innerHTML = '<i class="fas fa-calendar-alt"></i> <span>Voir Calendrier</span>';
            }
        });

        // FullCalendar Initialization
        var calendarEl = document.getElementById('calendar');
        var localEventsData = [
            {% for event in events %}
            {
                id: "{{ event.id }}",
                title: "{{ event.title|escape('js') }}",
                start: "{{ event.date|date('Y-m-d') }}{% if event.startTime %}T{{ event.startTime|date('H:i:s') }}{% endif %}",
                {% if event.endTime %}
                end: "{{ event.endTime|date('Y-m-d H:i:s') }}",
                {% elseif event.duration %}
                end: moment("{{ event.date|date('Y-m-d') }}").add({{ event.duration }}, 'minutes').toISOString(),
                {% endif %}
                allDay: {% if event.startTime %}false{% else %}true{% endif %},
                color: '#0059A9',
                extendedProps: {
                    type: 'local',
                    description: "{{ event.description|default('')|escape('js') }}",
                    deleteUrl: "{{ path('app_temps_delete', {id: event.id}) }}",
                    csrfToken: "{{ csrf_token('delete' ~ event.id) }}"
                }
            },
            {% endfor %}
        ];

        var googleEventsData = {{ google_events|default([])|json_encode|raw }};
        var mappedGoogleEvents = googleEventsData.map(function(ev) {
            return {
                id: ev.id,
                title: ev.summary,
                start: ev.start,
                end: ev.end,
                allDay: !ev.start.includes('T'),
                color: '#4285F4',
                extendedProps: {
                    type: 'google',
                    description: ev.description || ''
                }
            };
        });

        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            locale: 'fr',
            displayEventTime: true,
            eventDisplay: 'block',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            events: localEventsData.concat(mappedGoogleEvents),
            dateClick: function(info) {
                Swal.fire({
                    title: 'Ajouter un événement ?',
                    text: 'Voulez-vous créer un nouvel événement pour le ' + info.dateStr + ' ?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#0059A9',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="fas fa-plus"></i> Oui, ajouter',
                    cancelButtonText: 'Annuler',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Switch to List View if in Calendar
                        if (isCalendar) {
                            toggleViewBtn.click();
                        }
                        // Open add form if not open
                        if (container.children.length === 0) {
                            document.getElementById('toggle-event-form').click();
                        }
                        // Pre-fill date
                        var dateInput = container.querySelector('input[type="date"]');
                        if (dateInput) {
                            dateInput.value = info.dateStr;
                            // Trigger live preview update
                            dateInput.dispatchEvent(new Event('input'));
                        }
                        // Scroll to form
                        container.scrollIntoView({ behavior: 'smooth' });
                    }
                });
            },
            eventClick: function(info) {
                var event = info.event;
                var props = event.extendedProps;
                
                if (props.type === 'local') {
                    Swal.fire({
                        title: 'Supprimer l\'événement ?',
                        text: 'Voulez-vous vraiment supprimer "' + event.title + '" ?',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: '<i class="fas fa-trash"></i> Oui, supprimer',
                        cancelButtonText: 'Annuler',
                        reverseButtons: true
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Create a temporary form to submit the delete request
                            var form = document.createElement('form');
                            form.method = 'POST';
                            form.action = props.deleteUrl;
                            
                            var tokenInput = document.createElement('input');
                            tokenInput.type = 'hidden';
                            tokenInput.name = '_token';
                            tokenInput.value = props.csrfToken;
                            
                            form.appendChild(tokenInput);
                            document.body.appendChild(form);
                            form.submit();
                        }
                    });
                } else if (props.type === 'google') {
                    Swal.fire({
                        title: 'Événement Google',
                        text: 'Cet événement provient de Google Calendar. Pour le supprimer, utilisez la vue liste ou demandez à l\'assistant Studly.',
                        icon: 'info',
                        confirmButtonColor: '#4285F4',
                        confirmButtonText: 'Compris'
                    });
                }
            }
        });

        // AI Planning Button Visibility Logic
        var aiForm = document.getElementById('ai-planning-form');
        var downloadBtn = document.getElementById('btn-download-planning');
        var downloadContainer = document.getElementById('ai-download-container');
        var aiInputs = document.querySelectorAll('.js-ai-input');

        if (downloadBtn) {
            downloadBtn.addEventListener('click', function() {
                // Hide the button when clicked
                downloadContainer.style.display = 'none';
            });
        }

        if (aiForm) {
            aiInputs.forEach(function(input) {
                input.addEventListener('input', function() {
                    if (downloadContainer && downloadContainer.style.display === 'none') {
                        downloadContainer.style.display = 'block';
                    }
                });
            });
        }

        // Collapsible Card Logic
        var aiHeader = document.getElementById('ai-planning-header');
        var aiBody = document.getElementById('ai-planning-body');
        var aiCaret = document.getElementById('ai-caret');

        if (aiHeader && aiBody) {
            aiHeader.addEventListener('click', function() {
                var isHidden = aiBody.style.display === 'none';
                aiBody.style.display = isHidden ? 'block' : 'none';
                if (aiCaret) {
                    aiCaret.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
                }
                
                // Adjust header border
                aiHeader.style.borderBottom = isHidden ? '1px solid #cce5ff' : 'none';
            });
        }
    });
})();
</script>
{% endblock %}
