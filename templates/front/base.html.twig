{% extends 'base.html.twig' %}

{% block title %}Student Hub{% endblock %}

{% block body %}
<style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

    :root {
        --primary-dark: #003366;
        --primary-light: #00c6ff;
        --accent-blue: #0056b3;
        --sidebar-bg: radial-gradient(circle at 10% 20%, rgb(0, 89, 169) 0%, rgb(0, 31, 63) 90%);
        --main-bg: #FFFFFF;
        --card-bg: #F8F9FA;
        --text-dark: #333333;
        --text-muted: #6c757d;
        --border-color: #e9ecef;
        --sidebar-width: 280px;
        --topbar-height: 80px;
        --shadow-sm: 0 2px 8px rgba(0,0,0,0.05);
        --shadow-md: 0 8px 16px rgba(0,0,0,0.08);
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Poppins', sans-serif;
    }

    body {
        background-color: var(--main-bg);
        color: var(--text-dark);
        min-height: 100vh;
        overflow-x: hidden;
    }

    /* Sidebar - Preserved Original Look */
    .sidebar {
        width: var(--sidebar-width);
        background: var(--sidebar-bg);
        color: #fff;
        display: flex;
        flex-direction: column;
        padding: 25px;
        position: fixed;
        height: 100vh;
        z-index: 100;
        transition: 0.3s;
        box-shadow: 4px 0 15px rgba(0,0,0,0.1);
    }

    .logo {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 1.6rem;
        font-weight: 700;
        margin-bottom: 50px;
        padding-left: 10px;
        color: #fff;
    }
    
    .logo i { 
        font-size: 1.8rem; 
        color: var(--primary-light);
    }

    .nav-links {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .nav-item a {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 14px 20px;
        color: rgba(255, 255, 255, 0.75);
        text-decoration: none;
        border-radius: 12px;
        transition: 0.3s;
        font-weight: 500;
        font-size: 0.95rem;
    }

    .nav-item a:hover, .nav-item a.active {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
        transform: translateX(5px);
    }

    .nav-item i { width: 25px; text-align: center; }

    /* Main Content - New Clean Light Theme */
    .main-content {
        flex: 1;
        margin-left: var(--sidebar-width);
        padding: 30px 50px;
        display: flex;
        flex-direction: column;
        gap: 40px;
    }

    /* Topbar */
    .topbar {
        height: var(--topbar-height);
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .search-bar {
        background: #f1f3f4;
        border-radius: 12px;
        padding: 12px 25px;
        display: flex;
        align-items: center;
        gap: 15px;
        width: 350px;
        transition: 0.3s;
        border: 1px solid transparent;
    }

    .search-bar:focus-within {
        background: #fff;
        box-shadow: var(--shadow-sm);
        border-color: var(--border-color);
    }

    .search-bar input {
        background: transparent;
        border: none;
        outline: none;
        color: var(--text-dark);
        width: 100%;
        font-size: 0.95rem;
    }
    
    .search-bar i { color: var(--text-muted); }

    .user-actions {
        display: flex;
        align-items: center;
        gap: 25px;
    }

    .icon-btn {
        background: #fff;
        border: 1px solid var(--border-color);
        color: var(--text-muted);
        width: 45px;
        height: 45px;
        border-radius: 12px;
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        transition: 0.3s;
        position: relative;
        box-shadow: var(--shadow-sm);
    }

    .icon-btn:hover { 
        background: var(--primary-light); 
        color: #fff; 
        border-color: var(--primary-light);
    }
    
    .notification-dot {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 8px;
        height: 8px;
        background: #ff4757;
        border-radius: 50%;
        border: 2px solid #fff;
    }

    .profile-card {
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        padding: 5px;
        border-radius: 12px;
        transition: 0.2s;
    }
    
    .profile-card:hover { background: #f8f9fa; }

    .avatar {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: linear-gradient(135deg, #003366 0%, #0056b3 100%);
        color: #fff;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: 600;
        font-size: 1rem;
        box-shadow: var(--shadow-sm);
    }

    .profile-info {
        display: flex;
        flex-direction: column;
    }

    .profile-name {
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--text-dark);
    }

    .profile-role {
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    /* Welcome Section */
    .welcome-section h1 { 
        font-size: 2.2rem; 
        margin-bottom: 10px; 
        color: #1a1a1a;
        font-weight: 700;
    }
    
    .welcome-section p { 
        color: var(--text-muted); 
        font-size: 1.05rem;
    }

    /* Dashboard Grid */
    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 30px;
    }

    .card {
        background: #fff;
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 30px;
        transition: 0.3s;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 220px;
        box-shadow: var(--shadow-sm);
        position: relative;
        overflow: hidden;
    }

    .card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 6px;
        background: linear-gradient(90deg, var(--primary-dark), var(--primary-light));
        opacity: 0;
        transition: 0.3s;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-md);
        border-color: transparent;
    }

    .card:hover::before { opacity: 1; }

    .card-icon {
        width: 55px;
        height: 55px;
        border-radius: 14px;
        background: rgba(0, 51, 102, 0.05); /* Very light blue tint */
        color: var(--primary-dark);
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 1.6rem;
        margin-bottom: 20px;
        transition: 0.3s;
    }

    .card:hover .card-icon {
        background: var(--primary-dark);
        color: #fff;
    }

    .card h3 { 
        font-size: 1.3rem; 
        margin-bottom: 8px; 
        color: #1a1a1a;
        font-weight: 600;
    }
    
    .card p { 
        color: var(--text-muted); 
        font-size: 0.95rem; 
        line-height: 1.5;
        margin-bottom: 20px;
    }
    
    .card-action {
        align-self: flex-start;
        color: var(--accent-blue);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: 0.3s;
        margin-top: auto;
    }
    
    .card-action:hover { 
        gap: 12px;
        color: var(--primary-dark);
    }

    /* Responsive */
    @media (max-width: 900px) {
        .sidebar {
            width: 80px;
            padding: 20px 10px;
            align-items: center;
        }
        .nav-item span, .logo span { display: none; }
        .main-content { margin-left: 80px; padding: 25px; }
        .search-bar { width: 100%; }
        .user-actions { gap: 15px; }
    }
    
    @media (max-width: 600px) {
        .sidebar { display: none; }
        .main-content { margin-left: 0; padding: 20px; }
        .dashboard-grid { grid-template-columns: 1fr; }
        .topbar { flex-direction: column; height: auto; gap: 15px; }
    }
</style>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<div class="dashboard-container">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="logo">
            <i class="fas fa-graduation-cap"></i>
            <span>StudentHub</span>
        </div>
        <ul class="nav-links">
            <li class="nav-item">
                <a href="{{ path('app_front') }}" class="{{ app.current_route == 'app_front' ? 'active' : '' }}">
                    <i class="fas fa-home"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="{{ path('app_temps') }}" class="{{ app.current_route == 'app_temps' ? 'active' : '' }}">
                    <i class="fas fa-calendar-alt"></i>
                    <span>Time Management</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="{{ path('app_courses') }}" class="{{ app.current_route == 'app_courses' ? 'active' : '' }}">
                    <i class="fas fa-book-open"></i>
                    <span>Courses</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="{{ path('app_objectives') }}" class="{{ app.current_route == 'app_objectives' ? 'active' : '' }}">
                    <i class="fas fa-bullseye"></i>
                    <span>Objectives</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="{{ path('app_groups_index') }}" class="{{ app.current_route == 'app_groups_index' ? 'active' : '' }}">
                    <i class="fas fa-users"></i>
                    <span>Groups</span>
                </a>
            </li>
            <li class="nav-item" style="margin-top: auto;">
                <a href="{{ path('app_logout') }}">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </a>
            </li>
        </ul>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Topbar -->
        <header class="topbar">
            <div class="search-bar">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Search for courses...">
            </div>
            <div class="user-actions">
                <div class="icon-btn">
                    <i class="fas fa-bell"></i>
                    <span class="notification-dot"></span>
                </div>
                <div class="profile-card">
                    <div class="avatar">SJ</div>
                    <div class="profile-info">
                        <span class="profile-name">Sami Jouini</span>
                        <span class="profile-role">Student</span>
                    </div>
                </div>
            </div>
        </header>

        {% block content %}{% endblock %}

    </main>
</div>
{% endblock %}
