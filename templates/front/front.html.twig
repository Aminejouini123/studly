{% extends 'front/base.html.twig' %}

{% block title %}Dashboard - Student Hub{% endblock %}

{% block content %}
<div class="dashboard-container">
    <!-- Welcome Banner with Glassmorphism -->
    <div class="welcome-banner">
        <div class="welcome-text">
            <h1>Welcome back, {{ app.user.firstName }}! 👋</h1>
            <p>You have made great progress this week. Keep it up!</p>
        </div>
        <div class="welcome-stats">
            <div class="stat-badge">
                <i class="fas fa-calendar-alt"></i>
                <span>{{ upcomingExamsCount }} Exam{{ upcomingExamsCount != 1 ? 's' : '' }} Upcoming</span>
            </div>
            <div class="stat-badge warning">
                <i class="fas fa-tasks"></i>
                <span>{{ pendingTasksCount }} Pending Task{{ pendingTasksCount != 1 ? 's' : '' }}</span>
            </div>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="fas fa-book-open"></i>
            </div>
            <div class="stat-info">
                <h3>{{ userCoursesCount }}</h3>
                <p>Your Courses</p>
            </div>
            <div class="stat-chart">
                <!-- Mini sparkline or visual decoration -->
                <div class="progress-bar-mini" style="width: 70%"></div>
            </div>
        </div>

        <div class="stat-card purple">
            <div class="stat-icon purple">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-info">
                <h3>{{ userEventsCount }}</h3>
                <p>Your Events</p>
            </div>
            <div class="stat-chart">
                <div class="progress-bar-mini" style="width: 45%"></div>
            </div>
        </div>

        <div class="stat-card green">
            <div class="stat-icon green">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-info">
                {% if topCourse %}
                    <h3>{{ topCourse.name }}</h3>
                    <p>Top course (by coefficient)</p>
                {% else %}
                    <h3>-</h3>
                    <p>No courses yet</p>
                {% endif %}
            </div>
            <div class="stat-chart">
                <div class="progress-bar-mini" style="width: 85%"></div>
            </div>
        </div>
        
        <div class="stat-card orange">
            <div class="stat-icon orange">
                <i class="fas fa-trophy"></i>
            </div>
            <div class="stat-info">
                <h3>{{ completedEventsCount }}</h3>
                <p>Completed</p>
            </div>
            <div class="stat-chart">
                <div class="progress-bar-mini" style="width: 60%"></div>
            </div>
        </div>
    </div>

    <!-- Main Content Split -->
    <div class="dashboard-split">
        <!-- Left Column: Activity & Schedule -->
        <div class="dashboard-main">
            <div class="section-header">
                <h2>Your Schedule</h2>
                <a href="{{ path('app_temps') }}" class="view-all">View Full Calendar <i class="fas fa-arrow-right"></i></a>
            </div>
            
            <div class="schedule-list">
                {% for event in upcomingEvents %}
                    <div class="schedule-row">
                        <div class="time-slot">
                            <span class="hour">{{ event.startTime ? event.startTime|date('H:i') : '00:00' }}</span>
                            <span class="period">{{ event.startTime ? event.startTime|date('A') : '' }}</span>
                        </div>
                        <div class="event-info">
                            <h4>{{ event.title }}</h4>
                            <span class="meta"><i class="fas fa-map-marker-alt"></i> {{ event.location }} • {{ event.type }}</span>
                        </div>
                        <div class="event-tag badge-blue">{{ event.priority }}</div>
                    </div>
                {% else %}
                    <div class="schedule-row">
                        <div class="event-info">
                            <p>No upcoming events scheduled.</p>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="section-card mt-4">
                <div class="section-header">
                    <h2><i class="fas fa-chart-line" style="color: var(--primary-dark); margin-right: 10px;"></i> Recent Progress</h2>
                </div>
                
                <div class="progress-list">
                    {% for course in recentCourses %}
                        <div class="progress-item">
                            <div class="course-thumb">
                                {% if 'react' in course.name|lower %}
                                    <i class="fab fa-react" style="color: #61dafb;"></i>
                                {% elseif 'symfony' in course.name|lower %}
                                    <i class="fab fa-symfony"></i>
                                {% else %}
                                    <i class="fas fa-book"></i>
                                {% endif %}
                            </div>
                            <div class="progress-info">
                                <div class="info-top">
                                    <h4>{{ course.name }}</h4>
                                    <span class="percentage">{{ course.getProgressPercentage() }}%</span>
                                </div>
                                <div class="progress-bar-main"><div class="fill" style="width: {{ course.getProgressPercentage() }}%"></div></div>
                            </div>
                            <a href="{{ path('app_course_show', {'id': course.id}) }}" class="btn-action">Continue</a>
                        </div>
                    {% else %}
                        <div class="progress-item">
                            <div class="progress-info">
                                <p>You haven't joined any courses yet.</p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- Sidebar Actions & Alerts -->
        <div class="dashboard-side-area">
            <div class="side-card">
                <h3>Quick Actions</h3>
                <div class="actions-grid">
                    <a href="{{ path('app_course_new') }}" class="action-item">
                        <div class="icon-box blue"><i class="fas fa-plus"></i></div>
                        <span>New Course</span>
                    </a>
                    <a href="{{ path('app_groups_index') }}" class="action-item">
                        <div class="icon-box purple"><i class="fas fa-users"></i></div>
                        <span>Join Group</span>
                    </a>
                    <a href="{{ path('app_temps') }}" class="action-item">
                        <div class="icon-box orange"><i class="fas fa-calendar-plus"></i></div>
                        <span>Add Event</span>
                    </a>
                    <a href="{{ path('app_objectives') }}" class="action-item">
                        <div class="icon-box green"><i class="fas fa-bullseye"></i></div>
                        <span>Set Goal</span>
                    </a>
                </div>
            </div>

            <!-- Notifications Card -->
            <div class="sidebar-card">
                <div class="card-header-small">
                    <h3>Notifications</h3>
                    <span class="badge-new">2 New</span>
                </div>
                <ul class="notification-list">
                    <li class="new">
                        <div class="notif-icon info"><i class="fas fa-info"></i></div>
                        <div class="notif-text">
                            <p><strong>System Update</strong> scheduled for tonight.</p>
                            <span class="time-ago">2 hours ago</span>
                        </div>
                    </li>
                    <li class="new">
                        <div class="notif-icon success"><i class="fas fa-check"></i></div>
                        <div class="notif-text">
                            <p><strong>Assignment</strong> "Database Schema" graded.</p>
                            <span class="time-ago">5 hours ago</span>
                        </div>
                    </li>
                    <li>
                        <div class="notif-icon warning"><i class="fas fa-exclamation"></i></div>
                        <div class="notif-text">
                            <p><strong>Exam Reminder</strong>: Java OOP tomorrow.</p>
                            <span class="time-ago">1 day ago</span>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<style>
    :root {
        --dash-bg: #f3f5f8;
        --dash-card-bg: #ffffff;
        --dash-primary: #4f46e5; /* Indigo */
        --dash-primary-light: #e0e7ff;
        --dash-text: #1f2937;
        --dash-text-muted: #6b7280;
        --dash-border: #e5e7eb;
    }

    .dashboard-container {
        padding-bottom: 50px;
    }

    /* Welcome Banner */
    .welcome-banner {
        background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);
        border-radius: 16px;
        padding: 40px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
        box-shadow: 0 10px 25px -5px rgba(79, 70, 229, 0.4);
        position: relative;
        overflow: hidden;
    }

    .welcome-banner::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -10%;
        width: 300px;
        height: 300px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
    }

    .welcome-banner::after {
        content: '';
        position: absolute;
        bottom: -50%;
        right: -10%;
        width: 200px;
        height: 200px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
    }

    .welcome-text h1 {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .welcome-text p {
        font-size: 1.1rem;
        opacity: 0.9;
    }

    .welcome-stats {
        display: flex;
        gap: 15px;
        position: relative;
        z-index: 1;
    }

    .stat-badge {
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        padding: 10px 20px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }
    
    .stat-badge.warning { background: rgba(251, 191, 36, 0.2); color: #fff; }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 25px;
        margin-bottom: 40px;
    }

    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 25px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        border: 1px solid var(--dash-border);
        transition: transform 0.2s;
        height: 160px;
    }

    .stat-card:hover { transform: translateY(-5px); box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        margin-bottom: 15px;
    }

    .stat-icon.blue { background: #e0e7ff; color: #4338ca; }
    .stat-icon.purple { background: #f3e8ff; color: #7e22ce; }
    .stat-icon.green { background: #dcfce7; color: #15803d; }
    .stat-icon.orange { background: #ffedd5; color: #c2410c; }

    .stat-info h3 { font-size: 1.8rem; font-weight: 700; margin: 0; color: var(--dash-text); }
    .stat-info p { font-size: 0.9rem; color: var(--dash-text-muted); margin: 0; }

    .progress-bar-mini { height: 4px; background: #e5e7eb; border-radius: 2px; margin-top: 15px; position: relative; overflow: hidden; }
    .progress-bar-mini::after { content: ''; position: absolute; top:0; left:0; height:100%; width: inherit; background: currentColor; border-radius: 2px; }
    .stat-card .progress-bar-mini { color: #4f46e5; }
    .stat-card.purple .progress-bar-mini { color: #9333ea; }
    .stat-card.green .progress-bar-mini { color: #22c55e; }
    .stat-card.orange .progress-bar-mini { color: #f97316; }

    /* Dashboard Split */
    .dashboard-split {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 30px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .section-header h2 { font-size: 1.25rem; font-weight: 700; color: var(--dash-text); margin: 0; }
    .view-all { font-size: 0.9rem; font-weight: 600; color: var(--dash-primary); text-decoration: none; }
    
    /* Schedule List */
    .schedule-row {
        background: white;
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 20px;
        border: 1px solid var(--dash-border);
        margin-bottom: 15px;
        transition: 0.2s;
    }
    
    .schedule-row:hover { border-color: var(--dash-primary-light); background: #f9fafb; }

    .time-slot {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: #f3f4f6;
        padding: 10px 15px;
        border-radius: 8px;
        min-width: 80px;
    }

    .time-slot .hour { font-weight: 700; font-size: 1.1rem; color: var(--dash-text); }
    .time-slot .period { font-size: 0.75rem; color: var(--dash-text-muted); text-transform: uppercase; }

    .event-info h4 { font-size: 1rem; font-weight: 600; margin: 0 0 5px 0; color: var(--dash-text); }
    .event-info .meta { font-size: 0.85rem; color: var(--dash-text-muted); margin: 0; }
    
    .event-tag { 
        margin-left: auto;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    .badge-blue { background: #e0e7ff; color: #4338ca; }
    .badge-pending { background: #fef3c7; color: #92400e; }

    /* Course Progress */
    .progress-item {
        background: white;
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 20px;
        border: 1px solid var(--dash-border);
        margin-bottom: 15px;
    }

    .course-thumb {
        width: 50px;
        height: 50px;
        border-radius: 10px;
        background: #1e293b;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .progress-info { flex: 1; }
    .progress-info h4 { font-size: 1rem; font-weight: 600; margin: 0 0 8px 0; }
    
    .info-top { display: flex; align-items: center; gap: 15px; justify-content: space-between; margin-bottom: 5px; }
    .progress-bar-main { flex: 1; height: 6px; background: #e5e7eb; border-radius: 3px; overflow: hidden; }
    .progress-bar-main .fill { height: 100%; background: var(--dash-primary); border-radius: 3px; }
    .percentage { font-size: 0.8rem; font-weight: 600; color: var(--dash-text-muted); }

    .btn-action {
        padding: 8px 16px;
        background: #f0fdf4;
        color: #166534;
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: 6px;
        text-decoration: none;
        border: 1px solid #bbf7d0;
        transition: 0.2s;
    }
    .btn-action:hover { background: #dcfce7; }
    
    .mt-5 { margin-top: 40px; }

    /* Sidebar Cards */
    .side-card, .sidebar-card {
        background: white;
        border-radius: 16px;
        padding: 25px;
        border: 1px solid var(--dash-border);
        margin-bottom: 30px;
    }
    
    .side-card h3, .sidebar-card h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 20px; color: var(--dash-text); }

    .actions-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .action-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 20px;
        background: #f9fafb;
        border-radius: 12px;
        text-decoration: none;
        color: var(--dash-text);
        font-size: 0.85rem;
        font-weight: 600;
        transition: 0.2s;
        border: 1px solid transparent;
        text-align: center;
    }
    
    .icon-box { 
        width: 40px; 
        height: 40px; 
        border-radius: 10px; 
        display: flex; 
        align-items: center; 
        justify-content: center;
        font-size: 1.1rem;
    }
    .icon-box.blue { background: #e0e7ff; color: #4338ca; }
    .icon-box.purple { background: #f3e8ff; color: #7e22ce; }
    .icon-box.orange { background: #ffedd5; color: #c2410c; }
    .icon-box.green { background: #dcfce7; color: #15803d; }

    .action-item:hover { background: white; border-color: var(--dash-primary); box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); }

    /* Notifications */
    .card-header-small { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .card-header-small h3 { margin: 0; }
    .badge-new { background: #fee2e2; color: #ef4444; padding: 2px 8px; border-radius: 10px; font-size: 0.75rem; font-weight: 700; }

    .notification-list { list-style: none; padding: 0; margin: 0; }
    .notification-list li {
        display: flex;
        gap: 15px;
        padding: 15px 0;
        border-bottom: 1px solid #f3f4f6;
    }
    .notification-list li:last-child { border-bottom: none; padding-bottom: 0; }
    
    .notif-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 0.9rem;
    }
    
    .notif-icon.info { background: #e0f2fe; color: #0284c7; }
    .notif-icon.success { background: #dcfce7; color: #16a34a; }
    .notif-icon.warning { background: #fef9c3; color: #ca8a04; }

    .notif-text p { font-size: 0.9rem; margin: 0 0 4px 0; line-height: 1.4; }
    .time-ago { font-size: 0.75rem; color: #9ca3af; }

    @media (max-width: 1024px) {
        .dashboard-split { grid-template-columns: 1fr; }
    }
    
    @media (max-width: 768px) {
        .welcome-banner { flex-direction: column; align-items: flex-start; gap: 20px; }
        .welcome-stats { width: 100%; justify-content: flex-start; flex-wrap: wrap; }
    }
</style>
{% endblock %}
