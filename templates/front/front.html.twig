{% extends 'front/base.html.twig' %}

{% block title %}Dashboard - Student Hub{% endblock %}

{% block content %}
<div class="dashboard-container">
    <!-- Welcome Banner with Glassmorphism -->
    <div class="welcome-banner">
        <div class="welcome-text">
            <h1>Welcome back, {{ app.user.firstName }}! 👋</h1>
            <p>You have made great progress this week. Keep it up!</p>
        </div>
        <div class="welcome-stats">
            <div class="stat-badge">
                <i class="fas fa-calendar-alt"></i>
                <span>3 Exams Upcoming</span>
            </div>
            <div class="stat-badge warning">
                <i class="fas fa-tasks"></i>
                <span>2 Pending Tasks</span>
            </div>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="fas fa-book-open"></i>
            </div>
            <div class="stat-info">
                <h3>4</h3>
                <p>Active Courses</p>
            </div>
            <div class="stat-chart">
                <!-- Mini sparkline or visual decoration -->
                <div class="progress-bar-mini" style="width: 70%"></div>
            </div>
        </div>

        <div class="stat-card purple">
            <div class="stat-icon purple">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-info">
                <h3>12h</h3>
                <p>Study Time</p>
            </div>
            <div class="stat-chart">
                <div class="progress-bar-mini" style="width: 45%"></div>
            </div>
        </div>

        <div class="stat-card green">
            <div class="stat-icon green">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-info">
                <h3>85%</h3>
                <p>Avg. Score</p>
            </div>
            <div class="stat-chart">
                <div class="progress-bar-mini" style="width: 85%"></div>
            </div>
        </div>
        
        <div class="stat-card orange">
            <div class="stat-icon orange">
                <i class="fas fa-trophy"></i>
            </div>
            <div class="stat-info">
                <h3>12</h3>
                <p>Completed</p>
            </div>
            <div class="stat-chart">
                <div class="progress-bar-mini" style="width: 60%"></div>
            </div>
        </div>
    </div>

    <!-- Main Content Split -->
    <div class="dashboard-split">
        <!-- Left Column: Activity & Schedule -->
        <div class="dashboard-main">
            <div class="section-header">
                <h2>Your Schedule</h2>
                <a href="{{ path('app_temps') }}" class="view-all">View Full Calendar <i class="fas fa-arrow-right"></i></a>
            </div>
            
            <div class="schedule-list">
                <!-- Dummy Data for Visuals -->
                <div class="schedule-item">
                    <div class="time-box">
                        <span class="time">10:00</span>
                        <span class="ampm">AM</span>
                    </div>
                    <div class="event-details">
                        <h4>Advanced Web Development</h4>
                        <p>Lecture • Room 304</p>
                    </div>
                    <div class="event-action">
                        <button class="btn-icon"><i class="fas fa-ellipsis-h"></i></button>
                    </div>
                </div>
                <div class="schedule-item">
                    <div class="time-box">
                        <span class="time">02:00</span>
                        <span class="ampm">PM</span>
                    </div>
                    <div class="event-details">
                        <h4>Database Design Workshop</h4>
                        <p>Lab • Room 102</p>
                    </div>
                    <div class="event-action">
                        <button class="btn-icon"><i class="fas fa-ellipsis-h"></i></button>
                    </div>
                </div>
            </div>

            <div class="section-header mt-5">
                <h2>Recent Progress</h2>
            </div>
            
            <div class="course-progress-list">
                <div class="course-item">
                    <div class="course-icon"><i class="fab fa-symfony"></i></div>
                    <div class="course-info">
                        <h4>Symfony Framework</h4>
                        <div class="progress-wrapper">
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: 75%"></div>
                            </div>
                            <span class="progress-text">75%</span>
                        </div>
                    </div>
                    <a href="#" class="btn-continue">Continue</a>
                </div>
                <div class="course-item">
                    <div class="course-icon"><i class="fab fa-react"></i></div>
                    <div class="course-info">
                        <h4>React JS Basics</h4>
                        <div class="progress-wrapper">
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: 40%"></div>
                            </div>
                            <span class="progress-text">40%</span>
                        </div>
                    </div>
                    <a href="#" class="btn-continue">Continue</a>
                </div>
            </div>
        </div>

        <!-- Right Column: Quick Actions & Notifications -->
        <div class="dashboard-sidebar">
            <!-- Quick Actions Card -->
            <div class="sidebar-card">
                <h3>Quick Actions</h3>
                <div class="quick-actions-grid">
                    <a href="{{ path('app_courses') }}" class="action-btn">
                        <i class="fas fa-plus"></i> New Course
                    </a>
                    <a href="{{ path('app_groups_index') }}" class="action-btn">
                        <i class="fas fa-users"></i> Join Group
                    </a>
                    <a href="{{ path('app_temps') }}" class="action-btn">
                        <i class="fas fa-calendar-plus"></i> Add Event
                    </a>
                    <a href="{{ path('app_objectives') }}" class="action-btn">
                        <i class="fas fa-flag"></i> Set Goal
                    </a>
                </div>
            </div>

            <!-- Notifications Card -->
            <div class="sidebar-card">
                <div class="card-header-small">
                    <h3>Notifications</h3>
                    <span class="badge-new">2 New</span>
                </div>
                <ul class="notification-list">
                    <li class="new">
                        <div class="notif-icon info"><i class="fas fa-info"></i></div>
                        <div class="notif-text">
                            <p><strong>System Update</strong> scheduled for tonight.</p>
                            <span class="time-ago">2 hours ago</span>
                        </div>
                    </li>
                    <li class="new">
                        <div class="notif-icon success"><i class="fas fa-check"></i></div>
                        <div class="notif-text">
                            <p><strong>Assignment</strong> "Database Schema" graded.</p>
                            <span class="time-ago">5 hours ago</span>
                        </div>
                    </li>
                    <li>
                        <div class="notif-icon warning"><i class="fas fa-exclamation"></i></div>
                        <div class="notif-text">
                            <p><strong>Exam Reminder</strong>: Java OOP tomorrow.</p>
                            <span class="time-ago">1 day ago</span>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --dash-bg: #f3f5f8;
        --dash-card-bg: #ffffff;
        --dash-primary: #4f46e5; /* Indigo */
        --dash-primary-light: #e0e7ff;
        --dash-text: #1f2937;
        --dash-text-muted: #6b7280;
        --dash-border: #e5e7eb;
    }

    .dashboard-container {
        padding-bottom: 50px;
    }

    /* Welcome Banner */
    .welcome-banner {
        background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);
        border-radius: 16px;
        padding: 40px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
        box-shadow: 0 10px 25px -5px rgba(79, 70, 229, 0.4);
        position: relative;
        overflow: hidden;
    }

    .welcome-banner::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -10%;
        width: 300px;
        height: 300px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
    }

    .welcome-banner::after {
        content: '';
        position: absolute;
        bottom: -50%;
        right: -10%;
        width: 200px;
        height: 200px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
    }

    .welcome-text h1 {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .welcome-text p {
        font-size: 1.1rem;
        opacity: 0.9;
    }

    .welcome-stats {
        display: flex;
        gap: 15px;
        position: relative;
        z-index: 1;
    }

    .stat-badge {
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        padding: 10px 20px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }
    
    .stat-badge.warning { background: rgba(251, 191, 36, 0.2); color: #fff; }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 25px;
        margin-bottom: 40px;
    }

    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 25px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        border: 1px solid var(--dash-border);
        transition: transform 0.2s;
        height: 160px;
    }

    .stat-card:hover { transform: translateY(-5px); box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        margin-bottom: 15px;
    }

    .stat-icon.blue { background: #e0e7ff; color: #4338ca; }
    .stat-icon.purple { background: #f3e8ff; color: #7e22ce; }
    .stat-icon.green { background: #dcfce7; color: #15803d; }
    .stat-icon.orange { background: #ffedd5; color: #c2410c; }

    .stat-info h3 { font-size: 1.8rem; font-weight: 700; margin: 0; color: var(--dash-text); }
    .stat-info p { font-size: 0.9rem; color: var(--dash-text-muted); margin: 0; }

    .progress-bar-mini { height: 4px; background: #e5e7eb; border-radius: 2px; margin-top: 15px; position: relative; overflow: hidden; }
    .progress-bar-mini::after { content: ''; position: absolute; top:0; left:0; height:100%; width: inherit; background: currentColor; border-radius: 2px; }
    .stat-card .progress-bar-mini { color: #4f46e5; }
    .stat-card.purple .progress-bar-mini { color: #9333ea; }
    .stat-card.green .progress-bar-mini { color: #22c55e; }
    .stat-card.orange .progress-bar-mini { color: #f97316; }

    /* Dashboard Split */
    .dashboard-split {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 30px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .section-header h2 { font-size: 1.25rem; font-weight: 700; color: var(--dash-text); margin: 0; }
    .view-all { font-size: 0.9rem; font-weight: 600; color: var(--dash-primary); text-decoration: none; }
    
    /* Schedule List */
    .schedule-item {
        background: white;
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 20px;
        border: 1px solid var(--dash-border);
        margin-bottom: 15px;
        transition: 0.2s;
    }
    
    .schedule-item:hover { border-color: var(--dash-primary-light); background: #f9fafb; }

    .time-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: #f3f4f6;
        padding: 10px 15px;
        border-radius: 8px;
        min-width: 80px;
    }

    .time-box .time { font-weight: 700; font-size: 1.1rem; color: var(--dash-text); }
    .time-box .ampm { font-size: 0.75rem; color: var(--dash-text-muted); text-transform: uppercase; }

    .event-details h4 { font-size: 1rem; font-weight: 600; margin: 0 0 5px 0; color: var(--dash-text); }
    .event-details p { font-size: 0.85rem; color: var(--dash-text-muted); margin: 0; }
    
    .event-action { margin-left: auto; }
    .btn-icon { background: none; border: none; color: #9ca3af; cursor: pointer; }

    /* Course Progress */
    .course-item {
        background: white;
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 20px;
        border: 1px solid var(--dash-border);
        margin-bottom: 15px;
    }

    .course-icon {
        width: 50px;
        height: 50px;
        border-radius: 10px;
        background: #1e293b;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .course-info { flex: 1; }
    .course-info h4 { font-size: 1rem; font-weight: 600; margin: 0 0 8px 0; }
    
    .progress-wrapper { display: flex; align-items: center; gap: 15px; }
    .progress-bar { flex: 1; height: 6px; background: #e5e7eb; border-radius: 3px; overflow: hidden; }
    .progress-fill { height: 100%; background: var(--dash-primary); border-radius: 3px; }
    .progress-text { font-size: 0.8rem; font-weight: 600; color: var(--dash-text-muted); }

    .btn-continue {
        padding: 8px 16px;
        background: #f0fdf4;
        color: #166534;
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: 6px;
        text-decoration: none;
        border: 1px solid #bbf7d0;
    }
    
    .mt-5 { margin-top: 40px; }

    /* Sidebar Cards */
    .sidebar-card {
        background: white;
        border-radius: 16px;
        padding: 25px;
        border: 1px solid var(--dash-border);
        margin-bottom: 30px;
    }
    
    .sidebar-card h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 20px; color: var(--dash-text); }

    .quick-actions-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .action-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 20px;
        background: #f9fafb;
        border-radius: 12px;
        text-decoration: none;
        color: var(--dash-text);
        font-size: 0.85rem;
        font-weight: 600;
        transition: 0.2s;
        border: 1px solid transparent;
        text-align: center;
    }
    
    .action-btn i { font-size: 1.2rem; color: var(--dash-primary); }
    .action-btn:hover { background: white; border-color: var(--dash-primary); box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); }

    /* Notifications */
    .card-header-small { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .card-header-small h3 { margin: 0; }
    .badge-new { background: #fee2e2; color: #ef4444; padding: 2px 8px; border-radius: 10px; font-size: 0.75rem; font-weight: 700; }

    .notification-list { list-style: none; padding: 0; margin: 0; }
    .notification-list li {
        display: flex;
        gap: 15px;
        padding: 15px 0;
        border-bottom: 1px solid #f3f4f6;
    }
    .notification-list li:last-child { border-bottom: none; padding-bottom: 0; }
    
    .notif-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 0.9rem;
    }
    
    .notif-icon.info { background: #e0f2fe; color: #0284c7; }
    .notif-icon.success { background: #dcfce7; color: #16a34a; }
    .notif-icon.warning { background: #fef9c3; color: #ca8a04; }

    .notif-text p { font-size: 0.9rem; margin: 0 0 4px 0; line-height: 1.4; }
    .time-ago { font-size: 0.75rem; color: #9ca3af; }

    @media (max-width: 1024px) {
        .dashboard-split { grid-template-columns: 1fr; }
        .dashboard-sidebar { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    }
    
    @media (max-width: 768px) {
        .welcome-banner { flex-direction: column; align-items: flex-start; gap: 20px; }
        .welcome-stats { width: 100%; justify-content: flex-start; flex-wrap: wrap; }
        .dashboard-sidebar { grid-template-columns: 1fr; }
    }
</style>
{% endblock %}
