{% extends 'front/base.html.twig' %}

{% block content %}
<style>
    .ai-header {
        background: linear-gradient(135deg, #00c6ff, #0072ff);
        color: white;
        padding: 30px;
        border-radius: 16px;
        margin-bottom: 30px;
        box-shadow: 0 4px 15px rgba(0, 198, 255, 0.3);
    }
    .ai-header h1 {
        margin-bottom: 10px;
        font-weight: 700;
        font-size: 2rem;
    }
    .ai-header p {
        font-size: 1.1rem;
        opacity: 0.9;
        margin-bottom: 20px;
    }
    .ai-btn {
        background: white;
        color: #0072ff;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .ai-btn:hover {
        background: #f0f0f0;
        transform: translateY(-2px);
    }
    .recommendation-section {
        margin-bottom: 40px;
    }
    .section-title {
        font-size: 1.5rem;
        margin-bottom: 20px;
        color: #003366;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
    }
    .rec-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        border: 1px solid #e9ecef;
        position: relative;
        overflow: hidden;
    }
    .rec-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: #00c6ff;
    }
    .rec-title {
        font-size: 1.2rem;
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: 10px;
    }
    .rec-company {
        color: #6c757d;
        font-size: 0.9rem;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .rec-score {
        position: absolute;
        top: 20px;
        right: 20px;
        background: #e0f8f1;
        color: #00a676;
        padding: 4px 10px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.9rem;
    }
    .rec-summary {
        font-size: 0.95rem;
        color: #495057;
        margin-bottom: 20px;
        line-height: 1.5;
    }
    .rec-link {
        display: inline-block;
        color: #0072ff;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.95rem;
    }
    .rec-link:hover {
        text-decoration: underline;
    }
    .profile-summary {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 30px;
        border-left: 4px solid #0056b3;
    }
    .alert-info {
        background: #e7f5ff;
        color: #004085;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
        border: 1px solid #b8daff;
    }
</style>

<div class="ai-header">
    <h1><i class="fas fa-magic"></i> AI Recommendations</h1>
    <p>Discover personalized job opportunities and courses based on your skills and education.</p>
    <a href="{{ path('app_recommendations_generate') }}" class="ai-btn">
        <i class="fas fa-sync-alt"></i> Generate New Recommendations
    </a>
</div>

<div class="profile-summary">
    <strong>Your Profile:</strong> 
    {% if app.user %}
        Skills: {{ app.user.skills ? app.user.skills|join(', ') : 'None specified' }} | 
        Education: {{ app.user.educationLevel ?: 'None specified' }} |
        Job Title: {{ app.user.jobTitle ?: 'None specified' }}
    {% endif %}
    <br><small><a href="{{ path('app_user_profile') }}">Edit Profile</a> to improve recommendations.</small>
</div>

{% if recommendations %}

    {% if recommendations.general_summary is defined and recommendations.general_summary %}
        <div class="alert-info">
            <strong><i class="fas fa-robot"></i> AI Summary:</strong> {{ recommendations.general_summary }}
        </div>
    {% endif %}

    <div class="recommendation-section">
        <h2 class="section-title"><i class="fas fa-briefcase"></i> Recommended Jobs</h2>
        <div class="grid">
            {% for job in recommendations.jobs|default([]) %}
                <div class="rec-card">
                    <div class="rec-score">{{ job.compatibility_score }}%</div>
                    <div class="rec-title">{{ job.title }}</div>
                    <div class="rec-company"><i class="fas fa-building"></i> {{ job.company_or_platform|default('Unknown') }}</div>
                    {% if job.strengths_match %}
                        <div style="font-size: 0.85rem; color: #00a676; margin-bottom: 5px;"><strong>Strengths:</strong> {{ job.strengths_match|join(', ') }}</div>
                    {% endif %}
                    {% if job.skills_gap %}
                        <div style="font-size: 0.85rem; color: #dc3545; margin-bottom: 10px;"><strong>Gap:</strong> {{ job.skills_gap|join(', ') }}</div>
                    {% endif %}
                    <div class="rec-summary">{{ job.personalized_summary }}</div>
                    {% if job.link %}
                        <a href="{{ job.link }}" target="_blank" class="rec-link">View Job <i class="fas fa-external-link-alt"></i></a>
                    {% endif %}
                </div>
            {% else %}
                <p>No job recommendations found.</p>
            {% endfor %}
        </div>
    </div>

    <div class="recommendation-section">
        <h2 class="section-title"><i class="fas fa-graduation-cap"></i> Recommended Courses</h2>
        <div class="grid">
            {% for course in recommendations.courses|default([]) %}
                <div class="rec-card">
                    <div class="rec-score" style="background: #e6f2ff; color: #0056b3;">{{ course.compatibility_score }}%</div>
                    <div class="rec-title">{{ course.title }}</div>
                    <div class="rec-company"><i class="fas fa-laptop-code"></i> {{ course.company_or_platform|default('Unknown') }}</div>
                    {% if course.strengths_match %}
                        <div style="font-size: 0.85rem; color: #0056b3; margin-bottom: 10px;"><strong>Why:</strong> {{ course.strengths_match|join(', ') }}</div>
                    {% endif %}
                    <div class="rec-summary">{{ course.personalized_summary }}</div>
                    {% if course.link %}
                        <a href="{{ course.link }}" target="_blank" class="rec-link">View Course <i class="fas fa-external-link-alt"></i></a>
                    {% endif %}
                </div>
            {% else %}
                <p>No course recommendations found.</p>
            {% endfor %}
        </div>
    </div>

{% else %}
    <div style="text-align: center; padding: 50px; background: white; border-radius: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
        <i class="fas fa-robot" style="font-size: 3rem; color: #00c6ff; margin-bottom: 20px;"></i>
        <h3>Ready to shape your future?</h3>
        <p style="color: #6c757d; margin-bottom: 20px;">Click the button below to let our AI analyze your profile and find the best matches.</p>
        <a href="{{ path('app_recommendations_generate') }}" class="ai-btn" style="background: #0072ff; color: white;">Generate Now</a>
    </div>
{% endif %}

{% endblock %}
