{% extends 'base.html.twig' %}

{% block title %}Reset password{% endblock %}

{% block body %}
<div style="min-height: 100vh; display:flex; align-items:center; justify-content:center; background: radial-gradient(circle at 10% 20%, rgb(0, 89, 169) 0%, rgb(0, 31, 63) 90%);">
    <div style="background: rgba(255,255,255,0.08); border-radius: 20px; padding: 30px 40px; width: 100%; max-width: 420px; color: #fff; box-shadow: 0 20px 40px rgba(0,0,0,0.3); backdrop-filter: blur(16px);">
        <h2 style="margin-bottom: 10px;">Choose a new password</h2>

        {% for message in app.flashes('error') %}
            <div style="background: rgba(255, 71, 87, 0.1); border-radius: 10px; padding: 10px 12px; margin-bottom: 10px; color:#ff6b81; font-size:0.9rem;">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('success') %}
            <div style="background: rgba(46, 213, 115, 0.1); border-radius: 10px; padding: 10px 12px; margin-bottom: 10px; color:#2ed573; font-size:0.9rem;">
                {{ message }}
            </div>
        {% endfor %}

        <form method="post" action="{{ path('app_reset_password', { token: token }) }}">
            <div style="margin-bottom: 15px;">
                <label for="password" style="display:block; margin-bottom:5px; font-size:0.95rem;">New password</label>
                <input type="password" id="password" name="password" required
                       style="width:100%; padding:10px 12px; border-radius:10px; border:none; outline:none; font-size:0.95rem; color:#222;">
            </div>

            <div style="margin-bottom: 15px;">
                <label for="password_confirm" style="display:block; margin-bottom:5px; font-size:0.95rem;">Confirm password</label>
                <input type="password" id="password_confirm" name="password_confirm" required
                       style="width:100%; padding:10px 12px; border-radius:10px; border:none; outline:none; font-size:0.95rem; color:#222;">
            </div>

            <button type="submit"
                    style="width:100%; border:none; padding:10px 0; border-radius:20px; background: linear-gradient(90deg, #003366, #0056b3); color:#fff; text-transform:uppercase; font-weight:600; cursor:pointer;">
                Reset password
            </button>
        </form>

        <p style="margin-top:15px; font-size:0.9rem; text-align:center;">
            <a href="{{ path('app_auth') }}" style="color:#fff; text-decoration:underline;">Back to login</a>
        </p>
    </div>
</div>
{% endblock %}

