{% extends 'base.html.twig' %}

{% block title %}Verify Email{% endblock %}

{% block body %}
<style>
    .verify-container {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: radial-gradient(circle at 10% 20%, rgb(0, 89, 169) 0%, rgb(0, 31, 63) 90%);
        font-family: 'Poppins', sans-serif;
    }

    .verify-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 3rem;
        border-radius: 20px;
        box-shadow: 0 25px 45px rgba(0,0,0,0.2);
        text-align: center;
        width: 100%;
        max-width: 500px;
        color: white;
    }

    .verify-card h2 {
        margin-bottom: 1.5rem;
        font-size: 2rem;
        font-weight: 700;
    }

    .verify-card p {
        margin-bottom: 2rem;
        opacity: 0.8;
    }

    .code-input {
        width: 100%;
        padding: 12px 20px;
        border-radius: 10px;
        border: none;
        background: #f0f4f8;
        font-size: 1.2rem;
        letter-spacing: 5px;
        text-align: center;
        margin-bottom: 1.5rem;
        color: #333;
        font-weight: 600;
    }

    .verify-btn {
        width: 100%;
        padding: 12px;
        border-radius: 50px;
        border: none;
        background: linear-gradient(90deg, #003366, #0056b3);
        color: white;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    .verify-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.3);
    }

    .error-msg {
        color: #ff4757;
        background: rgba(255, 71, 87, 0.1);
        padding: 10px;
        border-radius: 8px;
        margin-bottom: 1rem;
        font-size: 0.9rem;
    }
</style>

<div class="verify-container">
    <div class="verify-card">
        <h2>Verify Your Email</h2>
        <p>We've sent a 6-digit code to your email address. Please enter it below to continue.</p>

        {% if error %}
            <div class="error-msg">
                {{ error }}
            </div>
        {% endif %}

        <form method="post">
            <input type="text" name="code" class="code-input" placeholder="000000" maxlength="6" required autocomplete="off" autofocus>
            
            <button type="submit" class="verify-btn">Verify Account</button>
        </form>
    </div>
</div>
{% endblock %}
