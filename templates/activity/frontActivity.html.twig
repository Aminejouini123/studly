{% extends 'front/base.html.twig' %}

{% block title %}My Activities - {{ course.name }}{% endblock %}

{% block content %}
<div class="activities-container">
    <!-- En-tête -->
    <div class="header-section">
        <div class="header-content">
            <h1 class="page-title">{{ course.name }} - Activities</h1>
            <p class="page-subtitle">Practical work, assignments, and workshops</p>
        </div>
        <div style="display: flex; gap: 10px; align-items: center;">
            <a href="{{ path('app_courses') }}" class="btn-secondary btn-lg">
                <i class="fas fa-arrow-left"></i> Back to Courses
            </a>
            <button id="generate-activity-btn" class="btn-ai-generate" data-course-id="{{ course.id }}">
                <i class="fas fa-magic"></i>
                <span>Smart Generate</span>
            </button>
            <a href="{{ path('app_course_activity_new', {id: course.id}) }}" class="btn-primary btn-lg">
                <i class="fas fa-plus"></i> Add an Activity
            </a>
        </div>
    </div>

    <div class="stats-banner">
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-number">{{ activities|length }}</div>
                <div class="stat-label">Total Activities</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">
                    {{ activities|filter(a => a.status == 'to do')|length }}
                </div>
                <div class="stat-label">To Do</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">
                    {{ activities|filter(a => a.status == 'in progress')|length }}
                </div>
                <div class="stat-label">In Progress</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">
                    {{ activities|filter(a => a.status == 'completed')|length }}
                </div>
                <div class="stat-label">Completed</div>
            </div>
        </div>
    </div>
    <!-- Section Liste des Activités -->
    <div class="content-section">
        <div class="section-header">
            <h2><i class="fas fa-list-alt"></i> Activity List</h2>
            <div class="search-filter">
                <div class="search-box-wrapper">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="searchInput" class="search-box" placeholder="Search for an activity...">
                </div>
                <select id="statusFilter" class="filter-select">
                    <option value="">All statuses</option>
                    <option value="to do">To Do</option>
                    <option value="in progress">In Progress</option>
                    <option value="completed">Completed</option>
                </select>
            </div>
        </div>

        {% if activities|length > 0 %}
            <div class="activities-grid">
                {% for activity in activities %}
                    <div class="activity-card" data-status="{{ activity.status|lower }}">
                        <div class="card-status status-{{ activity.status|lower|replace({' ': '-'}) }}">
                            {{ activity.status|capitalize }}
                        </div>
                        <div class="card-header">
                            <a href="{{ path('app_activity_show', {id: activity.id}) }}" class="activity-title">{{ activity.title }}</a>
                            <p class="activity-desc">{{ activity.description|slice(0, 80) ~ (activity.description|length > 80 ? '...' : '') }}</p>
                        </div>
                        
                        <div class="activity-details">
                            <div class="detail-item">
                                <i class="far fa-clock"></i>
                                <span>{{ activity.duration }} min estimate</span>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-layer-group"></i>
                                <span>{{ activity.difficulty }}</span>
                            </div>
                             <div class="detail-item">
                                <i class="fas fa-graduation-cap"></i>
                                <span>{{ activity.level }}</span>
                            </div>
                        </div>

                        <div class="card-footer">
                            <div class="actions">
                                <a href="{{ path('app_activity_show', {id: activity.id}) }}" class="btn-text btn-view">View</a>
                                <a href="{{ path('app_activity_edit', {id: activity.id}) }}" class="btn-text btn-edit">Edit</a>
                                <button type="button" class="btn-text btn-delete" onclick="openDeleteModal({{ activity.id }})">Delete</button>
                                <form id="delete-form-{{ activity.id }}" method="POST" action="{{ path('app_activity_delete', {id: activity.id}) }}" style="display:none;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ activity.id) }}">
                                </form>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
             <div class="empty-state">
                <div class="empty-icon"><i class="fas fa-clipboard-list"></i></div>
                <h3>No activities found</h3>
                <p>You have not added any activities for this course yet.</p>
            </div>
        {% endif %}
    </div>
    <div id="toast-container" class="toast-container"></div>
    
    <!-- AI Generation Overlay -->
    <div id="gen-overlay" class="gen-overlay hidden">
        <div class="gen-loader-content">
            <div class="main-spinner">
                <div class="spinner-ring"></div>
                <div class="spinner-ring"></div>
                <div class="spinner-ring"></div>
                <i class="fas fa-magic magic-icon"></i>
            </div>
            <h3 id="gen-status-title">Generating Activity...</h3>
            <p id="gen-status-msg">Our AI is drafting a custom activity for your course.</p>
            <div class="gen-progress-bar">
                <div class="gen-progress-fill"></div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Toast Notifications System */
    .toast-container {
        position: fixed;
        top: 2rem;
        right: 2rem;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .toast {
        min-width: 300px;
        background: white;
        border-radius: 12px;
        padding: 1rem 1.5rem;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        display: flex;
        align-items: center;
        gap: 1rem;
        transform: translateX(120%);
        transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        border-left: 4px solid #0059A9;
    }

    .toast.show {
        transform: translateX(0);
    }

    .toast-success { border-left-color: #2e7d32; }
    .toast-error { border-left-color: #dc2626; }

    .toast-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .toast-success .toast-icon { background: #e8f5e9; color: #2e7d32; }
    .toast-error .toast-icon { background: #fee2e2; color: #dc2626; }

    .toast-content { flex: 1; }
    .toast-title { font-weight: 800; color: #1e293b; font-size: 0.95rem; }
    .toast-message { color: #64748b; font-size: 0.85rem; }

    :root {
        --sidebar-blue: #0059A9;
        --sidebar-dark: #01304f;
        --card-bg: #ffffff;
        --bg-light: #f5f9fd;
        --text-primary: #0b2e4a;
        --text-secondary: #6c757d;
        --accent-color: #00B4D8;
        --success-color: #2e7d32;
        --warning-color: #f57f17;
        --border-radius: 16px;
        --ai-grad: linear-gradient(135deg, #0059A9 0%, #00B4D8 100%);
    }

    .activities-container {
        padding: 2rem;
        background: linear-gradient(135deg, #f5f9fd 0%, #eef4f9 100%);
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Header Styles */
    .header-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--card-bg);
        padding: 1.5rem 2rem;
        border-radius: 12px;
        box-shadow: 0 6px 24px rgba(10, 45, 80, 0.06);
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 2rem;
        color: var(--text-primary);
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .page-subtitle {
        color: var(--text-secondary);
        font-size: 0.95rem;
    }

    .btn-primary {
        background: var(--sidebar-blue);
        color: white;
        border: none;
        padding: 0.8rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        text-decoration: none;
        box-shadow: 0 4px 12px rgba(0, 89, 169, 0.2);
    }

    .btn-primary:hover {
        background: var(--sidebar-dark);
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 89, 169, 0.3);
    }
    
    .btn-secondary {
        background: white;
        color: var(--sidebar-blue);
        border: 2px solid var(--sidebar-blue);
        padding: 0.8rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .btn-secondary:hover {
        background: var(--sidebar-blue);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(0, 89, 169, 0.15);
    }

    /* AI Button Styles */
    .btn-ai-generate {
        background: var(--ai-grad);
        color: white;
        border: none;
        padding: 0.8rem 1.5rem;
        border-radius: 99px;
        font-weight: 700;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 4px 15px rgba(0, 180, 216, 0.3);
    }

    .btn-ai-generate:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0, 180, 216, 0.4);
        filter: brightness(1.1);
    }

    .btn-ai-generate:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
        filter: grayscale(0.5);
    }

    .btn-ai-generate:active {
        transform: scale(0.98);
    }

    .btn-ai-generate i {
        font-size: 1.1rem;
        transition: transform 0.3s ease;
    }

    .btn-ai-generate:hover i {
        transform: rotate(15deg) scale(1.2);
    }

    .btn-ai-generate.loading i {
        animation: pulseIcon 1s ease-in-out infinite;
    }

    @keyframes pulseIcon {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.3); opacity: 0.7; }
    }

    /* Immersive Generation Overlay */
    .gen-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(8px);
        z-index: 10000;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        transition: opacity 0.5s;
    }

    .gen-overlay.hidden {
        opacity: 0;
        pointer-events: none;
        display: none;
    }

    .gen-loader-content {
        text-align: center;
        max-width: 400px;
    }

    .main-spinner {
        position: relative;
        width: 100px;
        height: 100px;
        margin: 0 auto 2rem;
    }

    .spinner-ring {
        position: absolute;
        width: 100%;
        height: 100%;
        border: 4px solid transparent;
        border-top-color: #0059A9;
        border-radius: 50%;
        animation: spin 2s cubic-bezier(0.5, 0, 0.5, 1) infinite;
    }
    .spinner-ring:nth-child(2) { animation-delay: -0.3s; border-top-color: #00B4D8; }
    .spinner-ring:nth-child(3) { animation-delay: -0.6s; border-top-color: #a855f7; }

    .magic-icon {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 2rem;
        color: #0059A9;
        animation: pulse 1.5s ease-in-out infinite;
    }

    #gen-status-title {
        font-family: 'Outfit', sans-serif;
        font-size: 1.8rem;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 0.5rem;
    }

    #gen-status-msg {
        color: #64748b;
        font-size: 1rem;
        margin-bottom: 2rem;
    }

    .gen-progress-bar {
        height: 6px;
        background: #e2e8f0;
        border-radius: 10px;
        overflow: hidden;
    }

    .gen-progress-fill {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, #0059A9, #00B4D8);
        transition: width 15s linear;
    }

    @keyframes spin { 100% { transform: rotate(360deg); } }
    @keyframes pulse {
        0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
        50% { transform: translate(-50%, -50%) scale(1.2); opacity: 0.7; }
    }

    /* Stats Banner */
    .stats-banner {
        background: linear-gradient(90deg, rgba(6,40,80,1) 0%, var(--sidebar-blue) 100%);
        padding: 1.5rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        box-shadow: 0 8px 30px rgba(0, 50, 100, 0.15);
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    .stat-card {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        padding: 1.25rem;
        border-radius: 10px;
        text-align: center;
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: transform 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        background: rgba(255, 255, 255, 0.15);
    }

    .stat-number {
        font-size: 2.5rem;
        font-weight: 800;
        color: #d2f0ea;
        margin-bottom: 0.25rem;
    }

    .stat-label {
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
    }

    /* Content Section */
    .content-section {
        background: var(--card-bg);
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1rem;
        border-bottom: 2px solid #f0f4f8;
        padding-bottom: 1rem;
    }

    .section-header h2 {
        font-size: 1.5rem;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .search-filter {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .search-box-wrapper {
        position: relative;
        width: 300px;
        max-width: 100%;
    }

    .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-secondary);
    }

    .search-box {
        width: 100%;
        padding: 0.7rem 1rem 0.7rem 2.5rem;
        border: 1px solid #e1e5ea;
        border-radius: 8px;
        outline: none;
        transition: border-color 0.3s;
        font-size: 0.95rem;
    }

    .search-box:focus {
        border-color: var(--sidebar-blue);
        box-shadow: 0 0 0 3px rgba(0, 89, 169, 0.1);
    }

    .filter-select {
        padding: 0.7rem 1rem;
        border: 1px solid #e1e5ea;
        border-radius: 8px;
        outline: none;
        background-color: white;
        cursor: pointer;
        font-size: 0.95rem;
    }

    /* Grid Layout */
    .activities-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    /* Activity Card */
    .activity-card {
        background: white;
        border-radius: 12px;
        border: 1px solid #e1e5ea;
        padding: 1.5rem;
        position: relative;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .activity-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        border-color: transparent;
    }

    .activity-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: var(--sidebar-blue);
        border-radius: 4px 0 0 4px;
    }

    .card-status {
        position: absolute;
        top: 1rem;
        right: 1rem;
        font-size: 0.75rem;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .status-to-do { background: #e3f2fd; color: #0277bd; }
    .status-in-progress { background: #fff8e1; color: var(--warning-color); }
    .status-completed { background: #e8f5e9; color: var(--success-color); }

    .card-header {
        margin-bottom: 1.2rem;
        padding-right: 4rem;
    }

    .activity-title {
        color: var(--text-primary);
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        text-decoration: none;
        display: block;
        transition: color 0.2s;
    }
    
    .activity-title:hover {
        color: var(--sidebar-blue);
    }
    
    .activity-desc {
        color: var(--text-secondary);
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .activity-details {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        margin-bottom: 1.5rem;
        flex: 1;
        background: #f8fafc;
        padding: 0.8rem;
        border-radius: 8px;
    }

    .detail-item {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        color: var(--text-secondary);
        font-size: 0.85rem;
        font-weight: 500;
    }

    .detail-item i {
        width: 20px;
        text-align: center;
        color: var(--sidebar-blue);
    }

    .card-footer {
        padding-top: 1rem;
        border-top: 1px solid #f0f4f8;
        display: flex;
        justify-content: flex-end;
    }
    
    .actions {
        display: flex;
        gap: 0.5rem;
    }

    .btn-text {
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        border: none;
        transition: all 0.2s;
        background: transparent;
    }

    .btn-view { color: #0059A9; background: #e3f2fd; }
    .btn-view:hover { background: #bbdefb; }

    .btn-edit { color: #e65100; background: #ffe0b2; }
    .btn-edit:hover { background: #ffcc80; }

    .btn-delete { color: #c62828; background: #ffcdd2; }
    .btn-delete:hover { background: #ef9a9a; }

    .actions form { display: flex; }
    
    .empty-state {
        text-align: center;
        padding: 4rem 1rem;
        color: var(--text-secondary);
    }
    
    .empty-icon {
        font-size: 3rem;
        color: #e1e5ea;
        margin-bottom: 1rem;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .header-section {
             flex-direction: column;
             text-align: center;
             gap: 1rem;
        }

        .search-filter { width: 100%; flex-direction: column; }
        .search-box-wrapper { width: 100%; }
        .section-header { flex-direction: column; align-items: stretch; }
    }
</style>

<!-- Premium Delete Confirmation Modal -->
<div id="deleteModal" class="modal-overlay">
    <div class="modal-content">
        <div class="modal-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h3>Confirm Deletion</h3>
        <p>Are you sure you want to delete this activity? This will remove all associated content. This action is irreversible.</p>
        <div class="modal-actions">
            <button class="btn-cancel" onclick="closeDeleteModal()">Cancel</button>
            <button class="btn-confirm" onclick="confirmDelete()">Delete Activity</button>
        </div>
    </div>
</div>

<!-- Question Count Modal -->
<div id="questionCountModal" class="modal-overlay">
    <div class="modal-content config-modal">
        <div class="modal-icon ai-icon">
            <i class="fas fa-magic"></i>
        </div>
        <h3>Custom Quiz Generation</h3>
        <p>Define your learning objectives and let AI do the rest.</p>
        
        <div class="config-grid">
            <!-- Activity Name -->
            <div class="config-item">
                <label><i class="fas fa-edit"></i> Activity Name</label>
                <div class="count-input-wrapper">
                    <input type="text" id="activity-name-input" placeholder="e.g. {{ course.name }} Quiz" class="config-select">
                </div>
            </div>

            <!-- Question Count -->
            <div class="config-item">
                <label><i class="fas fa-list-ol"></i> Question Count</label>
                <div class="count-input-wrapper">
                    <input type="number" id="question-count-input" min="1" max="25" value="10" class="count-input">
                </div>
            </div>

            <!-- Quiz Type -->
            <div class="config-item">
                <label><i class="fas fa-tasks"></i> Question Type</label>
                <select id="quiz-type-select" class="config-select">
                    <option value="multiple_choice">Multiple Choice</option>
                    <option value="true_false">True or False</option>
                    <option value="mixed">Mixed (MCQ & T/F)</option>
                </select>
            </div>

            <!-- Difficulty -->
            <div class="config-item">
                <label><i class="fas fa-layer-group"></i> Difficulty</label>
                <select id="difficulty-select" class="config-select">
                    <option value="Easy">Easy</option>
                    <option value="Medium" selected>Medium</option>
                    <option value="Hard">Hard</option>
                </select>
            </div>
        </div>

        <div class="modal-actions">
            <button class="btn-cancel" onclick="closeQuestionCountModal()">Cancel</button>
            <button id="confirm-generate-btn" class="btn-confirm btn-ai-modal">
                <i class="fas fa-sparkles"></i> Generate Activity
            </button>
        </div>
    </div>
</div>

<style>
    /* Premium Modal Styles */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(8px);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 9999;
        animation: fadeIn 0.3s ease;
    }

    .modal-content {
        background: white;
        padding: 2.5rem;
        border-radius: 24px;
        width: 90%;
        max-width: 450px;
        text-align: center;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
        animation: modalSlideUp 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @keyframes modalSlideUp { from { transform: translateY(30px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

    .modal-icon {
        width: 70px;
        height: 70px;
        background: #fee2e2;
        color: #ef4444;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin: 0 auto 1.5rem auto;
    }

    .modal-content h3 {
        color: #0f172a;
        font-size: 1.5rem;
        font-weight: 800;
        margin-bottom: 0.75rem;
    }

    .modal-content p {
        color: #64748b;
        line-height: 1.6;
        margin-bottom: 2rem;
        font-size: 1rem;
    }

    .modal-actions {
        display: flex;
        gap: 1rem;
    }

    .btn-cancel, .btn-confirm {
        flex: 1;
        padding: 1rem;
        border-radius: 14px;
        font-weight: 700;
        cursor: pointer;
        border: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .btn-cancel {
        background: #f1f5f9;
        color: #475569;
    }

    .btn-cancel:hover {
        background: #e2e8f0;
        transform: translateY(-2px);
    }

    .btn-confirm {
        background: #ef4444;
        color: white;
        box-shadow: 0 10px 15px -3px rgba(239, 68, 68, 0.3);
    }

    .btn-confirm:hover {
        background: #dc2626;
        transform: translateY(-2px);
        box-shadow: 0 15px 20px -3px rgba(239, 68, 68, 0.4);
    }

    /* Modal special for AI Config */
    .config-modal {
        max-width: 600px !important;
        padding: 2.5rem !important;
    }

    .config-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        margin: 2rem 0;
        text-align: left;
    }

    .config-item {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .config-item label {
        font-weight: 700;
        color: #1e293b;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .config-item label i {
        color: #0059A9;
    }

    .config-select, .count-input {
        padding: 0.8rem 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 600;
        color: #0f172a;
        background: #f8fafc;
        transition: all 0.2s;
        width: 100%;
        outline: none;
    }

    .config-select:focus, .count-input:focus {
        border-color: #00B4D8;
        background: white;
        box-shadow: 0 0 0 4px rgba(0, 180, 216, 0.1);
    }

    .count-input {
        text-align: center;
        font-size: 1.2rem;
    }

    .ai-icon {
        background: #e0f2fe !important;
        color: #0369a1 !important;
    }

    .btn-ai-modal {
        background: var(--ai-grad) !important;
        box-shadow: 0 4px 12px rgba(0, 180, 216, 0.2) !important;
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .btn-ai-modal:hover {
        filter: brightness(1.1);
        transform: translateY(-2px);
    }
</style>

<script>
    let activityIdToDelete = null;

    function openDeleteModal(id) {
        activityIdToDelete = id;
        const modal = document.getElementById('deleteModal');
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }

    function closeDeleteModal() {
        const modal = document.getElementById('deleteModal');
        modal.style.display = 'none';
        document.body.style.overflow = '';
        activityIdToDelete = null;
    }

    function confirmDelete() {
        if (activityIdToDelete) {
            document.getElementById('delete-form-' + activityIdToDelete).submit();
        }
    }

    function openQuestionCountModal() {
        document.getElementById('questionCountModal').style.display = 'flex';
    }

    function closeQuestionCountModal() {
        document.getElementById('questionCountModal').style.display = 'none';
    }

    // --- Smart Activity Generator Logic ---
    document.addEventListener('DOMContentLoaded', function() {
        const genBtn = document.getElementById('generate-activity-btn');
        const overlay = document.getElementById('gen-overlay');
        const progressFill = overlay?.querySelector('.gen-progress-fill');
        const statusMsg = document.getElementById('gen-status-msg');
        
        const loadingSteps = [
            "Analyse du contenu du cours...",
            "Élaboration des questions pédagogiques...",
            "Rédaction des explications détaillées...",
            "Mise en forme du quiz Studly...",
            "Finalisation de l'activité..."
        ];

        genBtn?.addEventListener('click', function() {
            openQuestionCountModal();
        });

        document.getElementById('confirm-generate-btn')?.addEventListener('click', async function() {
            const courseId = genBtn.dataset.courseId;
            const activityName = document.getElementById('activity-name-input').value;
            const questionCount = document.getElementById('question-count-input').value;
            const quizType = document.getElementById('quiz-type-select').value;
            const difficulty = document.getElementById('difficulty-select').value;
            
            closeQuestionCountModal();
            
            // UI Feedback
            genBtn.disabled = true;
            genBtn.classList.add('loading');
            overlay.classList.remove('hidden');
            if (progressFill) progressFill.style.width = '90%';
            
            let currentStep = 0;
            const messageInterval = setInterval(() => {
                currentStep = (currentStep + 1) % loadingSteps.length;
                if (statusMsg) {
                    statusMsg.style.opacity = 0;
                    setTimeout(() => {
                        statusMsg.textContent = loadingSteps[currentStep];
                        statusMsg.style.opacity = 1;
                    }, 300);
                }
            }, 3000);

            try {
                const response = await fetch(`/ai/generate-activity/${courseId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        activityName: activityName,
                        questionCount: parseInt(questionCount),
                        quizType: quizType,
                        difficulty: difficulty
                    })
                });

                const data = await response.json();

                if (data.success) {
                    if (progressFill) progressFill.style.transition = 'width 0.3s';
                    if (progressFill) progressFill.style.width = '100%';
                    showToast('Succès !', 'L\'IA a généré votre quiz.', 'success');
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    overlay.classList.add('hidden');
                    this.disabled = false;
                    this.classList.remove('loading');
                    showToast('Erreur', data.error || 'Échec de la génération.', 'error');
                }
            } catch (err) {
                console.error(err);
                overlay.classList.add('hidden');
                this.disabled = false;
                this.classList.remove('loading');
                showToast('Erreur de connexion', 'Veuillez réessayer.', 'error');
            } finally {
                clearInterval(messageInterval);
            }
        });

        function showToast(title, message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;
            
            const icon = type === 'success' ? 'fa-check' : 'fa-exclamation-circle';
            
            toast.innerHTML = `
                <div class="toast-icon"><i class="fas ${icon}"></i></div>
                <div class="toast-content">
                    <div class="toast-title">${title}</div>
                    <div class="toast-message">${message}</div>
                </div>
            `;
            
            container.appendChild(toast);
            
            // Trigger animation
            setTimeout(() => toast.classList.add('show'), 100);
            
            // Remove after 4s
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 400);
            }, 4000);
        }
    });

    // Close on click outside
    document.getElementById('deleteModal')?.addEventListener('click', function(e) {
        if (e.target === this) {
            closeDeleteModal();
        }
    });

    document.getElementById('searchInput').addEventListener('keyup', function() {
        const searchText = this.value.toLowerCase();
        filterCards(searchText, document.getElementById('statusFilter').value.toLowerCase());
    });

    document.getElementById('statusFilter').addEventListener('change', function() {
        const status = this.value.toLowerCase();
        filterCards(document.getElementById('searchInput').value.toLowerCase(), status);
    });

    function filterCards(text, status) {
        document.querySelectorAll('.activity-card').forEach(card => {
            const title = card.querySelector('.activity-title').innerText.toLowerCase();
            const desc = card.querySelector('.activity-desc').innerText.toLowerCase();
            const cardStatus = card.dataset.status.toLowerCase();
            
            const matchesText = title.includes(text) || desc.includes(text);
            const matchesStatus = status === '' || cardStatus === status;

            card.style.display = (matchesText && matchesStatus) ? 'flex' : 'none';
        });
    }
</script>
{% endblock %}
