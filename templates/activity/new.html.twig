{% extends 'front/base.html.twig' %}

{% block title %}Add Activity - {{ course.name }}{% endblock %}

{% block content %}
<div class="course-form-container">
    <!-- En-tête -->
    <div class="form-header">
        <div style="margin-bottom: 20px;">
             <a href="{{ path('app_course_activities', {'id': course.id}) }}" class="btn-back-custom">
                <i class="fas fa-arrow-left"></i> Back to Activities
            </a>
        </div>
        <div class="header-content">
            <h1 class="page-title">Add an Activity</h1>
            <p class="page-subtitle">Course: <strong>{{ course.name }}</strong></p>
        </div>
    </div>

    <!-- Formulaire -->
    <div class="form-card">
        {{ form_start(form, {'attr': {'class': 'course-form'}}) }}
        
        <!-- General Info Section -->
        <div class="form-section">
            <h3 class="section-title"><i class="fas fa-info-circle"></i> Activity Information</h3>
            <div class="form-grid">
                <div class="form-group">
                    {{ form_label(form.title, 'Activity Title', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.title, {'attr': {'class': 'form-input', 'placeholder': 'Ex: Lab 1, Workshop...'}}) }}
                    {{ form_errors(form.title) }}
                </div>
                
                 <div class="form-group">
                    {{ form_label(form.status, 'Status', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.status, {'attr': {'class': 'form-input'}}) }}
                     {{ form_errors(form.status) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.type, 'Activity Type', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.type, {'attr': {'class': 'form-input'}}) }}
                    {{ form_errors(form.type) }}
                </div>
            </div>
            
            <div class="form-group full-width" style="margin-top: 1.5rem;">
                {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'form-input form-textarea', 'rows': 4, 'placeholder': 'Detail the objectives and instructions...'}}) }}
                {{ form_errors(form.description) }}
            </div>
        </div>

        <!-- Details Section -->
        <div class="form-section">
            <h3 class="section-title"><i class="fas fa-sliders-h"></i> Configuration</h3>
            <div class="form-grid">
                 <div class="form-group">
                     {{ form_label(form.duration, 'Duration (min)', {'label_attr': {'class': 'form-label'}}) }}
                     {{ form_widget(form.duration, {'attr': {'class': 'form-input', 'placeholder': '60'}}) }}
                     {{ form_errors(form.duration) }}
                </div>
                 <div class="form-group">
                    {{ form_label(form.difficulty, 'Difficulty', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.difficulty, {'attr': {'class': 'form-input'}}) }}
                    {{ form_errors(form.difficulty) }}
                </div>
                 <div class="form-group">
                    {{ form_label(form.level, 'Level', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.level, {'attr': {'class': 'form-input'}}) }}
                    {{ form_errors(form.level) }}
                </div>
            </div>
        </div>

        <!-- content & Instructions Section -->
        <div class="form-section">
            <h3 class="section-title"><i class="fas fa-list-ol"></i> Content & Details</h3>
            <div class="form-group full-width">
                {{ form_label(form.instructions, 'Detailed Instructions', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.instructions, {'attr': {'class': 'form-input form-textarea', 'rows': 6, 'placeholder': 'Detailed steps for the student...'}}) }}
                {{ form_errors(form.instructions) }}
            </div>
            <div class="form-grid" style="margin-top: 1.5rem;">
                <div class="form-group">
                    {{ form_label(form.expectedOutput, 'Expected Output', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.expectedOutput, {'attr': {'class': 'form-input', 'placeholder': 'What should they produce?'}}) }}
                    {{ form_errors(form.expectedOutput) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.hints, 'Hints', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.hints, {'attr': {'class': 'form-input', 'placeholder': 'Helpful tips...'}}) }}
                    {{ form_errors(form.hints) }}
                </div>
            </div>
        </div>

        <!-- Resources Section -->
        <div class="form-section">
            <h3 class="section-title"><i class="fas fa-paperclip"></i> Resources & Links</h3>
            <div class="form-grid">
                <div class="form-group">
                    {{ form_label(form.link, 'External Link', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.link, {'attr': {'class': 'form-input', 'placeholder': 'https://...'}}) }}
                    {{ form_errors(form.link) }}
                </div>
                
                <div class="form-group">
                    {{ form_label(form.file, 'Attached File (PDF, Docx)', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.file, {'attr': {'class': 'form-input', 'style': 'padding: 0.7rem;'}}) }}
                    {{ form_errors(form.file) }}
                    <small class="text-muted" style="margin-top: 0.5rem; display: block; font-size: 0.85rem; color: #6c757d;">Course materials, instructions, etc.</small>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">
                <i class="fas fa-save"></i> Save Activity
            </button>
            <a href="{{ path('app_course_activities', {id: course.id}) }}" class="btn-cancel">
                Cancel
            </a>
        </div>

        {{ form_end(form) }}
    </div>
</div>

<style>
    /* Using variables based on the new standard design */
    
    .course-form-container {
        padding: 0;
        background-color: #f8f9fa;
        min-height: 100vh;
        font-family: 'Poppins', sans-serif;
        padding-bottom: 4rem;
        padding-top: 2rem;
    }

    .form-header {
        display: flex;
        flex-direction: column;
        background: var(--sidebar-bg);
        padding: 3rem 2rem 8rem 2rem;
        color: white;
        margin: 0 auto;
        position: relative;
        z-index: 1;
        width: 95%;
        max-width: 1250px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 51, 102, 0.15);
    }
    
    .form-header > div:first-child {
        margin-bottom: 1.5rem;
        width: 100%;
    }

    .header-content {
        text-align: center;
        max-width: 800px;
        margin: 0 auto;
    }

    .header-content h1 {
        font-size: 2.5rem;
        color: #ffffff;
        margin-bottom: 0.8rem;
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    .page-subtitle {
        color: rgba(255, 255, 255, 0.9);
        font-size: 1.1rem;
        font-weight: 300;
        line-height: 1.6;
        max-width: 600px;
        margin: 0 auto;
    }
    
    .page-subtitle strong {
        color: white;
        font-weight: 600;
        background: rgba(255,255,255,0.1);
        padding: 0.2rem 0.6rem;
        border-radius: 6px;
    }

    /* Carte du formulaire */
    .form-card {
        background: #FFFFFF;
        border-radius: 20px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
        padding: 4rem;
        width: 95%; 
        max-width: 1250px;
        margin: -5rem auto 0 auto;
        position: relative;
        z-index: 10;
        border: 1px solid rgba(0,0,0,0.02);
    }
    
    /* Accent line */
    .form-card::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 6px;
        background: linear-gradient(90deg, #00c6ff, #0072ff);
        border-radius: 20px 20px 0 0;
    }

    .course-form {
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    /* Section styling */
    .form-section {
        border-bottom: 1px solid #e9ecef;
        padding-bottom: 2.5rem;
        margin-bottom: 1rem;
    }
    
    .form-section:last-child {
        border-bottom: none;
        padding-bottom: 0;
        margin-bottom: 0;
    }

    .section-title {
        font-size: 1.25rem;
        color: var(--primary-dark, #003366);
        font-weight: 700;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 0.8rem;
        padding-left: 0.5rem;
        border-left: 4px solid #00c6ff;
        line-height: 1;
    }
    
    .section-title i {
        color: var(--primary-light, #00c6ff);
        font-size: 1.1em;
    }

    /* Grille du formulaire */
    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        column-gap: 3rem;
        row-gap: 2rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
    }

    .form-group.full-width {
        grid-column: 1 / -1;
    }

    .form-group label {
        font-weight: 600;
        color: #344767;
        font-size: 0.95rem;
        margin-left: 0.2rem;
    }

    /* Inputs et Selects */
    .form-input {
        padding: 1rem 1.2rem;
        border: 1px solid #d2d6da;
        border-radius: 12px;
        font-size: 1rem;
        font-family: 'Poppins', sans-serif;
        transition: all 0.2s ease;
        background: #fff;
        color: #495057;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }
    
    .form-input::placeholder {
        color: #adb5bd;
    }

    .form-input:focus {
        outline: none;
        border-color: #35d1f5;
        box-shadow: 0 0 0 4px rgba(53, 209, 245, 0.15);
    }
    
    .form-input:hover {
        border-color: #b1b7c1;
    }
    
    .form-textarea {
        resize: vertical;
        min-height: 140px;
        line-height: 1.6;
    }

    /* Erreurs de validation */
    .form-group .form-error,
    .form-group ul {
        color: #ea0606;
        font-size: 0.85rem;
        margin-top: 0.4rem;
        font-weight: 500;
        padding-left: 0;
        list-style: none;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }
    
    .form-group .form-error::before {
        content: '⚠';
    }

    /* Boutons d'action */
    .form-actions {
        display: flex;
        gap: 1.5rem;
        justify-content: flex-end;
        padding-top: 2rem;
        border-top: 1px solid #f0f0f0;
        align-items: center;
    }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;
        padding: 1rem 3rem;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        font-weight: 600;
        font-size: 1.05rem;
        transition: all 0.2s ease;
        letter-spacing: 0.3px;
        background: linear-gradient(135deg, #003366 0%, #004080 100%);
        color: white;
        box-shadow: 0 4px 6px rgba(0, 51, 102, 0.2);
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 15px rgba(0, 51, 102, 0.25);
    }

    .btn-submit:active {
        transform: translateY(0);
    }
    
    .btn-cancel {
        display: inline-flex;
        align-items: center;
        padding: 0.8rem 1.5rem;
        border-radius: 12px;
        color: #6c757d;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }
    
    .btn-cancel:hover {
        color: #343a40;
        background: #f1f3f5;
    }

    /* Back Custom Button - White Pill */
    .btn-back-custom {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.7rem 1.5rem;
        border-radius: 50px;
        background: rgba(255, 255, 255, 0.2);
        color: white;
        font-weight: 600;
        text-decoration: none;
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        transition: all 0.2s ease;
        font-size: 0.95rem;
        width: fit-content;
    }

    .btn-back-custom:hover {
        background: white;
        color: #003366;
        transform: translateX(-2px);
    }
    
    .btn-back-custom i {
        font-size: 0.95rem;
    }

    /* Responsive */
    @media (max-width: 1200px) {
        .form-card {
            max-width: 95%;
            padding: 3rem;
        }
    }

    @media (max-width: 768px) {
        .form-header {
            padding: 1.5rem 1.5rem 6rem 1.5rem;
            width: 95%;
            border-radius: 16px;
        }

        .header-content h1 {
            font-size: 2rem;
        }
        
        .form-card {
            padding: 2rem;
            margin-top: -4rem;
            width: 95%;
            border-radius: 16px;
        }

        .form-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }
        
        .form-section {
            padding-bottom: 2rem;
        }

        .btn-submit {
            width: 100%;
            justify-content: center;
        }
        
        .form-actions {
            flex-direction: column-reverse;
            gap: 1rem;
        }
    }
</style>
{% endblock %}
