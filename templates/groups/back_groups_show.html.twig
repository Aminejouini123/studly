{% extends 'back/base.html.twig' %}

{% block title %}Group Details{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_admin_groups_index') }}">Groups</a> / <span>Details</span>
{% endblock %}

{% block content %}
<div class="dashboard-content">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div>
            <h1 class="page-title" style="margin-bottom: 8px;">{{ group.category }}</h1>
            <div style="display: flex; gap: 12px; align-items: center;">
                <span class="status-badge {{ not group.members.isEmpty ? 'status-active' : 'status-pending' }}">
                    <i class="fas {{ not group.members.isEmpty ? 'fa-check-circle' : 'fa-clock' }}" style="font-size: 0.7rem; margin-right: 4px;"></i>
                    {{ not group.members.isEmpty ? 'Assigned' : 'Unassigned' }}
                </span>
                <span style="color: var(--text-muted); font-size: 0.9rem; font-weight: 500;">
                    <i class="fas fa-calendar-alt"></i> Created on {{ group.createdAt ? group.createdAt|date('M d, Y') : 'N/A' }}
                </span>
            </div>
        </div>
        <div style="display: flex; gap: 12px;">
            <a href="{{ path('app_admin_groups_index') }}" class="btn-secondary">
                <i class="fas fa-arrow-left"></i> Back
            </a>
            <a href="{{ path('app_admin_groups_edit', {'id': group.id}) }}" class="btn-action">
                <i class="fas fa-edit"></i> Edit Group
            </a>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-header">
                <div class="stat-icon blue" style="background: linear-gradient(135deg, #eff6ff, #dbeafe);"><i class="fas fa-users"></i></div>
            </div>
            <div class="stat-value">{{ group.capacity }} members</div>
            <div class="stat-label">Total Capacity</div>
        </div>
        <div class="stat-card">
            <div class="stat-header">
                <div class="stat-icon green" style="background: linear-gradient(135deg, #f0fdf4, #dcfce7);"><i class="fas fa-check-circle"></i></div>
            </div>
            <div class="stat-value">{{ not group.members.isEmpty ? 'Active' : 'Pending' }}</div>
            <div class="stat-label">Current Status</div>
        </div>
        <div class="stat-card">
            <div class="stat-header">
                <div class="stat-icon purple" style="background: linear-gradient(135deg, #faf5ff, #f3e8ff);"><i class="fas fa-calendar-alt"></i></div>
            </div>
            <div class="stat-value">{{ group.createdAt|date('d M Y') }}</div>
            <div class="stat-label">Creation Date</div>
        </div>
    </div>

    <div class="content-card">
        <div class="card-header">
            <h3><i class="fas fa-info-circle" style="color: var(--admin-accent); margin-right: 8px;"></i> About this Group</h3>
        </div>
            <div style="padding: 24px; display: flex; gap: 40px; flex-wrap: wrap;">
                 <div style="flex: 1; max-width: 300px;">
                    {% if group.groupPhoto %}
                        <img src="{{ group.groupPhoto }}" alt="{{ group.category }}" style="width: 100%; border-radius: 8px; border: 1px solid var(--admin-border);">
                    {% else %}
                        <div style="width: 100%; aspect-ratio: 16/9; background: #f1f5f9; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #cbd5e1; font-size: 3rem; border: 1px solid var(--admin-border);">
                            <i class="fas fa-image"></i>
                        </div>
                    {% endif %}
                    
                    <div style="margin-top: 20px; padding: 16px; background: #f8fafc; border-radius: 8px; border: 1px solid var(--admin-border);">
                        <div style="font-size: 0.85rem; color: var(--admin-text-muted); text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; margin-bottom: 12px;">Created By</div>
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="width: 40px; height: 40px; background: var(--admin-accent); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600;">
                                {{ group.creator.firstName|first }}{{ group.creator.lastName|first }}
                            </div>
                            <div>
                                <div style="font-weight: 600; color: var(--admin-text-main);">{{ group.creator.firstName }} {{ group.creator.lastName }}</div>
                                <div style="font-size: 0.85rem; color: var(--admin-text-muted);">{{ group.creator.email }}</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div style="flex: 2; min-width: 300px;">
                    <div style="margin-bottom: 32px;">
                        <h4 style="font-size: 1.1rem; margin-bottom: 12px; color: var(--admin-text-main);">Description</h4>
                        <p style="color: #475569; line-height: 1.6;">
                            This is a study group focused on <strong>{{ group.category }}</strong>. 
                            It was established to foster collaboration and academic growth among students.
                            {% if group.capacity > 0 %}
                                With a capacity of <strong>{{ group.capacity }}</strong> students, it offers a focused environment for learning.
                            {% endif %}
                        </p>
                    </div>

                    {% if not group.members.isEmpty %}
                    <div>
                        <h4 style="font-size: 1.1rem; margin-bottom: 12px; color: var(--admin-text-main);">Members</h4>
                        <div style="padding: 16px; border: 1px solid var(--admin-border); border-radius: 8px;">
                            <ul style="margin: 0; padding-left: 20px;">
                                {% for member in group.members %}
                                    <li style="margin-bottom: 5px;">{{ member.firstName }} {{ member.lastName }} ({{ member.email }})</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}
