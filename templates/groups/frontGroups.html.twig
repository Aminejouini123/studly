{% extends 'front/base.html.twig' %}

{% block title %}Mes Groupes{% endblock %}

{% block content %}
<div class="courses-container">
    <!-- En-tête - same as Courses -->
    <div class="courses-header">
        <div class="header-content">
            <h1 class="page-title">Mes Groupes</h1>
            <p class="page-subtitle">Gérez et suivez tous vos groupes d'étude en un seul endroit</p>
        </div>
        <a href="{{ path('app_groups_new') }}" class="btn-primary btn-lg">
            <i class="icon">➕</i> Ajouter un Groupe
        </a>
    </div>

    <!-- Flash Messages - same style as Courses -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}" style="padding: 15px; margin-bottom: 20px; border: 1px solid transparent; border-radius: 4px; {% if label == 'success' %}color: #155724; background-color: #d4edda; border-color: #c3e6cb;{% else %}color: #721c24; background-color: #f8d7da; border-color: #f5c6cb;{% endif %}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Statistiques rapides - same banner as Courses -->
    <div class="stats-banner">
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-number">{{ groups|length }}</div>
                <div class="stat-label">Groupes Total</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">{{ assigned_count|default(0) }}</div>
                <div class="stat-label">Assignés</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">{{ (groups|length) - (assigned_count|default(0)) }}</div>
                <div class="stat-label">Libres</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">{{ total_capacity|default(0) }}</div>
                <div class="stat-label">Capacité totale</div>
            </div>
        </div>
    </div>

    <!-- Section liste - same as Courses -->
    <div class="courses-section">
        <div class="section-header">
            <h2>Liste des Groupes</h2>
            <div class="search-filter">
                <form action="{{ path('app_groups_index') }}" method="GET" style="display: flex; flex: 1; gap: 10px;">
                    <input type="text" name="q" id="searchInput" class="search-box" placeholder="Rechercher par catégorie..." value="{{ search_term|default('') }}">
                    <button type="submit" class="btn-primary" style="padding: 0.5rem 1rem;"><i class="fas fa-search"></i></button>
                    {% if search_term %}
                        <a href="{{ path('app_groups_index') }}" class="btn-secondary-custom" style="display: flex; align-items: center; padding: 0.5rem 1rem; border-radius: 8px; text-decoration: none;"><i class="fas fa-times"></i></a>
                    {% endif %}
                </form>
            </div>
        </div>

        {% if groups|length > 0 %}
            <div class="courses-grid">
                {% for group in groups %}
                    <div class="course-card" data-category="{{ group.category|lower }}">
                        <div class="card-header-row">
                            <h3 class="course-title">{{ group.category }}</h3>
                            <span class="status-badge {{ not group.members.isEmpty ? 'status-terminé' : 'status-en-attente' }}">
                                {{ not group.members.isEmpty ? 'Assigné' : 'Libre' }}
                            </span>
                        </div>

                        <div class="teacher-info">
                            <i class="fas fa-user"></i>
                            <span>{{ group.creator.firstName }} {{ group.creator.lastName }}</span>
                        </div>

                        <div class="info-grid-row">
                            <div class="info-metric">
                                <div class="metric-icon"><i class="fas fa-users"></i></div>
                                <span class="metric-value">{{ group.capacity }} places</span>
                            </div>
                            <div class="info-metric">
                                <div class="metric-icon"><i class="fas fa-calendar-alt"></i></div>
                                <span class="metric-value">{{ group.createdAt|date('d/m/Y') }}</span>
                            </div>
                            <div class="info-metric">
                                <div class="metric-icon"><i class="fas fa-image"></i></div>
                                <span class="metric-value">{{ group.groupPhoto ? 'Photo' : '—' }}</span>
                            </div>
                        </div>

                        <div class="tags-row">
                            <span class="tag tag-type">Groupe</span>
                        </div>

                        <a href="{{ path('app_groups_show', {id: group.id}) }}" class="btn-details-main">
                            Voir les détails <i class="fas fa-arrow-right"></i>
                        </a>

                        <div class="card-footer-actions">
                            <a href="{{ path('app_groups_edit', {id: group.id}) }}" class="btn-action btn-edit-sub">
                                <i class="fas fa-edit"></i> Modifier
                            </a>
                            <button type="button" class="btn-action btn-delete-sub" onclick="openDeleteModal({{ group.id }})">
                                <i class="fas fa-trash-alt"></i> Supprimer
                            </button>
                            <form id="delete-form-{{ group.id }}" method="POST" action="{{ path('app_groups_delete', {id: group.id}) }}" style="display:none;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ group.id) }}">
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state">
                <div class="empty-icon-container">
                    <i class="fas fa-users" style="font-size: 2.5rem;"></i>
                </div>
                <h3>Aucun groupe trouvé</h3>
                <p>Vous n'avez pas encore créé de groupe. Créez votre premier groupe d'étude dès maintenant!</p>
                <a href="{{ path('app_groups_new') }}" class="btn-primary btn-lg pulse-animation">
                    <i class="fas fa-plus-circle"></i> Créer mon premier groupe
                </a>
            </div>
        {% endif %}
    </div>
</div>

<style>
    .courses-container { padding: 2rem; background: linear-gradient(135deg, #f5f9fd 0%, #eef4f9 100%); min-height: 100vh; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    .courses-header { display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 1.5rem 2rem; border-radius: 12px; margin-bottom: 1.25rem; box-shadow: 0 6px 24px rgba(10, 45, 80, 0.06); }
    .header-content h1 { font-size: 2rem; color: #0b2e4a; margin-bottom: 0.25rem; }
    .page-subtitle { color: #6c757d; font-size: 0.95rem; }
    .btn-primary { display: inline-flex; align-items: center; gap: 0.5rem; background: #0059A9; color: white; padding: 0.75rem 1.5rem; border: none; border-radius: 8px; cursor: pointer; text-decoration: none; font-weight: 600; transition: all 0.3s ease; }
    .btn-primary:hover { background: #001F3F; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0, 89, 169, 0.3); }
    .btn-lg { font-size: 1rem; padding: 0.9rem 2rem; }
    .stats-banner { background: linear-gradient(90deg, rgba(6,40,80,1) 0%, #0059A9 100%); padding: 1.5rem; border-radius: 12px; margin-bottom: 2rem; box-shadow: inset 0 -6px 20px rgba(0,0,0,0.12); }
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; max-width: 1200px; margin: 0 auto; }
    .stat-card { background: linear-gradient(180deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%); padding: 1.25rem 1rem; border-radius: 10px; text-align: center; color: rgba(255,255,255,0.95); box-shadow: 0 6px 18px rgba(0,0,0,0.18); border: 1px solid rgba(255,255,255,0.04); }
    .stat-card:hover { transform: translateY(-6px); box-shadow: 0 12px 28px rgba(0,0,0,0.22); }
    .stat-number { font-size: 2.25rem; font-weight: 800; color: #d2f0ea; margin-bottom: 0.5rem; }
    .stat-label { color: rgba(255,255,255,0.75); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; }
    .courses-section { background: #fff; border-radius: 12px; box-shadow: 0 4px 14px rgba(10, 45, 80, 0.04); overflow: hidden; }
    .section-header { padding: 1.5rem; border-bottom: 2px solid #f0f0f0; display: flex; justify-content: space-between; align-items: center; gap: 2rem; flex-wrap: wrap; }
    .section-header h2 { color: #1F1F1F; font-size: 1.5rem; margin: 0; }
    .search-filter { display: flex; gap: 1rem; flex: 1; min-width: 300px; }
    .search-box { flex: 1; padding: 0.75rem 1rem; border: 1px solid #ddd; border-radius: 8px; font-size: 0.95rem; }
    .search-box:focus { outline: none; border-color: #0059A9; box-shadow: 0 0 0 3px rgba(0, 89, 169, 0.06); }
    .courses-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 2rem; padding: 1.5rem; }
    .course-card { background: #fff; border-radius: 20px; padding: 1.5rem; box-shadow: 0 4px 20px rgba(0,0,0,0.04); transition: all 0.3s ease; display: flex; flex-direction: column; border: 1px solid transparent; }
    .course-card:hover { transform: translateY(-5px); box-shadow: 0 8px 30px rgba(0,0,0,0.08); }
    .card-header-row { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem; }
    .course-title { font-size: 1.3rem; font-weight: 800; color: #0b1e3b; margin: 0; flex: 1; padding-right: 1rem; }
    .status-badge { font-size: 0.75rem; font-weight: 700; padding: 0.3rem 0.6rem; border-radius: 6px; text-transform: uppercase; }
    .status-en-attente { background: #fff0f0; color: #c62828; }
    .status-terminé { background: #e8f5e9; color: #2e7d32; }
    .teacher-info { display: flex; align-items: center; gap: 0.5rem; color: #6c757d; font-size: 0.9rem; margin-bottom: 1.5rem; }
    .teacher-info i { color: #8898aa; }
    .info-grid-row { display: flex; justify-content: space-between; background: #f8f9fc; padding: 1rem; border-radius: 12px; margin-bottom: 1.5rem; }
    .info-metric { display: flex; flex-direction: column; align-items: center; gap: 0.3rem; flex: 1; text-align: center; }
    .metric-icon { color: #0056b3; font-size: 1.1rem; }
    .metric-value { font-size: 0.85rem; font-weight: 600; color: #525f7f; }
    .tags-row { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
    .tag { font-size: 0.75rem; font-weight: 700; padding: 0.4rem 0.8rem; border-radius: 6px; }
    .tag-type { background: #e3f2fd; color: #0d47a1; }
    .btn-details-main { display: flex; justify-content: center; align-items: center; gap: 0.5rem; background: #0056b3; color: white; padding: 0.8rem; border-radius: 12px; text-decoration: none; font-weight: 700; margin-bottom: 1rem; transition: all 0.2s ease; box-shadow: 0 4px 6px rgba(0, 86, 179, 0.2); }
    .btn-details-main:hover { background: #003d80; transform: translateY(-2px); box-shadow: 0 6px 12px rgba(0, 86, 179, 0.3); }
    .card-footer-actions { display: flex; gap: 0.75rem; }
    .btn-action { flex: 1; display: flex; justify-content: center; align-items: center; gap: 0.5rem; padding: 0.7rem; border-radius: 10px; font-size: 0.9rem; font-weight: 600; border: none; cursor: pointer; text-decoration: none; transition: all 0.2s ease; }
    .btn-edit-sub { background: #f3e8ff; color: #7e22ce; border: 1px solid #e9d5ff; }
    .btn-edit-sub:hover { background: #e9d5ff; color: #6b21a8; transform: translateY(-1px); }
    .btn-delete-sub { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
    .btn-delete-sub:hover { background: #fee2e2; color: #b91c1c; transform: translateY(-1px); }
    .empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 4rem 2rem; background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); text-align: center; margin: 1.5rem; border: 2px dashed #e2e8f0; }
    .empty-icon-container { width: 100px; height: 100px; background: #f0f9ff; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem; color: #0059A9; }
    .empty-state h3 { font-size: 1.5rem; color: #1e293b; margin-bottom: 0.75rem; font-weight: 700; }
    .empty-state p { color: #64748b; font-size: 1rem; max-width: 400px; margin-bottom: 2rem; line-height: 1.6; }
    .pulse-animation { animation: pulse 2s infinite; }
    @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(0, 89, 169, 0.4); } 70% { box-shadow: 0 0 0 10px rgba(0, 89, 169, 0); } 100% { box-shadow: 0 0 0 0 rgba(0, 89, 169, 0); } }
    .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); display: none; justify-content: center; align-items: center; z-index: 1000; backdrop-filter: blur(4px); }
    .modal-content { background: white; padding: 2rem; border-radius: 16px; width: 90%; max-width: 400px; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
    .modal-icon { width: 60px; height: 60px; background: #fee2e2; color: #dc2626; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin: 0 auto 1.5rem auto; }
    .modal-content h3 { color: #1f2937; margin-bottom: 0.5rem; font-size: 1.25rem; }
    .modal-content p { color: #6b7280; margin-bottom: 2rem; line-height: 1.5; }
    .modal-actions { display: flex; gap: 1rem; justify-content: center; }
    .btn-cancel { padding: 0.75rem 1.5rem; border-radius: 8px; font-weight: 600; cursor: pointer; border: none; background: #f3f4f6; color: #4b5563; }
    .btn-confirm { padding: 0.75rem 1.5rem; border-radius: 8px; font-weight: 600; cursor: pointer; border: none; background: #dc2626; color: white; }
    @media (max-width: 768px) { .courses-header { flex-direction: column; text-align: center; gap: 1rem; } .section-header { flex-direction: column; } .card-footer-actions { flex-direction: column; } }
</style>

<!-- Delete Confirmation Modal - same as Courses -->
<div id="deleteModal" class="modal-overlay">
    <div class="modal-content">
        <div class="modal-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h3>Confirmer la suppression</h3>
        <p>Êtes-vous sûr de vouloir supprimer ce groupe ? Cette action est irréversible.</p>
        <div class="modal-actions">
            <button class="btn-cancel" onclick="closeDeleteModal()">Annuler</button>
            <button class="btn-confirm" onclick="confirmDelete()">Supprimer</button>
        </div>
    </div>
</div>

<script>
    let courseIdToDelete = null;

    function openDeleteModal(id) {
        courseIdToDelete = id;
        document.getElementById('deleteModal').style.display = 'flex';
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').style.display = 'none';
        courseIdToDelete = null;
    }

    function confirmDelete() {
        if (courseIdToDelete) {
            document.getElementById('delete-form-' + courseIdToDelete).submit();
        }
    }

    document.getElementById('deleteModal')?.addEventListener('click', function(e) {
        if (e.target === this) closeDeleteModal();
    });

    document.getElementById('searchInput')?.addEventListener('keyup', function() {
        const term = this.value.toLowerCase();
        document.querySelectorAll('.course-card').forEach(function(card) {
            const category = (card.dataset.category || '').toLowerCase();
            const title = (card.querySelector('.course-title')?.textContent || '').toLowerCase();
            const visible = title.includes(term) || category.includes(term);
            card.style.display = visible ? 'flex' : 'none';
        });
    });
</script>
{% endblock %}
