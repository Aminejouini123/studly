{% extends 'front/base.html.twig' %}

{% block title %}My Groups{% endblock %}

{% block content %}
    <div class="welcome-section">
        <div class="card-header">
            <h3>My Groups</h3>
            <div class="action-buttons">
                <a href="{{ path('app_groups_new') }}" class="btn-action"><i class="fas fa-plus"></i> Create Group</a>
            </div>
        </div>
    </div>

    {% if app.session.flashBag.has('success') %}
        <div class="flash-success">
            {% for message in app.session.flashBag.get('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}
        </div>
    {% endif %}

    <div class="dashboard-grid">
        {% for group in groups %}
            <div class="card">
                <div class="card-icon blue">
                    <i class="fas fa-users"></i>
                </div>
                <h3>{{ group.category }}</h3>
                <p>
                    <strong>Capacity:</strong> {{ group.capacity }} members<br>
                    <strong>Created:</strong> {{ group.createdAt|date('d/m/Y H:i') }}<br>
                    {% if group.groupPhoto %}
                        <br>
                        <img src="{{ group.groupPhoto }}" alt="Group Photo" style="width: 100%; border-radius: 8px; height: 150px; object-fit: cover;">
                    {% endif %}
                </p>
                <div style="display: flex; gap: 10px; margin-top: 10px;">
                    <a href="{{ path('app_groups_show', {'id': group.id}) }}" class="card-action" style="flex: 1;">
                        View <i class="fas fa-eye"></i>
                    </a>
                    <a href="{{ path('app_groups_edit', {'id': group.id}) }}" class="card-action" style="flex: 1; background-color: #f59e0b;">
                        Edit <i class="fas fa-edit"></i>
                    </a>
                </div>
                <form method="post" action="{{ path('app_groups_delete', {'id': group.id}) }}" style="margin-top: 10px;" onsubmit="return confirm('Are you sure?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ group.id) }}">
                    <button type="submit" class="btn btn-danger" style="width: 100%;">
                        <i class="fas fa-trash"></i> Delete
                    </button>
                </form>
            </div>
        {% else %}
            <div class="card" style="grid-column: 1 / -1;">
                <h3>No groups found</h3>
                <p>You haven't created any groups yet. <a href="{{ path('app_groups_new') }}">Create your first group</a>!</p>
            </div>
        {% endfor %}
    </div>
{% endblock %}
