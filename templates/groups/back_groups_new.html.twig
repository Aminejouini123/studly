{% extends 'back/base.html.twig' %}

{% block title %}New Group{% endblock %}

{% block breadcrumb %}
    <span style="color: var(--admin-text-muted);">Management</span> / <a href="{{ path('app_admin_groups_index') }}" style="color: var(--admin-text-muted); text-decoration: none;">Groups</a> / <span>New</span>
{% endblock %}

{% block content %}
<div class="dashboard-content">

    <div style="margin-bottom: 24px;">
        <h1 class="page-title" style="margin-bottom: 8px;">Create New Group</h1>
        <p style="color: var(--admin-text-muted); font-size: 0.95rem;">Add a new study group with category and capacity.</p>
    </div>

    {{ form_start(form, {'attr': {'class': 'admin-form', 'novalidate': true}}) }}

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
        <div class="content-card">
            <div class="card-header">
                <h3>Group Information</h3>
            </div>
            <div class="card-body" style="padding: 24px;">
                {{ include('groups/_form.html.twig', {'form_only_fields': true}) }}
            </div>
        </div>

        <div class="content-card">
            <div class="card-body" style="padding: 24px;">
                <button type="submit" class="btn-action" style="width: 100%; justify-content: center; padding: 12px; font-size: 1rem; margin-bottom: 12px;">
                    <i class="fas fa-save"></i> Save Group
                </button>
                <a href="{{ path('app_admin_groups_index') }}" class="btn-action" style="background: white; color: var(--admin-text-main); border: 1px solid var(--admin-border); width: 100%; justify-content: center; padding: 12px; font-size: 1rem;">
                    Cancel
                </a>
            </div>
        </div>
    </div>

    {{ form_end(form) }}

</div>
{% endblock %}
