<form method="post" action="{{ path('app_admin_groups_delete', {'id': group.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');" style="display:inline-block">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ group.id) }}">
    <button class="btn-secondary" style="color: #ef4444; border-color: #fecaca; background: #fef2f2;">
        <i class="fas fa-trash"></i> Delete Group
    </button>
</form>
