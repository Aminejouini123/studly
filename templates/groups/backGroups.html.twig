{% extends 'back/base.html.twig' %}

{% block title %}Groups Management{% endblock %}

{% block breadcrumb %}Groups Management{% endblock %}

{% block content %}
    <div class="dashboard-content">
        <h1 class="page-title">Groups Management</h1>

        {# Flash Messages - same style as Courses #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}" style="padding: 15px; margin-bottom: 20px; border: 1px solid transparent; border-radius: 4px; {% if label == 'success' %}color: #155724; background-color: #d4edda; border-color: #c3e6cb;{% else %}color: #721c24; background-color: #f8d7da; border-color: #f5c6cb;{% endif %}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="content-card">
            <div class="card-header">
                <h3>All Groups</h3>
                <div class="action-buttons" style="display: flex; align-items: center; gap: 12px;">
                    <form method="get" action="{{ path('app_admin_groups_index') }}" class="search-container" style="max-width: 300px;">
                        <input type="text" name="q" value="{{ app.request.query.get('q') }}" placeholder="Search categories..." class="form-control" style="padding-left: 42px;">
                        <i class="fas fa-search" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted);"></i>
                    </form>
                    <a href="{{ path('app_admin_groups_export') }}" class="btn-secondary" title="Export CSV"><i class="fas fa-file-csv"></i></a>
                    <a href="{{ path('app_admin_groups_export_pdf') }}" class="btn-secondary" title="Export PDF"><i class="fas fa-file-pdf"></i></a>
                    <button class="btn-action" onclick="openModal()"><i class="fas fa-plus"></i> Add Group</button>
                </div>
            </div>

            <!-- Create Group Modal -->
            <div class="modal-overlay" id="groupModal">
                <div class="modal-card">
                    <div class="modal-header">
                        <h2>Create New Group</h2>
                        <button type="button" class="modal-close" onclick="closeModal()">&times;</button>
                    </div>
                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                    <div class="modal-body">
                        <div class="admin-form-group">
                            {{ form_label(form.category, 'Category', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.category, {'attr': {'class': 'form-control', 'placeholder': 'e.g. Mathematics'}}) }}
                            {{ form_errors(form.category) }}
                        </div>
                        
                        <div class="form-grid" style="grid-template-columns: 1fr 1fr;">
                            <div class="admin-form-group">
                                {{ form_label(form.capacity, 'Capacity', {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.capacity, {'attr': {'class': 'form-control', 'placeholder': 'e.g. 30'}}) }}
                                {{ form_errors(form.capacity) }}
                            </div>
                        </div>

                        <div class="admin-form-group">
                            {{ form_label(form.groupPhoto, 'Group Photo URL', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.groupPhoto, {'attr': {'class': 'form-control', 'placeholder': 'https://...'}}) }}
                            {{ form_errors(form.groupPhoto) }}
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-secondary" onclick="closeModal()">Cancel</button>
                        <button type="submit" class="btn-action">Create Group</button>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>

            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>
                                <a href="{{ path('app_admin_groups_index', {'sort': 'id', 'direction': app.request.query.get('direction') == 'ASC' ? 'DESC' : 'ASC'}) }}" style="color: inherit; text-decoration: none;">
                                    ID
                                    {% if app.request.query.get('sort') == 'id' %}
                                        <i class="fas fa-sort-{{ app.request.query.get('direction') == 'ASC' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort" style="opacity: 0.3;"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('app_admin_groups_index', {'sort': 'category', 'direction': app.request.query.get('direction') == 'ASC' ? 'DESC' : 'ASC'}) }}" style="color: inherit; text-decoration: none;">
                                    Category
                                    {% if app.request.query.get('sort') == 'category' %}
                                        <i class="fas fa-sort-{{ app.request.query.get('direction') == 'ASC' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort" style="opacity: 0.3;"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('app_admin_groups_index', {'sort': 'capacity', 'direction': app.request.query.get('direction') == 'ASC' ? 'DESC' : 'ASC'}) }}" style="color: inherit; text-decoration: none;">
                                    Capacity
                                    {% if app.request.query.get('sort') == 'capacity' %}
                                        <i class="fas fa-sort-{{ app.request.query.get('direction') == 'ASC' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort" style="opacity: 0.3;"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>Created By</th>
                            <th>
                                <a href="{{ path('app_admin_groups_index', {'sort': 'createdAt', 'direction': app.request.query.get('direction') == 'ASC' ? 'DESC' : 'ASC'}) }}" style="color: inherit; text-decoration: none;">
                                    Created At
                                    {% if app.request.query.get('sort') == 'createdAt' %}
                                        <i class="fas fa-sort-{{ app.request.query.get('direction') == 'ASC' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort" style="opacity: 0.3;"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for group in groups %}
                        <tr>
                            <td style="font-weight: 500;">#{{ group.id }}</td>
                            <td>
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #eff6ff, #dbeafe); color: var(--primary); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; box-shadow: var(--shadow-sm);">
                                        <i class="fas fa-users"></i>
                                    </div>
                                    <div style="display: flex; flex-direction: column;">
                                        <span style="font-weight: 700; color: var(--text-main);">{{ group.category }}</span>
                                        <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">Capacity: {{ group.capacity }} members</span>
                                    </div>
                                </div>
                            </td>
                            <td>{{ group.capacity }} members</td>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 2px;">
                                    <span style="font-weight: 700; color: var(--text-main); font-size: 0.9rem;">{{ group.creator.firstName }} {{ group.creator.lastName }}</span>
                                    <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">{{ group.creator.email }}</span>
                                </div>
                            </td>
                            <td style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">{{ group.createdAt|date('d/m/Y H:i') }}</td>
                            <td>
                                {% if not group.members.isEmpty %}
                                    <span class="status-badge status-active">Assigned</span>
                                {% else %}
                                    <span class="status-badge status-pending">Unassigned</span>
                                {% endif %}
                            </td>
                            <td>
                                <div style="display: flex; gap: 8px;">
                                    <a href="{{ path('app_admin_groups_show', {'id': group.id}) }}" class="btn-secondary" title="View Details"><i class="fas fa-eye"></i></a>
                                    <a href="{{ path('app_admin_groups_edit', {'id': group.id}) }}" class="btn-secondary" title="Edit Group" style="color: var(--primary); border-color: rgba(99, 102, 241, 0.2);"><i class="fas fa-edit"></i></a>
                                    <form method="post" action="{{ path('app_admin_groups_delete', {'id': group.id}) }}" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this group?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ group.id) }}">
                                        <button type="submit" class="btn-secondary" title="Delete Group" style="color: #ef4444; border-color: #fee2e2;"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 30px; color: var(--admin-text-muted);">
                                <i class="fas fa-inbox" style="font-size: 2rem; margin-bottom: 10px; display: block;"></i>
                                No groups found.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        const modal = document.getElementById('groupModal');

        function openModal() {
            modal.classList.add('active');
        }

        function closeModal() {
            modal.classList.remove('active');
        }

        // Auto-open if there are form errors
        {% if not form.vars.valid %}
            document.addEventListener('DOMContentLoaded', function() {
                modal.classList.add('active');
            });
        {% endif %}

        // Close on overlay click (same as Courses delete modal)
        modal.addEventListener('click', function(e) {
            if (e.target === modal) closeModal();
        });
    </script>
{% endblock %}
