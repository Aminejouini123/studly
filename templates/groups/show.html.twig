{% extends 'front/base.html.twig' %}

{% block title %}Group Details{% endblock %}

{% block content %}
    <div class="welcome-section">
        <h1>{{ group.category }}</h1>
        <p>Group Details</p>
    </div>

    <div class="card">
        <div style="display: flex; gap: 30px; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 300px;">
                {% if group.groupPhoto %}
                    <img src="{{ group.groupPhoto }}" alt="{{ group.category }}" style="width: 100%; border-radius: 12px; box-shadow: var(--shadow-md);">
                {% else %}
                    <div style="width: 100%; height: 250px; background: #f1f5f9; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--text-muted); font-size: 3rem;">
                        <i class="fas fa-users"></i>
                    </div>
                {% endif %}
            </div>
            <div style="flex: 2;">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px;">
                    <div style="background: #f8fafc; padding: 20px; border-radius: 12px;">
                        <span style="display: block; color: var(--text-muted); font-size: 0.9rem; margin-bottom: 5px;">Capacity</span>
                        <span style="font-size: 1.2rem; font-weight: 600;">{{ group.capacity }} Members</span>
                    </div>
                    <div style="background: #f8fafc; padding: 20px; border-radius: 12px;">
                         <span style="display: block; color: var(--text-muted); font-size: 0.9rem; margin-bottom: 5px;">Created By</span>
                         <span style="font-size: 1.2rem; font-weight: 600;">{{ group.creator.firstName }} {{ group.creator.lastName }}</span>
                    </div>
                    <div style="background: #f8fafc; padding: 20px; border-radius: 12px;">
                        <span style="display: block; color: var(--text-muted); font-size: 0.9rem; margin-bottom: 5px;">Status</span>
                        <span style="font-size: 1.2rem; font-weight: 600; color: #16a34a;">Active</span>
                   </div>
                   <div style="background: #f8fafc; padding: 20px; border-radius: 12px;">
                        <span style="display: block; color: var(--text-muted); font-size: 0.9rem; margin-bottom: 5px;">Created At</span>
                        <span style="font-size: 1.2rem; font-weight: 600;">{{ group.createdAt|date('d/m/Y') }}</span>
                   </div>
                </div>

                <h3>Description</h3>
                <p>
                    This is a study group for <strong>{{ group.category }}</strong>. 
                    Join this group to collaborate with other students, share resources, and achieve your academic goals.
                </p>

                <div style="margin-top: 30px; display: flex; gap: 15px;">
                    <button class="btn-action" style="padding: 12px 24px; font-size: 1rem;">
                        <i class="fas fa-user-plus"></i> Join Group
                    </button>
                    <a href="{{ path('app_groups_index') }}" style="padding: 12px 24px; border: 1px solid var(--border-color); border-radius: 8px; text-decoration: none; color: var(--text-dark); font-weight: 500;">
                        Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
