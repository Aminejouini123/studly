{% extends 'admin/base.html.twig' %}

{% block title %}User Scores - {{ parent() }}{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title mb-0">Student Productivity Scores</h3>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Rank</th>
                                    <th>Student Name</th>
                                    <th>Email</th>
                                    <th>Score</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for scoreData in scores %}
                                <tr>
                                    <td>
                                        <span class="badge bg-{{ loop.index <= 3 ? 'warning' : 'secondary' }}">
                                            #{{ loop.index }}
                                        </span>
                                    </td>
                                    <td>{{ scoreData.name }}</td>
                                    <td>{{ scoreData.email }}</td>
                                    <td>
                                        <span class="badge bg-success fs-6">{{ scoreData.score }}</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-{{ scoreData.user.statut == 'Active' ? 'success' : 'secondary' }}">
                                            {{ scoreData.user.statut }}
                                        </span>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Scoring Rules</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Earning Points:</h6>
                            <ul>
                                <li><strong>+10 points:</strong> Task completed</li>
                                <li><strong>+20 points:</strong> Task completed before deadline</li>
                                <li><strong>+5 points:</strong> Active participation in activities</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6>Point Deductions:</h6>
                            <ul>
                                <li><strong>-5 points:</strong> Late submission</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.badge {
    font-size: 0.9em;
}

.table th {
    background-color: #f8f9fa;
    font-weight: 600;
}
</style>
{% endblock %}