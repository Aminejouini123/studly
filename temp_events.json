                    <textarea name="address" placeholder="Address" style="background: none; border: none; outline: none; width: 100%; font-weight: 600; font-size: 1.1rem; color: #333; resize: none; margin-left: 10px; font-family: 'Poppins', sans-serif;" rows="1"></textarea>
