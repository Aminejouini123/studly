# Example environment file (DO NOT put real secrets here).
# Copy to .env (or better: .env.local) and fill in your own values.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://root:@127.0.0.1:3306/Projet_db?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1
###< symfony/messenger ###

###> symfony/mailer ###
# Examples:
# MAILER_DSN=null://null
# MAILER_DSN=smtp://localhost
# MAILER_DSN=gmail://USERNAME:PASSWORD@default
MAILER_DSN=null://null
###< symfony/mailer ###

###> google/apiclient ###
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
###< google/apiclient ###

